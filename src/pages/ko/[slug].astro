---
import Layout from '../../components/Layout.astro';
import Article from '../../components/Article.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, guideHreflang, type GuideKey } from '../../lib/seo';

interface KoreanGuide {
  slug: string; key: GuideKey; title: string; description: string; intro: string; label: string; body: string; article?: boolean;
}

const pages: KoreanGuide[] = [
  {
    slug: 'guides', key: 'guides', title: '소음 측정 가이드 모음',
    description: '브라우저 소음 측정을 위한 한국어 안내 모음이에요. 사용 방법, 측정 원리, 교정, 정확도, 데시벨 표, dB와 dBA 차이, 마이크 문제 해결을 확인해요.',
    intro: '목적에 맞는 안내부터 읽어보세요. 미교정 상태에서는 공칭 추정치가 표시되고, 기준기로 교정하면 기기별 오프셋이 반영돼요.', label: '가이드',
    body: `<h2>측정을 시작해요</h2><ul><li><a href="/ko/how-to-use/">온라인 데시벨 측정기 사용 방법</a> — 마이크 허용부터 세션 내보내기까지 순서대로 따라해요.</li><li><a href="/ko/noise-meter-app/">스마트폰 소음 측정 앱으로 쓰기</a> — 아이폰과 안드로이드에서 설치 없이 바로 측정해요.</li><li><a href="/ko/microphone-not-working/">마이크가 작동하지 않을 때</a> — 권한, 입력 장치, 다른 앱 사용 여부를 확인해요.</li></ul><h2>수치를 이해해요</h2><ul><li><a href="/ko/methodology/">브라우저 소음 측정이 동작하는 원리</a> — 마이크 입력부터 화면 수치까지 처리 과정을 살펴봐요.</li><li><a href="/ko/calibration/">온라인 데시벨 측정기 교정 방법</a> — 같은 자리에서 기준기와 비교해 기기별 오프셋을 저장해요.</li><li><a href="/ko/accuracy/">브라우저 측정값의 정확도와 한계</a> — 기종 차이와 자동 음성 처리가 결과에 주는 영향을 알아봐요.</li><li><a href="/ko/decibel-chart/">데시벨 비교표</a> — 일상 소음 크기를 30부터 120 dBA까지 대략적으로 비교해요.</li><li><a href="/ko/db-vs-dba/">dB와 dBA 차이</a> — A, C, Z 가중과 Fast, Slow 반응을 골라요.</li></ul><h2>프라이버시와 저장 방식</h2><ul><li><a href="/ko/privacy/">마이크 음성 프라이버시와 쿠키 안내</a> — 로컬 처리, 브라우저 저장, 분석과 광고 쿠키 범위를 확인해요.</li></ul><h2>이렇게 활용해주세요</h2><p>먼저 <a href="/ko/#measure">측정 패널</a>에서 30초에서 60초 정도 재고 Leq를 적어두세요. 숫자가 뜻밖이면 <a href="/ko/how-to-use/">사용 방법</a>에서 배치와 평활화를 점검하고, 기기별 차이를 좁히고 싶으면 <a href="/ko/calibration/">교정</a>으로 넘어가세요.</p><p>소음 노출을 볼 때는 크기와 시간을 함께 보세요. 85 dBA 8시간을 참고 기준으로 삼고 3 dB 오를 때마다 허용 시간이 대략 절반으로 준다고 생각해주세요. 70 dBA 아래에서는 대개 시간 걱정이 크지 않아요. 그래도 브라우저 수치는 참고용으로만 쓰고 정식 판단은 교정된 장비에 맡겨주세요. 예시 크기는 <a href="/ko/decibel-chart/">데시벨 비교표</a>에서, 가중 고르는 법은 <a href="/ko/db-vs-dba/">dB와 dBA 차이</a>에서 확인하세요.</p> 숫자의 출처가 궁금하면 <a href="/ko/methodology/">측정 원리</a>에서 마이크 입력부터 dBFS 변환까지 흐름을 따라가 보세요. 두 대가 다르게 나오면 <a href="/ko/accuracy/">정확도</a>에서 5에서 10 dB 간격과 저음 약함을 확인하세요.</p><p>측정값은 가벼운 비교용 참고 수치로만 활용해주세요. 작업장 평가나 법적 판단에는 교정된 Class 1 또는 Class 2 장비를 사용해주세요. <a href="/ko/#measure">지금 브라우저에서 소음 측정하기 →</a></p>`,
  },
  {
    slug: 'how-to-use', key: 'how-to-use', title: '온라인 데시벨 측정기 사용 방법',
    description: '브라우저 데시벨 측정기 사용 순서를 한국어로 안내해요. 마이크 허용, 기기 배치, 패널 읽기, 교정, CSV와 JSON 저장을 설명해요.',
    intro: '앱을 설치하지 않고 브라우저에서 바로 측정해요. 마이크를 허용하고 기기를 고정한 뒤 표시 방식을 확인해주세요.', label: '사용 방법', article: true,
    body: `<h2>1. 마이크를 허용해주세요</h2><p><a href="/ko/#measure">측정 패널</a>에서 시작을 누르고 브라우저 요청에서 허용을 골라주세요. 권한은 같은 주소에서 한 번만 물어보고, 주소창 설정에서 언제든 취소할 수 있어요. 오디오 분석은 Web Audio API로 브라우저 안에서 처리되고 서버로 업로드되지 않아요. HTTPS 주소에서 실행해주시고, 입력 선택 목록에서 원하는 마이크를 골라주세요. 모노로 입력받고 에코 제거와 잡음 억제, 자동 게인은 끄도록 요청해요.</p><h2>2. 기기를 놓고 패널을 읽어주세요</h2><p>마이크 구멍을 가리지 말고 귀 높이에 기기를 안정적으로 두세요. 바람이나 환풍구, 손잡이 잡음은 피해주세요. 비교할 때는 소리와의 거리와 기기 방향을 그대로 유지해주세요. 몇 초 기다리면 Fast 125ms나 Slow 1s 평활화가 안정돼요. 현재값은 다듬은 실시간 수치이고, 최소값과 Leq, 최대값, 측정 시간이 함께 쌓여요. 그래프에는 최근 240개 점이 그려져서 지나가는 트럭이나 책상 건드림이 평균을 망쳤는지 바로 알 수 있어요. 대기 중에는 "--"가 표시되고, 흉내 낸 숫자는 절대 나오지 않아요.</p><h2>3. 가중과 반응을 맞춰주세요</h2><p>일상 공간 비교에는 A 가중을, 저음이 강한 음악이나 기계음 비교에는 C 가중을, 보정 없는 비교에는 Z 가중을 골라주세요. 같은 질문 안에서는 도중에 바꾸지 말아주세요. 미교정 상태에서는 가중 dBFS에 공칭 +100 dB 오프셋을 더한 추정치 dBA, dBC, dBZ가 표시돼요. 기기별 정확도를 높이려면 <a href="/ko/calibration/">같은 자리에서 기준기로 교정</a>해주세요. 수치 뜻은 <a href="/ko/db-vs-dba/">dB와 dBA 차이</a>에서 확인해요.</p><h2>4. 30초에서 60초 세션으로 저장해주세요</h2><p>조용히 계신 채로 30초에서 60초 정도 평균이나 Leq를 읽어주세요. 순간 피크를 쫓기보다 두 번의 Leq를 나란히 비교하는 편이 훨씬 안정적이에요. 세션은 이 브라우저에만 최대 20개까지 남고, CSV나 JSON 내보내기는 호환 교정이 있을 때만 dB 값을 담아요. 미교정 내보내기에는 dB 숫자를 넣지 않아서 대략적인 추정치가 기록처럼 퍼지지 않아요. 그래도 멈춰 있으면 <a href="/ko/microphone-not-working/">마이크 문제 해결</a>을 먼저 읽고, 이어서 <a href="/ko/accuracy/">정확도와 한계</a>를 확인해주세요.</p><p><a href="/ko/#measure">측정 패널 열기 →</a> · <a href="/ko/methodology/">측정 원리 보기 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'methodology', key: 'methodology', title: '브라우저 소음 측정이 동작하는 원리',
    description: '마이크 입력부터 RMS와 dBFS, A와 C, Z 가중, Fast와 Slow 반응, Leq 계산까지 브라우저 소음 측정 과정을 한국어로 설명해요.',
    intro: '마이크 소리가 화면 숫자가 되기까지 과정을 순서대로 설명해요. 모든 단계는 사용하시는 브라우저 안에서 진행돼요.', label: '측정 원리', article: true,
    body: `<h2>마이크 입력을 받아요</h2><p>시작을 누르면 브라우저가 getUserMedia로 허락하신 마이크를 열어요. 이때 에코 제거와 잡음 억제, 자동 게인을 끄도록 요청하고 모노로 입력받아요. 기기나 브라우저가 요청을 받아들이지 않을 수도 있고, 그런 경우 측정기가 처리 상태를 그대로 보여줘요. 입력은 스피커로 연결되지 않아서 하울링이 생기지 않아요. 마이크 권한은 같은 주소에서 한 번만 물어보고, 보안 HTTPS 연결에서만 동작해요. 오디오 샘플은 어디에도 업로드되지 않고 브라우저 안에서만 흘러요.</p><h2>RMS와 dBFS로 바꿔요</h2><p>짧은 오디오 조각마다 RMS를 구하고 디지털 최대값을 0으로 삼는 dBFS 눈금으로 바꿔요. dBFS는 항상 0 아래 음수로 표시되고 조용한 방은 한참 아래에 머물러요. 미교정 상태에서는 가중한 디지털 레벨에 공칭 +100 dB 오프셋을 더해서 추정치라고 분명하게 표시해요. 예를 들어 -34.1 dBFS는 대략 65.9 dBA 추정치로 보여요. 원래 dBFS 값은 진단 화면에서 그대로 확인할 수 있어요.</p><h2>주파수 가중과 시간 반응을 적용해요</h2><p>주파수 분석에서 강한 대역을 기준으로 A, C, Z 보정을 적용해요. A는 일상 청감에 가깝게 저음을 덜 세고, C는 저음을 더 살리며, Z는 보정 없이 평탄하게 보여줘요. Fast 125ms는 짧은 변화를 빨리 따라가고, Slow 1s는 표시를 부드럽게 다듬어요. 반응을 바꿔도 바탕 추정치는 그대로이고 따라가는 속도만 달라져요. 측정 중 평균은 단순 산술 평균이 아니라 에너지 평균인 Leq로 쌓아요.</p><h2>교정 뒤 추정치를 표시해요</h2><p>신뢰할 수 있는 기준기와 같은 자리에서 비교해 저장한 오프셋이 있으면 공칭 오프셋 대신 그 값을 더해요. 선택하신 dBA, dBC, dBZ 단위로 현재값과 최소값, Leq, 최대값, 측정 시간을 보여주고 그래프에는 최근 240개 점을 남겨요. CSV와 JSON 내보내기는 호환 교정이 켜져 있을 때만 dB 값을 담고, 미교정 세션은 dB 숫자 없이 시간과 설정만 담아요. 저장 기록은 이 브라우저에만 최대 20개까지 남고 서버로 올라가지 않아요. 교정 순서는 <a href="/ko/calibration/">교정 방법</a>에서, 한계는 <a href="/ko/accuracy/">정확도 안내</a>에서 이어서 읽어보세요.</p><p><a href="/ko/#measure">측정 패널 열기 →</a> · <a href="/ko/db-vs-dba/">dB와 dBA 차이 →</a> · <a href="/ko/privacy/">프라이버시 안내 →</a></p>`,
  },
  {
    slug: 'calibration', key: 'calibration', title: '온라인 데시벨 측정기 교정 방법',
    description: '브라우저 데시벨 측정기를 기준 소음계에 맞추는 방법을 안내해요. 같은 자리 비교, 오프셋 저장, 가중 일치, 다시 교정할 때를 설명해요.',
    intro: '여기서 교정은 같은 장소에서 기준기와 비교해 고정된 dB 오프셋을 더하는 과정을 말해요. 기기마다 따로 저장해주세요.', label: '교정', article: true,
    body: `<h2>교정이 필요한 이유를 알아요</h2><p>휴대폰과 노트북 마이크는 통화용으로 만들어져서 감도와 내부 게인이 기종마다 달라요. 기준기와 차이를 재기 전에는 환경 dBA가 아니라 마이크 입력 크기로만 활용해주세요. 같은 소리를 재도 기기마다 숫자가 벌어지고, 그 간격은 흔히 5에서 10 dB 정도예요. 그래서 미교정 화면은 가중 dBFS에 공칭 +100 dB를 더한 추정치라고 표시해요. 이 차이를 같은 자리에서 한 번 재서 저장하면 전체 레벨이 기준기에 가까워져요.</p><h2>준비물을 챙겨주세요</h2><ul><li>믿을 수 있는 교정된 소음계나 알려진 레벨의 안정적인 음향 교정기를 준비해주세요.</li><li>나중에 측정할 때와 같은 기기, 같은 마이크, 같은 브라우저 설정을 사용해주세요.</li><li>양쪽에서 주파수 가중 A, C, Z와 시간 반응 Fast, Slow를 똑같이 맞춰주세요.</li></ul><h2>네 단계로 교정해주세요</h2><ol><li>기준기와 기기를 나란히 같은 높이에 두고 마이크 구멍을 가리지 말아주세요.</li><li>가급적 안정적인 기준음을 틀고 양쪽 표시가 잔잔해질 때까지 기다려주세요.</li><li>이 측정기의 미교정 수치와 기준기 수치를 비교해 차이인 기준값에서 표시값을 뺀 값을 맞춤 설정의 교정란에 오프셋으로 입력해주세요.</li><li>상태 표시가 미교정에서 교정됨으로 바뀌는지 확인하고 같은 기준음으로 다시 대조해주세요. 60초 Leq를 나란히 적어두면 나중에 흔들림을 판단하기 쉬워요.</li></ol><h2>프로파일을 다시 만들어주세요</h2><p>마이크나 헤드셋, USB 입력이 바뀌면 다시 확인해주세요. 가중이나 반응을 바꾸거나 기기 위치와 케이스를 바꾸어도 다시 측정해주세요. 브라우저가 업데이트되거나 자동 게인 표시가 바뀌어도 점검해주세요. 다른 휴대폰에 같은 오프셋을 옮겨 쓰지 말아주세요. 주파수 특성과 클리핑, 레벨에 따라 바뀌는 자동 처리는 고정 오프셋으로 고쳐지지 않아요. 스펙트럼은 화면 표시용이라 레벨 계산에 쓰지 않고, 세션 통계는 현재값과 최소값, Leq, 최대값, 측정 시간으로 쌓아요. 그래프에는 최근 240개 점이 남고, CSV와 JSON 내보내기는 호환 교정이 있을 때만 dB 값을 담아요. 자세한 한계는 <a href="/ko/accuracy/">정확도와 한계</a>에서 읽고, 측정 순서는 <a href="/ko/how-to-use/">사용 방법</a>을 참고해주세요.</p><p><a href="/ko/#measure">측정기 열기 →</a> · <a href="/ko/methodology/">측정 원리 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'accuracy', key: 'accuracy', title: '브라우저 데시벨 측정값의 정확도와 한계',
    description: '브라우저 데시벨 측정값이 추정치인 이유를 설명해요. 마이크 차이, 자동 게인, 주파수 특성, 교정으로 개선되는 범위를 확인해요.',
    intro: '휴대폰 마이크는 통화를 위한 부품이라 계측기가 아니에요. 어디까지 믿을 수 있는지 솔직하게 정리해요.', label: '정확도', article: true,
    body: `<h2>표시 숫자의 뜻을 알아요</h2><p>미교정 표시는 Web Audio 시간 영역 샘플에서 구한 마이크 입력 크기예요. 같은 소리를 재도 마이크 감도와 케이스, 놓는 위치에 따라 숫자가 달라져요. 두 대를 나란히 두면 흔히 5에서 10 dB 정도 벌어지고, 안드로이드는 기종이 다양해서 간격이 더 넓을 때가 있어요. 그래서 모든 미교정 수치는 추정치라고 표시하고, 원래 dBFS는 진단 화면에서 따로 보여줘요. 소수점은 무시하고 정수로 읽어주세요.</p><h2>결과가 달라지는 까닭을 살펴봐요</h2><ul><li><strong>부품 차이:</strong> 마이크 캡슐과 프리앰프, 마이크 구멍 위치가 기종마다 달라요.</li><li><strong>자동 음성 처리:</strong> 운영체제와 브라우저의 자동 게인과 잡음 억제, 에코 제거가 레벨을 바꿀 때가 있어요. 이 측정기는 getUserMedia로 끄기를 요청하지만 받아들여지지 않으면 상태를 그대로 보여줘요.</li><li><strong>주파수 특성:</strong> 고정된 오프셋으로는 저음부터 고음까지 감도 차이를 완전히 고칠 수 없어요. 작은 캡슐은 저음을 약하게 받아요.</li><li><strong>주변 환경:</strong> 반사와 바람, 손잡이 잡음, 소리와의 거리가 결과에 영향을 줘요.</li></ul><h2>교정으로 좋아지는 범위를 알아요</h2><p>믿을 수 있는 기준기와 비교한 고정 오프셋은 전체 게인 차이를 좁혀줘요. 그래도 주파수 특성이나 왜곡, 클리핑, 레벨에 따라 바뀌는 자동 처리는 고쳐지지 않아요. 조용한 방이 30 dBA 아래에서는 실제보다 높게 나오고, 95에서 100 dBA 근처에서는 캡슐이 포화돼서 더 이상 올라가지 않아요. 교정 순서는 <a href="/ko/calibration/">교정 방법</a>을 참고해주세요.</p><h2>별도 계측기가 필요할 때를 기억해요</h2><p>작업장 소음 평가나 법적 다툼, 청력 안전 판단, 기준 적합 증명에는 교정된 Class 1 또는 Class 2 소음계와 알맞은 절차를 사용해주세요. 이 브라우저 도구는 경향과 상대 비교를 위한 참고용 추정치만 보여줘요. 시간과 함께 판단할 때는 85 dBA 8시간을 참고 기준으로 삼고 3 dB 오를 때마다 허용 시간이 대략 절반으로 준다고 생각해주세요. 70 dBA 아래에서는 대개 시간 걱정이 크지 않아요. <a href="/ko/decibel-chart/">데시벨 비교표</a>와 함께 읽으면 이해가 쉬워요.</p><p><a href="/ko/#measure">측정 시작하기 →</a> · <a href="/ko/methodology/">측정 원리 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'decibel-chart', key: 'decibel-chart', title: '데시벨 비교표: 일상 소음 크기',
    description: '30부터 120 dBA까지 일상 소음 크기를 대략적으로 비교해요. 침실과 도서관, 대화, 교통, 공구, 사이렌 예시를 확인해요.',
    intro: '일상 소리의 대략적인 크기예요. 거리와 방 반사, 측정 시간, 가중에 따라 실제 값은 달라져요.', label: '비교표', article: true,
    body: `<table><caption class="sr-only">일상 소음 dBA 대략값</caption><thead><tr><th>크기 (대략)</th><th>소리 예시</th></tr></thead><tbody><tr><td>30 dBA</td><td>밤의 조용한 침실</td></tr><tr><td>40 dBA</td><td>조용한 도서관</td></tr><tr><td>50 dBA</td><td>조용한 사무실, 적당한 빗소리</td></tr><tr><td>60 dBA</td><td>보통 대화 소리</td></tr><tr><td>70 dBA</td><td>가까운 거리의 붐비는 교통 소음</td></tr><tr><td>80 dBA</td><td>시끄러운 식당, 자명종 소리</td></tr><tr><td>90 dBA</td><td>잔디 깎는 기계, 오토바이</td></tr><tr><td>100 dBA</td><td>콘서트 앞자리 함성</td></tr><tr><td>110 dBA</td><td>전동 공구, 큰 라이브 공연</td></tr><tr><td>120 dBA</td><td>가까운 거리의 사이렌</td></tr></tbody></table><h2>표를 읽는 방법을 알아요</h2><p>데시벨은 로그 눈금이라 10 dB이 오르면 소리 에너지는 대략 열 배가 돼요. <a href="/ko/#measure">온라인 데시벨 측정기</a> 값과 비교할 때는 <a href="/ko/calibration/">마이크를 먼저 교정</a>하고 표와 같은 A 가중 dBA를 골라주세요. Slow 1s 반응으로 30초에서 60초 Leq를 읽고 소수점은 반올림해주세요. 같은 소파에서도 앉는 자리와 가전 동작, 손에 들고 재는지 탁자에 두는지, 가중 설정이 바뀌었는지에 따라 밤마다 몇 dB씩 달라져요. 비교할 때는 항상 같은 자리와 같은 설정으로 재주세요. 기종에 따라 5에서 10 dB씩 벌어지는 일은 흔하고, 30 dBA 아래에서는 높게, 95에서 100 dBA 근처에서는 포화로 낮게, 저음은 약하게 나와요.</p><h2>크기와 시간을 함께 봐요</h2><p>크기만으로 판단하지 말아주세요. 85 dBA 8시간을 참고 기준으로 삼고 3 dB 오를 때마다 허용 시간이 대략 절반으로 준다고 생각해주세요. 70 dBA 아래에서는 대개 시간 걱정이 크지 않아요. 91 dBA 잔디 깎기 두 시간과 0.5초 쾅 소리는 전혀 다르게 다뤄주세요. Leq 옆에는 항상 측정 시간을 함께 적어주세요. 브라우저 수치는 참고용으로만 쓰고, 정식 평가는 교정된 Class 1 또는 Class 2 장비에 맡겨주세요. 가중 고르는 법은 <a href="/ko/db-vs-dba/">dB와 dBA 차이</a>에서 확인해요.</p><p><a href="/ko/accuracy/">정확도와 한계 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'db-vs-dba', key: 'db-vs-dba', title: 'dB와 dBA 차이를 이해해요',
    description: 'dB와 dBA, dBC, dBZ 뜻과 A와 C, Z 가중, Fast와 Slow 반응 고르는 방법을 온라인 소음 측정용으로 설명해요.',
    intro: 'dB는 로그 비율을 나타내는 단위예요. 뒤에 붙는 A와 C, Z는 주파수를 세는 방식이 달라요.', label: 'dB와 dBA', article: true,
    body: `<h2>dBFS와 방 소리 크기는 달라요</h2><p>브라우저가 직접 받는 값은 디지털 최대값을 0으로 삼는 dBFS예요. 0이 가장 큰 신호이고 조용한 값은 한참 아래 음수로 표시돼요. 방 소리 크기에 가깝게 바꾸려면 마이크와 기준기를 비교하는 <a href="/ko/calibration/">교정</a>이 필요해요. 미교정 상태에서는 가중 dBFS에 공칭 +100 dB를 더한 추정치를 보여주고, 원래 dBFS는 진단 화면에서 확인할 수 있어요.</p><h2>A와 C, Z 가중을 골라요</h2><ul><li><strong>A 가중 dBA:</strong> 사람 청감에 가깝게 보정해서 일상 공간과 대화 비교에 자주 써요.</li><li><strong>C 가중 dBC:</strong> A보다 평탄해서 저음을 더 살리고 큰 소리와 피크 비교에 어울려요.</li><li><strong>Z 가중 dBZ:</strong> 주파수 보정을 하지 않는 평탄한 표시예요. 기기 간 기술 비교에 써요.</li></ul><p>같은 휴대폰으로 같은 탁자에서 재도 저음이 많은 방에서는 A와 C가 크게 벌어져요. 냉장고 웅웅거림은 33 dBA인데 52 dBC처럼 나올 수 있고, 보통 대화는 62 dBA와 63 dBC로 거의 붙어요. 저음이 강한 음악은 78 dBA인데 88 dBC처럼 벌어져요. 스펙트럼에서 강한 대역이 왼쪽에 몰리면 C와 Z가 A보다 높게 나와요. 가중은 강한 대역을 기준으로 보정돼요.</p><h2>Fast와 Slow를 골라요</h2><p>Fast 125ms는 짧은 변화와 피크를 잘 따라가고, Slow 1s는 표시 흔들림을 줄여서 평균적인 상태를 읽기 쉬워요. 문 닫힘은 Fast에서 쑥 튀고 Slow에서는 잔잔하게 지나가요. Leq 에너지 평균은 표시 평활화와 따로 쌓이니 비교할 때는 도중에 설정을 바꾸지 말아주세요. 20초씩 A와 C를 나란히 재보면 스펙트럼 왼쪽 막대가 클 때 C가 높게 나오는 원리가 바로 보여요. 30초에서 60초 평균으로 읽고 소수점은 무시해주세요. 기종 차이 5에서 10 dB 앞에서는 소수점이 의미가 없어요. 측정 흐름은 <a href="/ko/methodology/">측정 원리</a>에서, 예시 크기는 <a href="/ko/decibel-chart/">데시벨 비교표</a>에서 이어서 확인해요.</p><p><a href="/ko/#measure">측정기 열기 →</a> · <a href="/ko/accuracy/">정확도 보기 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'microphone-not-working', key: 'microphone-not-working', title: '마이크가 작동하지 않을 때 해결 방법',
    description: '온라인 데시벨 측정기에서 마이크가 열리지 않을 때 확인 순서를 안내해요. 브라우저 권한, 입력 장치, HTTPS, 다른 앱 사용을 살펴봐요.',
    intro: '시작을 눌러도 측정이 시작되지 않으면 위에서부터 순서대로 확인해주세요. 실제 오디오가 들어오기 전에는 "--"가 표시돼요.', label: '마이크 문제', article: true,
    body: `<h2>1. 마이크 권한을 확인해주세요</h2><p>주소창의 자물쇠나 사이트 설정 아이콘을 열고 마이크를 허용으로 바꿔주세요. 바꾼 뒤에는 페이지를 새로고침하고 다시 시작을 눌러주세요. 권한은 같은 주소에서 한 번만 기억되고, 운영체제의 마이크 개인정보 스위치가 꺼져 있어도 브라우저가 입력을 열지 못해요. 거부된 채로는 대기 "--"만 표시되고 아무것도 수집되지 않아요.</p><h2>2. 입력 장치를 골라주세요</h2><p>컴퓨터와 휴대폰 설정에서 원하는 마이크가 입력 장치로 선택됐는지 확인해주세요. USB 마이크나 헤드셋을 연결한 뒤에는 목록을 새로고침하거나 페이지를 다시 읽어주세요. 노트북은 내장 어레이와 헤드셋, 모니터 마이크를 따로 보여줄 때가 있어서 잘못 고르면 조용한 다른 방을 재게 돼요. 목록에서 정확한 입력을 고르고 시작을 눌러주세요.</p><h2>3. 다른 앱을 닫아주세요</h2><p>통화와 온라인 회의, 녹음 앱이 마이크를 쓰고 있으면 브라우저가 입력을 열지 못해요. 그런 앱과 마이크를 쓰는 다른 탭을 먼저 종료하고 다시 시도해주세요. 블루투스 이어폰은 연결이 끊기면 노트북 마이크로 바뀌면서 게인과 위치가 통째로 달라지니 다시 페어링한 뒤 목록에서 골라주세요. 그래도 막대가 아니라 그래프가 멈춰 있으면 권한 문제로 돌아가 다시 확인해주세요.</p><h2>4. 안전한 연결과 브라우저를 확인해주세요</h2><p>마이크 기능은 HTTPS 보안 연결에서 사용해주세요. 주소가 https로 시작하는지 확인해주세요. 최신 Chrome과 Edge, Safari, Firefox에서 확인해주시고, 시크릿 창이나 엄격한 기기 관리 정책, 오래된 브라우저에서는 마이크가 막힐 수 있어요. 그래도 안 되면 페이지를 새로고침하고 다른 마이크로 시도해보고, 운영체제 소리 패널에서도 입력 막대가 움직이는지 보세요. 거기마저 멈춰 있으면 기기 쪽 스위치와 볼륨, 장치 선택을 먼저 손봐주세요. 모노 입력에 에코 제거와 잡음 억제, 자동 게인은 끄도록 요청하고 스피커로는 연결하지 않아요. 배치는 <a href="/ko/how-to-use/">사용 방법</a>을, 한계는 <a href="/ko/accuracy/">정확도 안내</a>를 참고해주세요.</p><p><a href="/ko/#measure">측정으로 돌아가기 →</a> · <a href="/ko/privacy/">프라이버시 안내 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'privacy', key: 'privacy', title: '마이크 음성 프라이버시와 쿠키 안내',
    description: '온라인 데시벨 측정기가 마이크 음성을 기기 안에서 처리하는 방식과 브라우저 권한, 로컬 저장, 분석과 광고 쿠키를 설명해요.',
    intro: '측정에 필요한 마이크 권한과 음성, 세션 데이터 처리 방식을 설명해요. 마이크 음성은 서버로 올라가지 않아요.', label: '프라이버시', article: true,
    body: `<h2>마이크 권한을 확인해요</h2><p>측정은 시작을 누르고 브라우저에서 직접 허용할 때만 시작돼요. 권한은 같은 주소에서 한 번만 물어보고, 주소창 사이트 설정에서 언제든 취소할 수 있어요. 거부하면 대기 "--"만 표시되고 아무것도 수집되지 않아요. 입력은 모노로 받고 스피커로 연결되지 않아요.</p><h2>음성을 기기 안에서 처리해요</h2><p>마이크 샘플은 Web Audio API로 그 브라우저 안에서 바로 분석돼요. 이 사이트는 마이크 음성을 녹음 파일로 만들지 않고 서버로 전송하지 않아요. 측정을 멈추면 트랙을 정리하고 오디오 컨텍스트를 닫아요. 네트워크를 끊은 뒤에도 그래프가 이어지면 처리가 로컬에서 이뤄지고 있다는 뜻이에요. 현재값과 최소값, Leq, 최대값, 측정 시간, 최근 240개 점 그래프는 모두 기기 안에서 계산돼요.</p><h2>브라우저에 남는 정보를 알아요</h2><p>교정 프로파일과 테마, 저장하기로 고른 세션 기록은 그 브라우저 로컬 저장소에만 남아요. 기록은 최대 20개까지 유지되고 화면에서 지울 수 있으며, 사이트 데이터를 지워도 함께 사라져요. CSV와 JSON 내보내기는 브라우저 안에서 만들고 사용자 기기에 직접 저장해요. 호환 교정이 있을 때만 dB 값을 담고 미교정 내보내기에는 dB 숫자를 넣지 않아요. 음성 녹음은 포함되지 않아요.</p><h2>분석과 광고 쿠키를 확인해요</h2><p>사이트 이용 흐름을 파악하려고 Google Analytics를 사용해요. 페이지와 브라우저, 기기 정보나 분석 쿠키가 Google로 전송될 수 있지만 마이크 음성과 측정 샘플은 절대 전송되지 않아요. 광고가 표시되는 경우 Google AdSense와 파트너가 광고 제공과 측정을 위해 쿠키를 사용하고, 이 사이트와 다른 사이트 방문을 바탕으로 맞춤 광고가 표시될 수 있어요. 맞춤 광고는 <a href="https://www.google.com/settings/ads">Google 광고 설정</a>에서 끌 수 있고, <a href="https://optout.aboutads.info/">aboutads.info</a>에서 제3자 맞춤 광고를 거부할 수도 있어요. 마이크 음성과 측정 샘플은 광고에 절대 사용되지 않아요.</p><p><a href="/ko/methodology/">로컬 처리 과정 보기 →</a> · <a href="/ko/#measure">측정기 열기 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
  {
    slug: 'noise-meter-app', key: 'noise-meter-app-ko', title: '스마트폰 소음 측정 앱: 무료로 바로 측정해요',
    description: '설치 없이 쓰는 무료 스마트폰 소음 측정 안내예요. 아이폰과 안드로이드 측정 순서, dBA 읽기, 교정, 정확도와 자주 묻는 질문을 확인해요.',
    intro: '이 페이지 자체가 무료 소음 측정 앱이에요. 브라우저에서 시작을 누르고 마이크를 허용하면 추정치 dBA가 바로 표시돼요.', label: '소음 측정 앱', article: true,
    body: `<div style="border:1px solid var(--border);border-radius:12px;padding:16px;background:linear-gradient(135deg,rgba(59,130,246,.14),rgba(59,130,246,.03))"><p><strong>지금 해보세요. 10초면 충분하고 설치가 필요 없어요:</strong></p><ol><li>휴대폰 브라우저에서 이 페이지를 열어주세요.</li><li><a href="/ko/#measure">측정 시작하기 →</a>를 누르고 마이크를 허용해주세요.</li><li>추정치 dBA를 실시간으로 읽고 30초에서 60초 평균으로 판단해주세요.</li></ol><p>음성은 기기 안에서만 처리되고 외부로 전송되지 않아요.</p></div><h2>소음 측정 앱이 무엇인지 알아요</h2><p>소음 측정 앱과 데시벨 측정기, 소음계는 같은 일을 해요. 소리 크기를 데시벨 숫자로 보여줘요. 이 사이트는 설치 없는 온라인 소음계로 추정치 dBA와 dBC, dBZ, 현재값과 최소값, Leq, 최대값, 측정 시간, CSV와 JSON 내보내기를 제공해요.</p><h2>무료로 쓸 수 있는지 확인해요</h2><p>네, 이 사이트가 무료예요. 무료 소음 측정 앱을 찾는 분은 그대로 브라우저에서 쓰시면 돼요. 기록은 이 브라우저에만 최대 20개까지 남고 서버로 올라가지 않아요. 내보내기 파일은 호환 교정이 있을 때만 dB 값을 담아요.</p><h2>아이폰과 안드로이드에서 측정해요</h2><ul><li><strong>아이폰 무료 측정:</strong> Safari에서 열고 시작을 누른 뒤 허용만 해주세요. 아이폰마다 한 번씩 <a href="/ko/calibration/">기준기로 교정</a>하면 정확도가 올라가요.</li><li><strong>안드로이드 무료 측정:</strong> Chrome에서 열어주세요. 에코 제거와 잡음 억제, 자동 게인은 끄도록 요청하고 처리 상태는 기기 패널에 표시돼요.</li><li><strong>휴대폰 데시벨 측정 요령:</strong> 마이크 구멍을 가리지 말고 귀 높이에서 재주세요.</li></ul><h2>데시벨 측정이 무엇인지 알아요</h2><p>데시벨 측정과 소음 측정은 소리 세기를 로그 눈금 숫자로 바꾸는 같은 말이에요. 이 사이트는 브라우저에서 바로 쓰는 온라인 측정 도구로, 미교정 상태에서는 공칭 +100 dB 오프셋을 더한 추정치를 보여줘요. HTTPS에서 동작하고 권한은 같은 주소에서 한 번만 물어봐요.</p><h2>측정기와 측정 앱이 따로 필요한지 살펴봐요</h2><p>가벼운 확인에는 브라우저로 충분해요. 저음과 큰 피크를 비교할 때는 C나 Z 가중으로 함께 봐주세요. 정식 평가가 필요하면 교정된 Class 1 또는 Class 2 소음계를 사용해주세요. 예시 크기는 <a href="/ko/decibel-chart/">데시벨 비교표</a>에서 확인해요.</p><h2>측정 앱 정확도를 이해해요</h2><p>정확도는 대략 몇 dB 정도로 생각해주세요. 같은 소리를 재도 기종에 따라 5에서 10 dB 정도 벌어질 때가 있어요. 30 dBA 아래에서는 높게, 95에서 100 dBA 근처에서는 포화로 낮게, 저음은 약하게 나와요. 소수점은 무시하고 30초에서 60초 평균으로 봐주세요. 85 dBA 8시간을 참고 기준으로 삼고 3 dB 오를 때마다 허용 시간이 대략 절반으로 준다고 생각해주세요. 자세한 내용은 <a href="/ko/accuracy/">정확도 안내</a>에서 읽어보세요.</p><h2>순서대로 측정해요</h2><ol><li>마이크를 허용해주세요.</li><li>마이크 구멍을 가리지 말고 귀 높이에서 소리를 향해 주세요.</li><li>조용히 계신 채로 몇 초 기다린 뒤 평균과 Leq를 30초에서 60초로 읽어주세요.</li><li>비교할 때는 가중과 시정수, 위치를 고정해주세요.</li></ol><p><a href="/ko/how-to-use/">사용 방법 →</a> · <a href="/ko/calibration/">교정 방법 →</a> · <a href="/ko/decibel-chart/">데시벨 비교표 →</a></p><h2>자주 묻는 질문을 확인해요</h2><h3>무료로 쓸 수 있어요?</h3><p>네, 무료예요. <a href="/ko/#measure">측정 패널 →</a>에서 바로 쓰실 수 있어요.</p><h3>휴대폰으로 데시벨을 잴 수 있어요?</h3><p>네, 아이폰과 안드로이드 모두 브라우저만으로 측정할 수 있어요.</p><h3>교정은 꼭 해야 해요?</h3><p>가벼운 비교에는 필수가 아니에요. 기기별 차이를 좁히고 싶으면 <a href="/ko/calibration/">같은 자리에서 한 번만 교정</a>해주세요.</p><p><a href="/ko/#measure">측정기 열기 →</a> · <a href="/ko/guides/">가이드 모음 →</a></p>`,
  },
];

export function getStaticPaths() {
  return ['guides', 'how-to-use', 'methodology', 'calibration', 'accuracy', 'decibel-chart', 'db-vs-dba', 'microphone-not-working', 'privacy', 'noise-meter-app']
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown Korean guide route: ${slug}`);
const dict = getDict('ko');
const path = `/ko/${page.slug}/`;
const url = `${SITE}${path}`;
const jsonLd = [
  ...(page.article ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'ko', dateModified: '2026-09-24' })] : []),
  breadcrumbJsonLd([{ name: '홈', url: `${SITE}/ko/` }, { name: page.label, url }]),
];
---

<Layout locale="ko" dict={dict} title={`${page.title} | Real Decibel Meter`} description={page.description} path={path} hreflang={guideHreflang(page.key)} jsonLd={jsonLd} ogType={page.article ? 'article' : 'website'}>
  <Article title={page.title} intro={page.intro} reviewed="2026-09-24" breadcrumb={[{ name: '홈', href: '/ko/' }, { name: page.label, href: path }]}>
    <div class="article-rich" set:html={page.body} />
  </Article>
</Layout>
