---
import Layout from '../../components/Layout.astro';
import Article from '../../components/Article.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, guideHreflang } from '../../lib/seo';
const dict = getDict('en');
const title = 'dB vs dBA: Weighting Explained';
const description = 'What dB, dBA, dBC and dBZ mean, how A/C/Z weighting works, and which setting to pick on the online decibel meter.';
const url = `${SITE}/db-vs-dba/`;
const jsonLd = [
  articleJsonLd({ headline: title, description, url, inLanguage: 'en', dateModified: '2026-09-16' }),
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITE}/` },
    { name: 'dB vs dBA', url },
  ]),
];
---

<Layout locale="en" dict={dict} title={`${title} — Real Decibel Meter`} description={description} path="/db-vs-dba/" hreflang={guideHreflang('db-vs-dba')} jsonLd={jsonLd}>
  <Article title={title} intro="dB is the unit; the trailing letter says which frequency weighting was applied." reviewed="2026-09-16" breadcrumb={[{ name: 'Home', href: '/' }, { name: 'dB vs dBA', href: '/db-vs-dba/' }]}>
    <ul class="space-y-3 mt-2">
      <li><strong class="text-white">dBZ (Z-weighted).</strong> Flat: all frequencies count equally. Best for comparing spectra and for calibration math.</li>
      <li><strong class="text-white">dBA.</strong> A-weighting roughly follows human hearing at moderate levels — quiet low frequencies count less. Default on this meter for everyday environments and <a class="underline underline-offset-4" href="/decibel-chart/">decibel chart</a> comparisons.</li>
      <li><strong class="text-white">dBC.</strong> Flatter than A; closer to how loud peaks feel. Useful near loud machinery or music.</li>
    </ul>
    <h2 class="text-white font-semibold mt-6">Which weighting should I pick?</h2>
    <p class="mt-2">Everyday room and street checks: A. Loud bass-heavy events: compare A and C. Technical comparison between two recordings: Z, with identical response. Whichever you pick, <a class="underline underline-offset-4" href="/calibration/">calibrate with the same weighting</a> you measure with.</p>
    <h2 class="text-white font-semibold mt-6">Fast vs Slow</h2>
    <p class="mt-2">Fast (125 ms) follows peaks; Slow (1 s) smooths them. Neither changes the underlying estimate — only how quickly the display follows it. Leq (energy average) accumulates independently of the display smoothing.</p>
    <p class="mt-4"><a class="underline underline-offset-4" href="/#measure">Open the online decibel meter →</a> · <a class="underline underline-offset-4" href="/methodology/">How the meter works →</a></p>
  </Article>
</Layout>
