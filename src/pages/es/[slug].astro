---
import Layout from '../../components/Layout.astro';
import Article from '../../components/Article.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, guideHreflang, type GuideKey } from '../../lib/seo';

interface SpanishGuide {
  slug: string; key: GuideKey; title: string; description: string; intro: string; label: string; body: string; article?: boolean;
}

const pages: SpanishGuide[] = [
  {
    slug: 'guias', key: 'guides', title: 'Guías del sonómetro en línea',
    description: 'Guías en español para medir decibelios en el navegador: uso, método, calibración, precisión, tabla de sonidos, dB y dBA, micrófono y privacidad.',
    intro: 'Elige la guía según tu tarea. Sin calibrar, el navegador muestra una estimación nominal claramente marcada; una calibración con referencia mejora el nivel en tu dispositivo concreto.',
    label: 'Guías',
    body: `<h2>Medir y situar el nivel</h2><p>Estas guías cubren el flujo completo: medir, entender la cifra y situarla frente a referencias conocidas. Sin calibrar, el navegador muestra una estimación nominal con un ajuste de +100 dB; tras calibrar en el mismo punto, la cifra se acerca a tu equipo concreto.</p><ul><li><a href="/es/como-usar/">Cómo usar el sonómetro</a> — permite el micrófono, coloca el equipo y lee el promedio de 30 a 60 segundos.</li><li><a href="/es/metodologia/">Cómo mide el navegador</a> — Web Audio API, dBFS, ponderaciones A, C y Z, Fast de 125 ms, Slow de 1 segundo y promedio energético Leq.</li><li><a href="/es/calibracion/">Calibrar el sonómetro</a> — calcula un ajuste propio del equipo con una referencia fiable en el mismo punto.</li><li><a href="/es/precision/">Precisión y límites</a> — por qué dos móviles muestran valores distintos, con márgenes de 5 a 10 dB entre modelos.</li><li><a href="/es/tabla-decibelios/">Tabla de decibelios</a> — sonidos cotidianos de 30 a 120 dBA como orientación educativa.</li></ul><h2>Conceptos y solución de fallos</h2><p>La segunda mitad aclara unidades, fallos del micrófono, privacidad y medición con el móvil. Todas las lecturas son estimaciones de cribado; las decisiones formales piden hardware de Clase 1 o Clase 2.</p><ul><li><a href="/es/db-vs-dba/">Diferencia entre dB y dBA</a> — ponderaciones A, C y Z más respuesta Fast y Slow.</li><li><a href="/es/microfono-no-funciona/">El micrófono no funciona</a> — permisos una vez por origen, dispositivo de entrada, HTTPS y navegador.</li><li><a href="/es/privacidad/">Micrófono y privacidad</a> — proceso local en tu equipo, hasta 20 sesiones guardadas y avisos de cookies.</li><li><a href="/es/movil-decibelimetro/">Decibelímetro para el móvil</a> — mide gratis desde el navegador sin instalar nada, con iPhone y Android.</li></ul><p><a href="/es/#measure">Medir el volumen ahora →</a></p>`,
  },
  {
    slug: 'como-usar', key: 'how-to-use', title: 'Cómo usar el sonómetro en línea',
    description: 'Aprende a usar el sonómetro del navegador: permiso del micrófono, colocación, ponderación, lectura del promedio y guardado de sesiones.',
    intro: 'No hace falta instalar nada. Permite el micrófono, deja fijo el equipo, comprueba la ponderación y lee el promedio tras unos segundos de estabilidad.',
    label: 'Cómo usarlo', article: true,
    body: `<h2>1. Permite el micrófono</h2><p>Abre <a href="/es/#measure">el panel de medición</a> y pulsa Iniciar. El navegador pide permiso una vez por origen y solo mide tras aceptar. La señal entra en mono mediante getUserMedia y Web Audio API; la página solicita desactivar eco, supresión de ruido y ganancia automática, aunque el sistema no siempre obedece. Si aparece "--", no entra audio real: revisa <a href="/es/microfono-no-funciona/">la ayuda del micrófono</a>.</p><h2>2. Coloca el equipo y evita roces</h2><p>Deja libre la abertura del micrófono, aparta viento, manos, bolsillos y rejillas de ventilación. Mantén fija la distancia y la orientación hacia la fuente durante toda la comparación. Sostén el móvil a la altura del oído y anota la distancia. Espera unos segundos hasta que la cifra se estabilice y lee el promedio de 30 a 60 segundos, no picos sueltos.</p><h2>3. Elige ponderación y respuesta</h2><p>Para ruido cotidiano compara con ponderación A; para graves o picos fuertes prueba con C; Z muestra la señal sin ponderar. Fast sigue cambios rápidos con una constante de 125 ms y Slow suaviza con 1 segundo. No cambies estos ajustes a mitad de una comparación. Consulta <a href="/es/db-vs-dba/">dB y dBA</a> y <a href="/es/metodologia/">el método de cálculo</a>.</p><h2>4. Guarda y compara sesiones</h2><p>La pantalla muestra nivel actual, mínimo, promedio energético Leq, máximo, duración y un gráfico de 240 puntos. Sin calibrar, la cifra suma un ajuste nominal de +100 dB y se marca como estimación. El historial guarda hasta 20 sesiones en tu navegador. La descarga en CSV o JSON solo incluye niveles calibrados como tales. Para acercar el nivel a tu equipo, <a href="/es/calibracion/">calibra con referencia</a>; para decisiones formales usa hardware de Clase 1 o Clase 2.</p><p><a href="/es/#measure">Abrir el medidor →</a> · <a href="/es/precision/">Precisión y límites →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'metodologia', key: 'methodology', title: 'Cómo calcula el nivel el navegador',
    description: 'Método del sonómetro web: entrada del micrófono, RMS, dBFS, ponderaciones A, C y Z, Fast y Slow, Leq y ajuste de calibración.',
    intro: 'Esta página explica paso a paso cómo una muestra del micrófono se convierte en la cifra que ves en pantalla.',
    label: 'Método', article: true,
    body: `<h2>Entrada del micrófono</h2><p>Todo empieza con getUserMedia: tras pulsar Iniciar y aceptar el permiso, el navegador abre el micrófono en mono y entrega muestras a Web Audio API mediante HTTPS. La página pide desactivar la cancelación de eco, la supresión de ruido y la ganancia automática, pero cada sistema y navegador decide cuánto respeta. El panel indica el estado del procesado. Al detener, las pistas se liberan y el contexto de audio se cierra; nada se sube a ningún servidor.</p><h2>RMS y dBFS</h2><p>Cada bloque corto de audio se reduce a su valor eficaz RMS y se expresa en dBFS, la escala digital cuyo cero marca el máximo representable. Por eso los valores digitales brutos son negativos. Sin calibrar, el medidor suma un ajuste nominal de +100 dB y etiqueta el resultado como estimación de dBA, dBC o dBZ. Esa marca deja claro que se trata de intensidad de entrada, no de una lectura ambiental directa.</p><h2>Ponderación y respuesta temporal</h2><p>El análisis de frecuencia aplica la ponderación elegida: A sigue la sensibilidad del oído, C deja pasar más graves y Z no pondera. Después, la respuesta Fast con 125 ms reacciona deprisa a cambios y picos, mientras Slow con 1 segundo suaviza la lectura. El promedio de la sesión no es una media aritmética simple: acumula energía como Leq, con mínimo, máximo, duración y gráfico de 240 puntos.</p><h2>Estimación tras calibrar</h2><p>Al comparar en el mismo punto con un instrumento fiable y guardar la diferencia como ajuste fijo, el medidor muestra una estimación más cercana a tu equipo. Ese ajuste no corrige la respuesta en frecuencia, la distorsión, el recorte ni la ganancia automática variable. Las descargas CSV y JSON solo marcan niveles calibrados como tales. Para uso formal, emplea hardware de Clase 1 o Clase 2. Sigue con <a href="/es/calibracion/">la calibración</a> o <a href="/es/precision/">los límites</a>.</p><p><a href="/es/#measure">Abrir el medidor →</a> · <a href="/es/privacidad/">Micrófono y privacidad →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'calibracion', key: 'calibration', title: 'Calibrar el sonómetro del navegador',
    description: 'Cómo calibrar el sonómetro web con un instrumento de referencia, la misma ponderación y un ajuste propio del equipo.',
    intro: 'Calibrar aquí significa comparar navegador y referencia en el mismo punto y guardar la diferencia como ajuste fijo. Acerca el nivel global sin convertir el navegador en un instrumento de uso formal.',
    label: 'Calibración', article: true,
    body: `<h2>Qué necesitas</h2><ul><li>Un sonómetro fiable ya calibrado o un calibrador acústico de nivel conocido y estable.</li><li>El mismo micrófono, navegador, equipo y posición que usarás después para medir.</li><li>La misma ponderación A, C o Z y la misma respuesta Fast o Slow en ambos lados.</li></ul><h2>Calibración en cuatro pasos</h2><ol><li>Coloca el equipo del navegador junto al instrumento de referencia, con las aberturas del micrófono libres y a la misma distancia de la fuente.</li><li>Usa un sonido de referencia lo más estable posible y espera hasta que ambas pantallas se asienten durante varios segundos.</li><li>Captura en el diálogo de medición el promedio digital y escribe el nivel conocido de la referencia; la diferencia queda como ajuste del perfil.</li><li>Guarda el perfil y vuelve a comprobar la lectura frente a la referencia con el mismo sonido.</li></ol><h2>Cuándo deja de valer el perfil</h2><p>Si cambias de micrófono, auriculares, navegador, ganancia de entrada, ponderación, respuesta temporal o posición del equipo, revisa la calibración. El ajuste de otro teléfono no se puede trasladar: la sensibilidad varía de 5 a 10 dB entre modelos. Recuerda que un ajuste único no corrige graves débiles, recorte sobre 95 a 100 dBA ni lecturas altas por debajo de 30 dBA. Lee también <a href="/es/precision/">precisión y límites</a> y <a href="/es/db-vs-dba/">dB y dBA</a>.</p><p><a href="/es/#measure">Abrir el sonómetro →</a> · <a href="/es/metodologia/">Cómo mide el navegador →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'precision', key: 'accuracy', title: 'Precisión del sonómetro online',
    description: 'Qué precisión ofrece un sonómetro web: micrófono, ganancia automática, respuesta en frecuencia, calibración y usos adecuados.',
    intro: 'Los micrófonos de móvil y portátil están pensados para voz, no para acústica. Sirven para comparar y orientarse, pero sin referencia fiable no aportan valores de uso formal.',
    label: 'Precisión', article: true,
    body: `<h2>Por qué dos equipos muestran cifras distintas</h2><ul><li><strong>Hardware:</strong> cápsula, previo, carcasa y posición de la abertura cambian la sensibilidad; entre modelos son normales diferencias de 5 a 10 dB.</li><li><strong>Proceso automático:</strong> el sistema o el navegador puede aplicar ganancia automática, supresión de ruido o cancelación de eco sin avisar.</li><li><strong>Respuesta en frecuencia:</strong> un ajuste único no corrige que los graves suenen débiles ni otras desviaciones por banda.</li><li><strong>Colocación:</strong> distancia, reflejos de la sala, viento y roces de la mano alteran el resultado.</li></ul><h2>Qué mejora la calibración</h2><p>Comparar en el mismo punto con un instrumento fiable acerca el nivel global a la referencia. No elimina el recorte cerca de 95 a 100 dBA, no baja el suelo que infla lecturas bajo 30 dBA y no fija una ganancia automática que varía con el nivel. El método exacto está en <a href="/es/calibracion/">calibrar el sonómetro</a>. Lee el promedio Leq de 30 a 60 segundos e ignora decimales: la cifra orienta, no sentencia.</p><h2>Cuándo hace falta otro instrumento</h2><p>Para trabajo, disputas, salud auditiva o demostrar una norma, usa hardware de Clase 1 o Clase 2 calibrado con su procedimiento. Este medidor solo ofrece estimaciones de cribado para comparar situaciones. Como referencia de dosis, 85 dBA durante 8 horas marca un umbral conocido y el tiempo admisible se reduce a la mitad por cada 3 dB de aumento.</p><p><a href="/es/#measure">Iniciar medición →</a> · <a href="/es/tabla-decibelios/">Tabla de decibelios →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'tabla-decibelios', key: 'decibel-chart', title: 'Tabla de decibelios',
    description: 'Tabla de decibelios con valores dBA aproximados: dormitorio, biblioteca, conversación, tráfico, moto y concierto.',
    intro: 'Estos ejemplos solo orientan. Distancia, sala, duración y ponderación pueden cambiar mucho el nivel real.',
    label: 'Tabla de decibelios', article: true,
    body: `<table><caption class="sr-only">Niveles cotidianos aproximados en dBA</caption><thead><tr><th>Nivel (aprox.)</th><th>Ejemplo</th></tr></thead><tbody><tr><td>30 dBA</td><td>Dormitorio silencioso de noche</td></tr><tr><td>40 dBA</td><td>Biblioteca tranquila</td></tr><tr><td>50 dBA</td><td>Oficina silenciosa, lluvia moderada</td></tr><tr><td>60 dBA</td><td>Conversación normal</td></tr><tr><td>70 dBA</td><td>Tráfico denso a poca distancia</td></tr><tr><td>80 dBA</td><td>Restaurante ruidoso</td></tr><tr><td>90 dBA</td><td>Cortacésped o motocicleta</td></tr><tr><td>100 dBA</td><td>Zona delantera de un concierto</td></tr><tr><td>110 dBA</td><td>Herramientas eléctricas ruidosas</td></tr><tr><td>120 dBA</td><td>Sirena a poca distancia</td></tr></tbody></table><h2>Cómo usar bien los valores</h2><p>La escala es logarítmica: subir 10 dB multiplica por diez la energía sonora, así que un salto pequeño en pantalla refleja un cambio grande en energía. Compara lecturas del navegador solo tras <a href="/es/calibracion/">calibrar</a> y con ponderación A, la misma de esta tabla. Mide de 30 a 60 segundos y quédate con el promedio Leq, no con picos fugaces. Ten presente que equipos distintos varían de 5 a 10 dB, que los graves salen débiles y que cerca de 95 a 100 dBA el recorte deja la lectura baja. Repite tres veces las comparaciones importantes y anota distancia y posición.</p><h2>Salud y duración</h2><p>El daño depende de nivel y tiempo: 85 dBA durante 8 horas sirve como referencia y el tiempo admisible se reduce a la mitad por cada 3 dB más. Esta tabla es material educativo y no decide protección auditiva ni disputas; para decisiones formales usa hardware de Clase 1 o Clase 2. Revisa los <a href="/es/precision/">límites de medición</a>.</p><p><a href="/es/#measure">Medir el volumen →</a> · <a href="/es/db-vs-dba/">dB y dBA →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'db-vs-dba', key: 'db-vs-dba', title: 'Diferencia entre dB, dBA, dBC y dBZ',
    description: 'Qué distingue dB, dBA, dBC y dBZ, más la respuesta Fast y Slow en mediciones de ruido con el navegador.',
    intro: 'dB describe una relación logarítmica. Las letras A, C y Z indican cómo se ponderan las frecuencias en la cifra mostrada.',
    label: 'dB y dBA', article: true,
    body: `<h2>dBFS no es nivel ambiental</h2><p>El navegador recibe valores digitales en dBFS, donde cero marca el máximo representable y las cifras normales son negativas. Ese número describe intensidad de entrada, no presión sonora ambiental. Para acercarlo a dB de entorno hace falta sensibilidad del micrófono y una <a href="/es/calibracion/">calibración con referencia</a> en el mismo punto. Sin ese paso, usa la cifra solo para comparar situaciones con el mismo equipo y ajustes.</p><h2>Ponderaciones A, C y Z</h2><ul><li><strong>dBA:</strong> sigue la sensibilidad del oído y se usa mucho para ruido cotidiano y conversación.</li><li><strong>dBC:</strong> curva más plana que deja pasar más graves; ayuda con picos fuertes o música con bajo.</li><li><strong>dBZ:</strong> muestra la señal sin ponderar frecuencias.</li></ul><h2>Fast y Slow</h2><p>Fast aplica una constante de 125 ms y persigue cambios breves; Slow promedia con 1 segundo y deja una lectura más estable. Para comparar de forma justa, mantén fijos ponderación, respuesta, posición, distancia y perfil de calibración. El promedio Leq resume la energía del periodo, mientras el mínimo y el máximo acotan la variación. En la práctica, elige A con Slow para ruido ambiental estable y Fast para localizar picos cortos antes de promediar. Más detalle en <a href="/es/metodologia/">el método</a> y en <a href="/es/precision/">los límites</a>.</p><p>Recuerda que la pantalla añade un gráfico de 240 puntos con mínimo, Leq, máximo y duración. Sin calibrar, la cifra parte de un ajuste nominal de +100 dB y se marca como estimación de entrada.</p><p><a href="/es/#measure">Abrir el medidor →</a> · <a href="/es/tabla-decibelios/">Tabla de decibelios →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'microfono-no-funciona', key: 'microphone-not-working', title: 'El micrófono no funciona',
    description: 'Si el sonómetro no detecta el micrófono: permiso, dispositivo de entrada, HTTPS, otras aplicaciones y navegador.',
    intro: 'Empieza por el permiso del navegador y avanza paso a paso. La lectura queda en "--" mientras no entre una señal real de audio.',
    label: 'Ayuda del micrófono', article: true,
    body: `<h2>1. Revisa el permiso</h2><p>Abre los permisos del sitio desde el icono junto a la dirección y deja el micrófono en Permitir. Recarga la página y pulsa Iniciar de nuevo. El navegador pide permiso una vez por origen y puedes revocarlo cuando quieras. Si lo deniegas, el medidor muestra "--" y no capta nada. Esta página funciona en contexto seguro mediante HTTPS; sin esa conexión el acceso falla.</p><h2>2. Elige el dispositivo de entrada correcto</h2><p>Mira los ajustes de sonido del sistema y confirma que el micrófono deseado queda como entrada. Tras conectar un micrófono USB o unos auriculares, actualiza la lista o recarga la página. Deja libre la abertura del micrófono y prueba a hablar cerca: la barra de señal debe moverse. Si hay varios micrófonos, cambia de uno a otro hasta dar con el activo.</p><h2>3. Cierra otras aplicaciones</h2><p>Llamadas, videoconferencias o grabadoras pueden ocupar el micrófono en exclusiva y bloquear al navegador. Cierra esos programas, detén la medición y vuelve a intentarlo. En móvil, vuelve a la pestaña del medidor y evita minimizar durante la captura, porque el sistema puede pausar el audio.</p><h2>4. Navegador y conexión segura</h2><p>Usa una versión reciente de Chrome, Edge, Firefox o Safari. Las ventanas privadas o los equipos gestionados pueden bloquear el acceso aunque pulses Permitir. Si el fallo sigue, prueba con otro navegador, comprueba el estado del procesado en pantalla y consulta <a href="/es/precision/">precisión y límites</a> y <a href="/es/calibracion/">calibración</a>.</p><p><a href="/es/#measure">Intentar medir →</a> · <a href="/es/como-usar/">Cómo usarlo →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'privacidad', key: 'privacy', title: 'Micrófono, privacidad y cookies',
    description: 'Cómo trata el sonómetro el audio del micrófono, el guardado local, Google Analytics y las cookies de Google AdSense.',
    intro: 'Esta página explica el permiso del micrófono y qué ocurre con el audio, las sesiones y las cookies de análisis y publicidad.',
    label: 'Privacidad', article: true,
    body: `<h2>Permiso del micrófono</h2><p>La medición solo empieza al pulsar Iniciar y aceptar el permiso. El navegador lo pide una vez por origen y puedes revocarlo en los ajustes del sitio junto a la dirección. Al detener, las pistas se liberan y el contexto de audio se cierra. Si aparece "--", no entra audio real.</p><h2>Proceso del audio</h2><p>Las muestras se analizan con Web Audio API dentro de tu navegador. Este sitio no crea archivos de grabación, no sube audio a servidores ni comparte muestras. Los archivos estáticos viajan mediante HTTPS; el alojamiento puede guardar registros de acceso estándar fuera del control de la aplicación.</p><h2>Qué se guarda en el navegador</h2><p>Perfiles de calibración, tema y hasta 20 resúmenes de sesión viven solo en el almacenamiento local de tu navegador. Puedes borrar el historial en pantalla o al limpiar los datos del sitio. Las descargas CSV y JSON se crean en tu equipo y no incluyen grabaciones de audio.</p><h2>Análisis y cookies</h2><p>Para entender el uso del sitio se emplea Google Analytics, que puede fijar cookies de análisis o recibir datos de página, navegador y dispositivo. Nunca recibe audio del micrófono ni muestras de medición. Si se muestra publicidad, Google AdSense y sus socios pueden usar cookies para servir y medir anuncios, incluidos anuncios personalizados según visitas a este y otros sitios. Puedes desactivar la personalización en <a href="https://www.google.com/settings/ads">los ajustes de anuncios de Google</a> o rechazar la publicidad personalizada de terceros en <a href="https://optout.aboutads.info/">aboutads.info</a>. El audio del micrófono y las muestras nunca se usan para publicidad.</p><p><a href="/es/metodologia/">Cómo se procesa en local →</a> · <a href="/es/#measure">Abrir el medidor →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
  {
    slug: 'movil-decibelimetro', key: 'movil-decibelimetro', title: 'Decibelímetro móvil gratis',
    description: 'Decibelímetro gratis para el móvil: mide dBA con iPhone y Android desde el navegador, sin descargar nada. Guía, precisión y calibración.',
    intro: 'Esta página ya es un decibelímetro gratis: abre el navegador, pulsa Iniciar, permite el micrófono y lee dBA estimados en directo.',
    label: 'Decibelímetro móvil', article: true,
    body: `<div style="border:1px solid var(--border);border-radius:12px;padding:16px;background:linear-gradient(135deg,rgba(59,130,246,.14),rgba(59,130,246,.03))"><p><strong>Pruébalo ahora, en 10 segundos y sin app:</strong></p><ol><li>Abre esta página en el <strong>móvil o iPhone</strong>.</li><li><a href="/es/#measure">Inicia la medición →</a> y permite el micrófono.</li><li>Lee <strong>dBA estimados</strong> en directo y promedia 30 a 60 segundos.</li></ol><p>El audio se procesa en tu equipo. No graba ni sube nada.</p></div><h2>Qué es un decibelímetro para el móvil</h2><p>Un decibelímetro, sonómetro o medidor de ruido para el móvil hace lo mismo: expresa el sonido en decibelios. Esta web funciona como decibelímetro en línea sin instalar nada: ofrece dBA, dBC y dBZ estimados, mínimo, promedio, máximo, Leq y espectro. Sin calibrar, muestra intensidad de entrada con un ajuste nominal de +100 dB; tras <a href="/es/calibracion/">calibrar en el mismo punto</a>, acerca el nivel a tu equipo.</p><h2>Hay decibelímetro gratis</h2><p>Sí: esta página es gratis y no pide registro ni descarga. Úsala en el navegador tantas veces como quieras. Las sesiones quedan en tu equipo, hasta 20 entradas, y puedes borrarlas cuando quieras.</p><h2>iPhone y Android gratis</h2><ul><li><strong>iPhone:</strong> abre la página en Safari, pulsa Iniciar y permite el micrófono. Calibra una vez ese iPhone frente a una referencia fiable.</li><li><strong>Android:</strong> abre la página en Chrome. La herramienta pide desactivar eco, ruido y ganancia automática, y muestra el estado del procesado en pantalla.</li><li><strong>Sin app:</strong> la web cubre comprobaciones rápidas sin tiendas ni cuentas.</li></ul><h2>Cómo medir con el móvil</h2><ol><li>Permite el micrófono y deja libre su abertura.</li><li>Sostén el móvil a la altura del oído, orientado a la fuente, y anota la distancia.</li><li>Guarda silencio unos segundos y lee el promedio o Leq de 30 a 60 segundos.</li><li>Para graves o picos fuertes, compara también con ponderación C; consulta <a href="/es/db-vs-dba/">dB y dBA</a>.</li></ol><h2>Qué precisión ofrece</h2><p>Cuenta con varios dB de margen: entre modelos son normales diferencias de 5 a 10 dB, por debajo de 30 dBA la lectura sale alta y sobre 95 a 100 dBA el recorte la deja baja. Más detalle en <a href="/es/precision/">precisión y límites</a>.</p><h2>Preguntas frecuentes</h2><h3>Funciona gratis sin descargar nada</h3><p>Sí. Pulsa <a href="/es/#measure">el panel de medición →</a> y empieza. No hay cuentas ni tiendas.</p><h3>Vale para iPhone y Android</h3><p>Sí. Ambos miden desde el navegador con getUserMedia mediante HTTPS. Si ves "--", revisa <a href="/es/microfono-no-funciona/">la ayuda del micrófono</a>.</p><h3>Sirve para decisiones formales</h3><p>No. Solo ofrece estimaciones de cribado; usa hardware de Clase 1 o Clase 2 calibrado.</p><p><a href="/es/#measure">Abrir el medidor →</a> · <a href="/es/como-usar/">Cómo usarlo →</a> · <a href="/es/guias/">Todas las guías →</a></p>`,
  },
];

export function getStaticPaths() {
  return ['guias', 'como-usar', 'metodologia', 'calibracion', 'precision', 'tabla-decibelios', 'db-vs-dba', 'microfono-no-funciona', 'privacidad', 'movil-decibelimetro']
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown Spanish guide route: ${slug}`);
const dict = getDict('es');
const path = `/es/${page.slug}/`;
const url = `${SITE}${path}`;
const jsonLd = [
  ...(page.article ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'es', dateModified: '2026-09-24' })] : []),
  breadcrumbJsonLd([{ name: 'Inicio', url: `${SITE}/es/` }, { name: page.label, url }]),
];
---

<Layout locale="es" dict={dict} title={`${page.title} | Real Decibel Meter`} description={page.description} path={path} hreflang={guideHreflang(page.key)} jsonLd={jsonLd} ogType={page.article ? 'article' : 'website'}>
  <Article title={page.title} intro={page.intro} reviewed="2026-09-24" breadcrumb={[{ name: 'Inicio', href: '/es/' }, { name: page.label, href: path }]}>
    <div class="article-rich" set:html={page.body} />
  </Article>
</Layout>
