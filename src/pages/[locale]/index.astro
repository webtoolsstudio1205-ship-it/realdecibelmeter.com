---
import Layout from '../../components/Layout.astro';
import MeterPanel from '../../components/MeterPanel.astro';
import { getDict, type Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return (['de', 'it', 'ja', 'es', 'fr', 'pt', 'ko'] as Locale[]).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
const prefix = `/${locale}`;
---

<Layout locale={locale} dict={dict} title={dict.metaTitle} description={dict.metaDescription} path={`${prefix}/`}>
  <div style="position:relative;overflow:hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-x pt-8 md:pt-12 pb-4" style="max-width:1120px">
      <p class="eyebrow anim-rise" style="--d:0ms">{dict.heroEyebrow}</p>
      <h1 class="font-semibold tracking-tight mt-2 anim-rise" style="--d:60ms;font-size:clamp(32px,6vw,52px);line-height:1.05;letter-spacing:-0.03em">{dict.heroH1}</h1>
      <p class="mt-3 text-[16px] leading-6 anim-rise" style="--d:120ms;color:var(--muted);max-width:56ch">{dict.heroSub}</p>
      <div class="mt-4 flex flex-wrap gap-2 anim-rise" style="--d:180ms">
        <a href="#measure" class="btn-primary focus-ring">{dict.startMeasuring}</a>
        <a href="/accuracy/" class="btn-secondary focus-ring">{dict.howAccuracy}</a>
      </div>
    </div>
  </div>

  <div class="container-x pb-4" style="max-width:1120px">
    <MeterPanel dict={dict} />
  </div>

  <div class="container-x py-8 grid gap-4" style="max-width:1120px">
    <section class="panel p-6" data-reveal aria-labelledby="steps">
      <h2 id="steps" class="text-xl font-semibold tracking-tight">{dict.stepsTitle}</h2>
      <ol class="mt-4 grid gap-4 md:grid-cols-3">
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">01</p><h3 class="font-semibold mt-1">{dict.step1t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step1d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">02</p><h3 class="font-semibold mt-1">{dict.step2t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step2d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">03</p><h3 class="font-semibold mt-1">{dict.step3t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step3d}</p></li>
      </ol>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="acc">
      <h2 id="acc" class="text-xl font-semibold tracking-tight">{dict.accTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.accBody}</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="trouble">
      <h2 id="trouble" class="text-xl font-semibold tracking-tight">{dict.troubleTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.troubleBody}</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="sess">
      <h2 id="sess" class="text-xl font-semibold tracking-tight">{dict.sessionTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.sessionBody}</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-semibold tracking-tight">{dict.faqTitle}</h2>
      <div class="mt-3 grid gap-2">
        {dict.faq.map((f) => (
          <details class="panel-raised px-4" style="border-radius:10px">
            <summary class="cursor-pointer focus-ring font-medium text-[15px]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4" style="color:var(--muted)">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
