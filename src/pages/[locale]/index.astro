---
import Layout from '../../components/Layout.astro';
import MeterPanel from '../../components/MeterPanel.astro';
import ChecklistPanel from '../../components/ChecklistPanel.astro';
import ExposurePanel from '../../components/ExposurePanel.astro';
import SpectrumPanel from '../../components/SpectrumPanel.astro';
import ComparePanel from '../../components/ComparePanel.astro';
import ReportPanel from '../../components/ReportPanel.astro';
import SoundLevelGuide from '../../components/SoundLevelGuide.astro';
import { getDict, type Locale } from '../../i18n/dictionaries';
import { SITE, webAppJsonLd, faqJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return (['de', 'it', 'ja', 'es', 'fr', 'pt', 'ko'] as Locale[]).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
const prefix = `/${locale}`;

const COPY: Record<Locale, { intro: string; howT: string; howB: string; calT: string; calB: string; accT: string; guides: { t: string; d: string; href: string }[] }> = {
  de: {
    intro: 'Messen Sie sofort einen geschätzten Schallpegel in dBA – kostenlos, ohne App und ohne Download. Kalibrieren Sie mit einer bekannten Referenz für eine bessere gerätespezifische Genauigkeit.',
    howT: 'Wie der Dezibelmesser funktioniert',
    howB: 'Das Mikrofon wird über die Web Audio API ausgelesen: RMS pro Block, Umrechnung in dB, A-, C- oder Z-Bewertung, Fast/Slow-Glättung und Leq-Mittelung. Unkalibriert nutzt die Anzeige einen nominalen +100-dB-Offset; ein gespeichertes Profil ersetzt ihn durch Ihren Referenzwert.',
    calT: 'Kalibrierung für Dezibel-Schätzwerte',
    calB: 'Jedes Mikrofon verstärkt anders – daher ist eine Kalibrierung vor jedem dBA-Wert nötig. Vergleichen Sie mit einer stabilen Referenz, tragen Sie die Differenz als Offset ein und behalten Sie Mikrofon, Position und Einstellungen bei.',
    accT: 'Genauigkeit im Browser',
    guides: [
      { t: 'Schallpegelmesser Online', d: 'Schallpegel in dBA messen & Geräteklassen verstehen.', href: '/de/schallpegelmesser/' },
      { t: 'Lärm messen mit dem Handy', d: 'Lärmpegel und Nachbarschaftslärm kostenlos ermitteln.', href: '/de/laerm-messen/' },
      { t: 'Online Ton-Generator', d: 'Sinustöne & Frequenzen für Lautsprechertests erzeugen.', href: '/de/ton-generator/' },
      { t: 'Handy: Dezibel messen', d: 'Kostenlos online ohne App – iPhone & Android.', href: '/de/handy-dezibel-messen/' },
      { t: 'Kalibrierung', d: 'Mikrofon mit Referenz abgleichen.', href: '/de/kalibrierung/' },
      { t: 'Dezibel-Tabelle', d: 'Typische Alltagspegel im Vergleich.', href: '/de/dezibel-tabelle/' },
    ],
  },
  it: {
    intro: 'Misura subito un livello sonoro stimato in dBA – gratis, senza app e senza download. Calibra con un riferimento noto per una migliore precisione del dispositivo.',
    howT: 'Come funziona il fonometro online',
    howB: 'Il microfono viene letto tramite Web Audio API: RMS per blocco, conversione in dB, ponderazione A, C o Z, smoothing Fast/Slow e media Leq. Senza calibrazione usa un offset nominale di +100 dB; un profilo salvato lo sostituisce con il riferimento del dispositivo.',
    calT: 'Calibrazione per la misura dei decibel',
    calB: 'Ogni microfono ha un guadagno diverso: la calibrazione è necessaria prima di fidarsi di un valore in dBA. Confronta con un riferimento stabile, inserisci la differenza come offset e mantieni microfono, posizione e impostazioni.',
    accT: 'Precisione nel browser',
    guides: [
      { t: 'Calibrazione', d: 'Allinea il microfono a un riferimento.', href: '/it/#cal' },
      { t: 'Precisione', d: 'Cosa possono dire le stime browser.', href: '/it/#acc' },
      { t: 'Guida alla misurazione', d: 'Passaggi, impostazioni e limiti.', href: '/it/#steps' },
    ],
  },
  ja: {
    intro: '推定dBAを今すぐ測定 — 無料・ダウンロード不要。既知の基準器で校正すると端末ごとの精度が向上します。',
    howT: 'オンラインデシベル測定の仕組み',
    howB: 'Web Audio APIでマイクを読み取り、RMS→dB変換、A・C・Z重み付け、Fast/Slow平滑化、Leq平均を行います。未校正では公称+100 dBオフセットを使い、保存した校正プロファイルが端末固有の基準値に置き換えます。',
    calT: 'デシベル推定のための校正',
    calB: 'マイクの感度は機器ごとに異なるため、dBA値を読む前に校正が必要です。安定した基準音と比較し、差分をオフセットとして入力し、マイク・位置・設定を固定してください。',
    accT: 'ブラウザ測定の精度',
    guides: [
      { t: 'デシベル 測定の基礎', d: 'dB SPL・dBAの意味と、ブラウザで測る手順。', href: '/ja/decibel-measurement/' },
      { t: '音量測定 オンライン', d: 'ブラウザでPCやスマホの音量をリアルタイム計測。', href: '/ja/onryo-sokutei/' },
      { t: 'dB測定・デシベル計測', d: 'デシベル計測と音圧レベルの確認手順。', href: '/ja/db-sokutei/' },
      { t: '騒音測定 オンライン', d: 'スマホで生活音・近隣騒音を測定・ログ保存。', href: '/ja/souon-sokutei/' },
      { t: '騒音計アプリ・デシベル計測', d: 'スマホで無料測定 — iPhone・Android対応。', href: '/ja/noise-meter-app/' },
      { t: '校正', d: '基準器に合わせてデシベル推定値を調整する。', href: '/ja/calibration/' },
      { t: '測定精度', d: 'ブラウザと端末マイクによる推定値の限界を知る。', href: '/ja/accuracy/' },
      { t: 'デシベル比較表', d: '日常の音の大きさをdBAの目安で比較する。', href: '/ja/decibel-chart/' },
    ],
  },
  es: {
    intro: 'Mide de inmediato un nivel sonoro estimado en dBA – gratis, sin app y sin descargas. Calibra con una referencia conocida para mejorar la precisión del dispositivo.',
    howT: 'Cómo funciona el sonómetro online',
    howB: 'El micrófono se lee con Web Audio API: RMS por bloque, conversión a dB, ponderación A, C o Z, suavizado Fast/Slow y promedio Leq. Sin calibrar usa un desplazamiento nominal de +100 dB; un perfil guardado lo sustituye por la referencia del dispositivo.',
    calT: 'Calibración para medir decibelios',
    calB: 'Cada micrófono tiene distinta ganancia: calibrar es imprescindible antes de confiar en un valor dBA. Compara con una referencia estable, introduce la diferencia como offset y mantén micrófono, posición y ajustes.',
    accT: 'Precisión en el navegador',
    guides: [
      { t: 'Calibración', d: 'Ajusta el micrófono a una referencia.', href: '/es/#cal' },
      { t: 'Precisión', d: 'Qué pueden decir las estimaciones.', href: '/es/#acc' },
      { t: 'Guía de medición', d: 'Pasos, ajustes y límites.', href: '/es/#steps' },
    ],
  },
  fr: {
    intro: 'Mesurez immédiatement un niveau sonore estimé en dBA – gratuitement, sans application. Calibrez avec une référence connue pour améliorer la précision de l’appareil.',
    howT: 'Comment fonctionne le sonomètre en ligne',
    howB: 'Le microphone est lu via Web Audio API : RMS par bloc, conversion en dB, pondération A, C ou Z, lissage Fast/Slow et moyenne Leq. Sans calibrage, un décalage nominal de +100 dB est utilisé ; un profil enregistré le remplace par la référence de l’appareil.',
    calT: 'Calibrage pour mesurer les décibels',
    calB: 'Chaque microphone a un gain différent : le calibrage est indispensable avant de croire une valeur dBA. Comparez avec une référence stable, saisissez l’écart comme offset et gardez micro, position et réglages.',
    accT: 'Précision dans le navigateur',
    guides: [
      { t: 'Calibrage', d: 'Ajuster le micro à une référence.', href: '/fr/#cal' },
      { t: 'Précision', d: 'Ce que valent les estimations.', href: '/fr/#acc' },
      { t: 'Guide de mesure', d: 'Étapes, réglages et limites.', href: '/fr/#steps' },
    ],
  },
  pt: {
    intro: 'Meça imediatamente um nível sonoro estimado em dBA – grátis, sem app e sem download. Calibre com uma referência conhecida para melhorar a precisão do dispositivo.',
    howT: 'Como funciona o medidor online',
    howB: 'O microfone é lido via Web Audio API: RMS por bloco, conversão em dB, ponderação A, C ou Z, suavização Fast/Slow e média Leq. Sem calibração usa um offset nominal de +100 dB; um perfil guardado substitui-o pela referência do dispositivo.',
    calT: 'Calibração para medir decibéis',
    calB: 'Cada microfone tem ganho diferente: calibrar é essencial antes de confiar num valor dBA. Compare com uma referência estável, introduza a diferença como offset e mantenha microfone, posição e ajustes.',
    accT: 'Precisão no navegador',
    guides: [
      { t: 'Calibração', d: 'Ajustar o microfone a uma referência.', href: '/pt/#cal' },
      { t: 'Precisão', d: 'O que valem as estimativas.', href: '/pt/#acc' },
      { t: 'Guia de medição', d: 'Passos, ajustes e limites.', href: '/pt/#steps' },
    ],
  },
  ko: {
    intro: '추정 dBA를 즉시 측정 — 무료·다운로드 불필요. 알려진 기준기로 교정하면 기기별 정확도가 향상됩니다.',
    howT: '온라인 데시벨 측정기 원리',
    howB: 'Web Audio API로 마이크를 읽어 RMS→dB 변환, A·C·Z 가중, Fast/Slow 평활화, Leq 평균을 계산합니다. 미교정 상태에서는 공칭 +100 dB 오프셋을 사용하고, 저장된 교정 프로파일이 기기 기준값으로 대체합니다.',
    calT: '데시벨 추정을 위한 교정',
    calB: '마이크 감도는 기기마다 다르므로 dBA 값을 읽기 전 교정이 필수입니다. 안정적인 기준음과 비교해 차이를 오프셋으로 입력하고, 마이크·위치·설정을 고정하세요.',
    accT: '브라우저 측정의 정확도',
    guides: [
      { t: '교정', d: '기준기에 맞추기.', href: '/ko/#cal' },
      { t: '정확도', d: '브라우저 추정치의 한계.', href: '/ko/#acc' },
      { t: '측정 안내', d: '단계, 설정 및 제한.', href: '/ko/#steps' },
    ],
  },
  en: { intro: '', howT: '', howB: '', calT: '', calB: '', accT: '', guides: [] },
};

const copy = COPY[locale] ?? COPY.de;
const accuracyHref = locale === 'de' ? '/de/genauigkeit/' : locale === 'ja' ? '/ja/accuracy/' : `/${locale}/#acc`;
// Locales without dedicated guide subpages link out to the English guide hub
// so link equity flows into the guide cluster instead of dead-end anchors.
const guidesMoreLabel: Record<string, string> = {
  it: 'Leggi le guide complete in inglese →',
  es: 'Leer las guías completas en inglés →',
  fr: 'Lire les guides complets en anglais →',
  pt: 'Ler os guias completos em inglês →',
  ko: '영어 전체 가이드 읽기 →',
};
const hasGuideSubpages = locale === 'de' || locale === 'ja';
const langName: Record<string, string> = { de: 'de', it: 'it', ja: 'ja', es: 'es', fr: 'fr', pt: 'pt', ko: 'ko' };
const jsonLd = [
  webAppJsonLd({
    name: dict.heroH1,
    url: `${SITE}${prefix}/`,
    description: dict.metaDescription,
    inLanguage: langName[locale] ?? locale,
  }),
  faqJsonLd(dict.faq),
  breadcrumbJsonLd([{ name: dict.heroH1, url: `${SITE}${prefix}/` }]),
];
---

<Layout locale={locale} dict={dict} title={dict.metaTitle} description={dict.metaDescription} path={`${prefix}/`} jsonLd={jsonLd}>
  <div class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <svg class="hero-wave" viewBox="0 0 1120 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 55 C80 55 92 31 156 31 S248 74 316 56 402 36 468 53 552 78 620 48 704 25 782 55 862 72 930 45 1008 52 1086 63 1120 48 1120 48" />
    </svg>
    <div class="container-x hero-copy">
      <!-- Linear Release Announcement Pill -->
      <a href="#measure" class="hero-pill anim-rise" style="--d:20ms">
        <span class="w-2 h-2 rounded-full bg-[#5e6ad2] animate-pulse"></span>
        <span class="font-mono text-[11px] text-[#828fff] tracking-wider uppercase font-semibold">Linear Acoustics</span>
        <span class="text-[#8a8f98]">·</span>
        <span>{dict.heroEyebrow}</span>
        <span class="text-[#828fff] ml-0.5">→</span>
      </a>

      <h1 class="hero-title mt-2 anim-rise" style="--d:80ms">
        <span>{dict.heroH1}</span>
      </h1>
      <p class="hero-sub anim-rise" style="--d:170ms">
        {copy.intro || dict.heroSub}
      </p>
      <div class="hero-actions anim-rise" style="--d:230ms">
        <a href="#measure" class="btn-primary focus-ring grad-edge px-6 py-3.5 text-[15px] shadow-[0_0_32px_-4px_rgba(94,106,210,0.65)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>{dict.startMeasuring}</span>
        </a>
        <a href={accuracyHref} class="btn-secondary focus-ring px-5 py-3.5 text-[15px]">
          <span>{dict.howAccuracy}</span>
          <span class="font-mono text-[11px] px-1.5 py-0.5 rounded bg-[#141516] border border-[#23252a] text-[#8a8f98]">DSP</span>
        </a>
      </div>
      <ul class="trust-row anim-rise" style="--d:290ms" aria-label="Privacy and compatibility">
        <li>Audio processed locally</li>
        <li>48 kHz Web Audio API</li>
        <li>No account required</li>
        <li>Zero audio upload</li>
      </ul>
    </div>
  </div>

  <div class="container-x pb-4" style="max-width:1120px">
    <MeterPanel dict={dict} locale={locale} />
    <ChecklistPanel locale={locale} />
    <ExposurePanel locale={locale} />
    <SpectrumPanel locale={locale} />
    <ComparePanel locale={locale} />
    <ReportPanel locale={locale} />
    <SoundLevelGuide locale={locale} />
  </div>

  <!-- Linear Bento Grid: Engineering Specification & Acoustic Standards -->
  <div class="container-x py-12" style="max-width:1120px">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <section class="panel p-6 lg:col-span-2 relative overflow-hidden" data-reveal aria-labelledby="how">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#5e6ad2]"></span>
          <span>Signal Pipeline</span>
        </div>
        <h2 id="how" class="text-xl font-semibold tracking-tight text-white">{copy.howT}</h2>
        <p class="text-[15px] leading-7 mt-2 text-[#d0d6e0]">{copy.howB}</p>
        <div class="mt-4 pt-4 border-t border-[#23252a] flex flex-wrap items-center gap-2 text-xs font-mono text-[#8a8f98]">
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">Mic PCM</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">48 kHz RMS</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a] text-[#828fff]">A/C/Z Filter</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">Fast/Slow (125ms)</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a] text-[#27a644]">Leq Averaging</span>
        </div>
      </section>

      <section class="panel p-6 relative overflow-hidden" data-reveal aria-labelledby="cal">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#828fff]"></span>
          <span>Calibration</span>
        </div>
        <h2 id="cal" class="text-xl font-semibold tracking-tight text-white">{copy.calT}</h2>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">{copy.calB}</p>
      </section>

      <section class="panel p-6 lg:col-span-3 relative overflow-hidden" data-reveal aria-labelledby="acc">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#5e6ad2]"></span>
          <span>Acoustic Standards</span>
        </div>
        <h2 id="acc" class="text-xl font-semibold tracking-tight text-white">{copy.accT}</h2>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">{dict.accBody}</p>
      </section>
    </div>

    <!-- Quick Start Steps -->
    <section class="panel p-6 mt-4" data-reveal aria-labelledby="steps">
      <p class="eyebrow">QUICK START</p>
      <h2 id="steps" class="text-xl font-semibold tracking-tight text-white mt-1">{dict.stepsTitle}</h2>
      <ol class="mt-4 grid gap-3 md:grid-cols-3">
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">01 / PERMISSION</p>
          <h3 class="font-semibold text-white mt-1.5">{dict.step1t}</h3>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step1d}</p>
        </li>
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">02 / LIVE METRICS</p>
          <h3 class="font-semibold text-white mt-1.5">{dict.step2t}</h3>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step2d}</p>
        </li>
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">03 / CALIBRATE</p>
          <h3 class="font-semibold text-white mt-1.5">{dict.step3t}</h3>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step3d}</p>
        </li>
      </ol>
    </section>

    <!-- FAQ -->
    <section class="panel p-6 mt-4" data-reveal aria-labelledby="faq">
      <p class="eyebrow">QUESTIONS & ANSWERS</p>
      <h2 id="faq" class="text-xl font-semibold tracking-tight text-white mt-1">{dict.faqTitle}</h2>
      <div class="mt-3 grid gap-2">
        {dict.faq.map((f) => (
          <details class="panel-raised px-4 py-1 border border-[#23252a] rounded-lg hover:border-[#34343a] transition-all">
            <summary class="cursor-pointer focus-ring font-medium text-[15px] text-[#f7f8f8]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4 text-[#8a8f98] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Guides -->
    <section data-reveal aria-labelledby="guides" class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="eyebrow">KNOWLEDGE BASE</p>
          <h2 id="guides" class="text-2xl font-semibold tracking-tight text-white mt-1">{dict.guidesTitle}</h2>
        </div>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {copy.guides.map((g, i) => (
          <a href={g.href} class="panel lift p-5 focus-ring block group relative overflow-hidden border border-[#23252a] bg-[#0f1011] hover:border-[#5e6ad2]/50 hover:bg-[#141516] transition-all">
            <div class="flex items-center justify-between text-xs font-mono text-[#8a8f98] mb-2.5">
              <span>0{i + 1 < 10 ? `0${i+1}` : i + 1}</span>
              <span class="text-[#828fff] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">→</span>
            </div>
            <h3 class="font-semibold text-[15px] text-[#f7f8f8] group-hover:text-white transition-colors">{g.t}</h3>
            <p class="text-sm mt-1.5 text-[#8a8f98] line-clamp-2 leading-relaxed">{g.d}</p>
          </a>
        ))}
      </div>
      {!hasGuideSubpages && guidesMoreLabel[locale] && (
        <p class="mt-4 text-sm text-[#8a8f98]">
          <a class="underline underline-offset-4 focus-ring text-[#828fff]" href="/guides/" hreflang="en">{guidesMoreLabel[locale]}</a>
        </p>
      )}
    </section>
  </div>
</Layout>
