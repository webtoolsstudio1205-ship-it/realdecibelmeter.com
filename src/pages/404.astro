---
import Layout from '../components/Layout.astro';
import { getDict } from '../i18n/dictionaries';
const dict = getDict('en');
---

<Layout locale="en" dict={dict} title="Page not found — Real Decibel Meter" description="The page you requested does not exist." path="/404/">
  <div class="container-x py-24 text-center" style="max-width:1120px">
    <p class="eyebrow">404</p>
    <h1 class="font-semibold tracking-tight mt-2" style="font-size:clamp(28px,5vw,44px)">Page not found</h1>
    <p class="mt-3 text-[15px]" style="color:var(--muted)">The page moved or never existed. The meter is still here.</p>
    <div class="mt-6 flex justify-center gap-2 flex-wrap">
      <a href="/" class="btn-primary focus-ring">Back to the meter</a>
      <a href="/how-to-use/" class="btn-secondary focus-ring">How to use</a>
    </div>
  </div>
</Layout>
