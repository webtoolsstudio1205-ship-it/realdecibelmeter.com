---
import Layout from '../../components/Layout.astro';
import Article from '../../components/Article.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, guideHreflang, type GuideKey } from '../../lib/seo';

interface PortugueseGuide {
  slug: string; key: GuideKey; title: string; description: string; intro: string; label: string; body: string; article?: boolean;
}

const pages: PortugueseGuide[] = [
  {
    slug: 'guias', key: 'guides', title: 'Guias do medidor de decibéis online',
    description: 'Guias em português sobre medição de som no navegador: como usar, calibração, precisão, tabela de decibéis, dB e dBA e problemas de microfone.',
    intro: 'Escolha o guia conforme a sua tarefa. Sem calibração, o navegador mostra uma estimativa nominal claramente marcada; com uma referência confiável, você melhora a precisão no seu aparelho.', label: 'Guias',
    body: `<h2>Começar a medir</h2><ul><li><a href="/pt/como-usar/">Como usar o medidor</a> — permissão do microfone, posição do aparelho, leitura do painel e exportação da sessão em 30 a 60 segundos.</li><li><a href="/pt/decibelimetro-celular/">Decibelímetro para celular</a> — meça grátis no iPhone ou Android, sem instalar aplicativo, direto no navegador.</li><li><a href="/pt/microfone-nao-funciona/">Microfone não funciona</a> — permissão, dispositivo de entrada, HTTPS e outros programas que prendem o microfone.</li></ul><h2>Entender os números</h2><ul><li><a href="/pt/metodologia/">Como a medição funciona</a> — Web Audio API, RMS, dBFS, ponderação A, C e Z e média Leq, tudo local no seu aparelho.</li><li><a href="/pt/calibracao/">Como calibrar o medidor</a> — compare com uma referência no mesmo local e salve um ajuste específico do seu aparelho.</li><li><a href="/pt/precisao/">Precisão e limites</a> — por que dois celulares mostram valores diferentes e quando você precisa de hardware de Classe 1 ou Classe 2.</li><li><a href="/pt/tabela-decibeis/">Tabela de decibéis</a> — valores típicos de 30 a 120 dBA para situar a sua medição do dia a dia.</li><li><a href="/pt/db-vs-dba/">dB ou dBA</a> — ponderações A, C e Z e respostas Fast e Slow em linguagem simples.</li></ul><h2>O que significa “estimativa”</h2><p>Sem calibrar, você vê o nível digital ponderado (dBFS) somado a um deslocamento nominal de +100 dB, sempre sinalizado como estimativa. Ela serve para comparar ambientes — quarto, escritório, rua — e acompanhar mudanças ao longo do tempo. Não vale como laudo para trabalho, saúde ou disputa legal: decisões formais exigem aparelho calibrado de Classe 1 ou Classe 2 e procedimento adequado.</p><h2>Privacidade e ajuda</h2><ul><li><a href="/pt/privacidade/">Privacidade do microfone e cookies</a> — áudio processado no aparelho sem envio, e como funcionam Analytics e anúncios.</li></ul><p>Dúvidas curtas? Veja também as <a href="/faq/">perguntas frequentes</a>.</p><p><a href="/pt/#measure">Medir o som agora →</a></p>`,
  },
  {
    slug: 'como-usar', key: 'how-to-use', title: 'Como usar o medidor de decibéis online',
    description: 'Passo a passo em português: permita o microfone, posicione o aparelho, leia dBA atual, mínimo, Leq e máximo e exporte a sessão em CSV ou JSON.',
    intro: 'Três etapas: permita o microfone, observe o painel ao vivo e ajuste a sessão antes de exportar. Nada é instalado e nada sai do seu aparelho.', label: 'Como usar', article: true,
    body: `<h2>1. Permita o microfone</h2><p>Toque em Iniciar no <a href="/pt/#measure">painel de medição</a> e aceite o pedido do navegador. A permissão é solicitada uma vez por origem e exige HTTPS; origens em HTTP simples ou arquivos locais podem bloquear a captura. Se você tem mais de um microfone, escolha o correto no seletor de entrada antes de começar. Se nada acontecer ao tocar em Iniciar, siga o guia <a href="/pt/microfone-nao-funciona/">microfone não funciona</a>.</p><h2>2. Posicione o aparelho e leia o painel</h2><p>Apoie o celular ou notebook em uma superfície firme, na altura dos ouvidos, longe de vento, saídas de ar e do manuseio com as mãos. Deixe a abertura do microfone sempre livre e anote a distância até a fonte. O painel mostra o valor atual suavizado, além de mínimo, Leq (média de energia), máximo e duração da sessão, com gráfico das últimas 240 leituras. Aguarde alguns segundos até a resposta Fast ou Slow estabilizar e leia o Leq de 30 a 60 segundos em vez de picos isolados. Para aproximar o número do ambiente real, faça a <a href="/pt/calibracao/">calibração com referência</a> no mesmo local.</p><h2>3. Ajuste, compare e exporte</h2><p>Use a ponderação A para sons do cotidiano e entenda as opções em <a href="/pt/db-vs-dba/">dB ou dBA</a>; depois situe o resultado na <a href="/pt/tabela-decibeis/">tabela de decibéis</a>. Até 20 sessões recentes ficam salvas somente neste navegador — nada é enviado a servidores (veja <a href="/pt/privacidade/">privacidade</a>). A exportação em CSV ou JSON traz valores em dB apenas de sessões calibradas; sessões sem calibração exportam sem valores em dB, para ninguém confundir uma estimativa com registro ambiental.</p><h2>Sessão limpa em quatro passos</h2><ol><li>Aparelho firme na altura dos ouvidos, microfone destampado, a um metro de teclados e ventiladores.</li><li>Toque em Iniciar, conceda a permissão e deixe a resposta Fast (125 ms) ou Slow (1 s) assentar por cinco segundos.</li><li>Fique parado e em silêncio por 30 a 60 segundos enquanto atual, mínimo, Leq, máximo e duração acumulam no painel.</li><li>Repita uma segunda passada do mesmo jeito antes de comparar: dois Leq de 45 segundos valem mais que dez olhadas no número ao vivo.</li></ol><h2>Se a leitura parecer travada</h2><ul><li><strong>Travessões (“--”).</strong> Significam ausência de amostras, nunca zero simulado. Selecione a entrada certa, feche chamadas e abas de gravação e toque em Iniciar de novo.</li><li><strong>Linha baixa demais.</strong> Confira microfone tampado, entrada errada ou capinha abafando a abertura. Teste outra vez sem a capa, com o aparelho sobre a mesa.</li><li><strong>Saltos bruscos.</strong> Manuseio, vento e batidas dominam cápsulas pequenas. Apoie o aparelho, afaste-se e calcule a média de um minuto inteiro.</li></ul><p><a href="/pt/#measure">Abrir o medidor →</a> · <a href="/pt/metodologia/">Como a medição funciona →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'metodologia', key: 'methodology', title: 'Como o navegador mede o som: método explicado',
    description: 'Do microfone ao número na tela: getUserMedia, Web Audio API, RMS, dBFS, ponderação A/C/Z, Fast/Slow e Leq — todo o processamento local.',
    intro: 'Cada número exibido nasce do mesmo pipeline: captura local, blocos de áudio, RMS, dBFS e ponderação. Nenhum componente calcula níveis por conta própria.', label: 'Metodologia', article: true,
    body: `<h2>Entrada do microfone</h2><p>Ao tocar em Iniciar, o navegador chama getUserMedia e abre o fluxo do microfone que você autorizou. O pedido inclui entrada mono e solicita cancelamento de eco, supressão de ruído e ganho automático desligados; o navegador ou o sistema podem recusar parte do pedido, e o medidor mostra o estado real do processamento em vez de esconder. A captura roda em contexto seguro, via HTTPS, e a entrada nunca é ligada aos alto-falantes. A permissão é pedida uma vez por origem e pode ser revogada quando você quiser nas configurações do site.</p><h2>RMS, dBFS e a estimativa imediata</h2><p>As amostras seguem para um worklet de áudio que acumula blocos contínuos e soma quadrados, pico e sinalização de corte. Cada bloco vira um valor RMS, convertido para decibéis digitais relativos ao fundo de escala (dBFS). O dBFS é negativo por definição: 0 é o sinal mais alto representável e o silêncio fica perto de −100. Sem calibração, o medidor soma um deslocamento nominal de +100 dB ao nível digital ponderado — por exemplo, −41,5 dBFS aparece como estimativa claramente marcada de 58,5 dBA. O dBFS bruto continua visível no diagnóstico digital.</p><h2>Ponderação e resposta</h2><p>As correções A, C e Z aproximam ponderações de frequência padrão a partir da banda dominante do sinal. A atenua graves e agudos extremos, como pede a comparação de sons cotidianos; C é mais plana e serve a batidas fortes; Z fica quase plana para comparação diagnóstica. A resposta Fast (125 ms) acompanha sílabas e picos curtos, enquanto a Slow (1 s) desenha uma linha mais estável da mesma passagem. Nenhuma das duas muda a estimativa de base — só a velocidade com que a tela a acompanha. Detalhes em <a href="/pt/db-vs-dba/">dB ou dBA</a>.</p><h2>Estatísticas da sessão</h2><p>Cada medição acumula valor atual, mínimo, Leq de energia, máximo e duração, e o gráfico guarda as últimas 240 leituras — uma passada de 4 minutos em Slow desenha o panorama completo. A entrada ociosa mostra “--” em vez de inventar um número baixo. Ao parar, até 20 sessões ficam guardadas só no navegador, sem conta e sem envio. A exportação em CSV ou JSON leva valores em dB apenas quando há calibração compatível ativa; sessões sem calibração exportam sem valores em dB. Veja <a href="/pt/calibracao/">como calibrar</a> e <a href="/pt/privacidade/">privacidade do microfone</a>.</p><p><a href="/pt/#measure">Abrir o medidor →</a> · <a href="/pt/precisao/">Precisão e limites →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'calibracao', key: 'calibration', title: 'Como calibrar o medidor de decibéis online',
    description: 'Calibre o medidor online com um aparelho de referência: ajuste específico do dispositivo, mesma posição, mesma ponderação e quando refazer.',
    intro: 'Calibrar aqui significa comparar navegador e referência no mesmo local e salvar a diferença como um ajuste fixo. Isso aproxima o nível geral, sem transformar o navegador em instrumento certificado.', label: 'Calibração', article: true,
    body: `<h2>Por que calibrar</h2><p>Microfones de celular e notebook nascem para voz, com sensibilidade e ganho interno diferentes em cada modelo. Sem comparar com uma referência, o número exibido descreve a força da entrada — nível digital ponderado mais deslocamento nominal de +100 dB — e não a pressão sonora do ambiente. O ajuste de calibração troca esse valor nominal pelo deslocamento medido no seu aparelho, na sua posição e com as suas configurações. A partir daí, o medidor exibe a estimativa em dBA, dBC ou dBZ sobre uma escala visual de 20 a 120 dB.</p><h2>O que você precisa</h2><ul><li>Um sonômetro confiável já calibrado ou um calibrador acústico de nível conhecido e estável.</li><li>O mesmo aparelho, o mesmo microfone, o mesmo navegador e a mesma posição que você vai usar depois.</li><li>A mesma ponderação de frequência (A, C ou Z) e a mesma resposta de tempo (Fast de 125 ms ou Slow de 1 s) nos dois lados.</li></ul><h2>Calibração em quatro passos</h2><ol><li>Coloque o aparelho de referência e o seu dispositivo lado a lado, no mesmo ponto, com as aberturas dos microfones livres.</li><li>Use um som de referência o mais estável possível e espere as duas leituras assentarem.</li><li>No diálogo de medição, capture a média digital e digite o nível conhecido da referência para gerar o ajuste.</li><li>Salve o perfil, confira a exibição calibrada e valide outra vez contra a mesma referência.</li></ol><h2>Quando o perfil deixa de valer</h2><p>Qualquer troca de microfone, fone com microfone, navegador, ganho de entrada, ponderação, resposta ou posição do aparelho exige nova verificação. Um ajuste medido em outro celular não pode ser reaproveitado, porque sensibilidade e processamento mudam de um modelo para outro. Entenda os limites em <a href="/pt/precisao/">precisão e limites</a> e as ponderações em <a href="/pt/db-vs-dba/">dB ou dBA</a>.</p><p><a href="/pt/#measure">Abrir o medidor →</a> · <a href="/pt/precisao/">Precisão e limites →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'precisao', key: 'accuracy', title: 'Qual é a precisão do medidor de decibéis online?',
    description: 'Precisão do decibelímetro no navegador: hardware, ganho automático, resposta de frequência, limites de 30 e 100 dBA e quando usar Classe 1 ou 2.',
    intro: 'Microfones de celular e notebook servem para voz, não para metrologia acústica. Os valores ajudam em comparações e triagem, mas sem referência confiável não valem como medição certificada.', label: 'Precisão', article: true,
    body: `<h2>O que o número significa</h2><p>Sem calibrar, a tela mostra a força da entrada do microfone: nível digital ponderado mais deslocamento nominal de +100 dB, sempre sinalizado como estimativa. O mesmo som rende números diferentes em aparelhos diferentes, porque cápsula, pré-amplificador, posição da abertura e ganho interno variam por modelo. Dois celulares lado a lado, no mesmo ruído, costumam divergir de 5 a 10 dB. Trate o valor como ordem de grandeza para comparar ambientes, nunca como laudo.</p><h2>Por que cada aparelho mostra um valor</h2><ul><li><strong>Hardware:</strong> cápsula, circuito, carcaça e posição do microfone mudam a sensibilidade e os graves fracos típicos de cápsulas pequenas.</li><li><strong>Processamento automático:</strong> sistema ou navegador podem aplicar ganho automático, supressão de ruído e cancelamento de eco, e o medidor indica o estado real em vez de fingir controle total.</li><li><strong>Resposta de frequência:</strong> um ajuste único corrige o nível geral, mas não as diferenças de sensibilidade entre graves, médios e agudos.</li><li><strong>Cena e posição:</strong> distância, reflexos das paredes, vento e ruído de manuseio deslocam o resultado em vários dB.</li></ul><h2>Limites que você precisa conhecer</h2><p>Abaixo de cerca de 30 dBA, o ruído próprio do microfone puxa a leitura para cima; perto de 95 a 100 dBA, o sinal corta e a leitura estaciona. Sons graves aparecem mais baixos do que parecem, sobretudo em ponderação A, que desconta os graves. Como referência de exposição, 85 dBA por 8 horas é o marco clássico, com o tempo seguro caindo pela metade a cada 3 dB — mas este medidor serve só para triagem: avaliação de trabalho, saúde auditiva ou disputa exige aparelho calibrado de Classe 1 ou Classe 2 com procedimento adequado.</p><h2>O que a calibração melhora</h2><p>Comparar com uma referência confiável no mesmo local aproxima o nível geral da realidade, seguindo o passo a passo de <a href="/pt/calibracao/">como calibrar</a>. Ela não elimina corte, distorção nem ganho automático variável, e não corrige a resposta de frequência. Refaça o ajuste sempre que mudar microfone, navegador, ponderação, resposta ou posição — e confira o método em <a href="/pt/metodologia/">como a medição funciona</a>.</p><p><a href="/pt/#measure">Medir agora →</a> · <a href="/pt/tabela-decibeis/">Tabela de decibéis →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'tabela-decibeis', key: 'decibel-chart', title: 'Tabela de decibéis: sons do dia a dia',
    description: 'Tabela de 30 a 120 dBA com sons cotidianos: quarto, biblioteca, conversa, trânsito, moto, show e sirene — valores aproximados para situar sua medição.',
    intro: 'Os exemplos abaixo são ordens de grandeza para o dia a dia. Distância, ambiente, duração e ponderação deslocam bastante o valor real.', label: 'Tabela de decibéis', article: true,
    body: `<table><caption class="sr-only">Níveis aproximados do cotidiano em dBA</caption><thead><tr><th>Nível (aprox.)</th><th>Exemplo</th></tr></thead><tbody><tr><td>30 dBA</td><td>Quarto silencioso de madrugada</td></tr><tr><td>40 dBA</td><td>Biblioteca tranquila</td></tr><tr><td>50 dBA</td><td>Escritório calmo, chuva leve</td></tr><tr><td>60 dBA</td><td>Conversa normal</td></tr><tr><td>70 dBA</td><td>Trânsito intenso de perto</td></tr><tr><td>80 dBA</td><td>Restaurante cheio</td></tr><tr><td>90 dBA</td><td>Cortador de grama ou moto</td></tr><tr><td>100 dBA</td><td>Frente do palco em show</td></tr><tr><td>110 dBA</td><td>Ferramentas elétricas barulhentas</td></tr><tr><td>120 dBA</td><td>Sirene de perto</td></tr></tbody></table><h2>Como ler a tabela</h2><p>A escala de decibéis é logarítmica: 10 dB a mais significam cerca de dez vezes mais energia sonora, e 3 dB a mais já dobram a energia. Por isso um salto de 60 para 90 dBA não é “um pouco mais alto” — é um mundo diferente de intensidade. Use a tabela para situar a sua leitura, nunca como veredito sobre segurança auditiva.</p><h2>Compare do jeito certo</h2><p>Meça por 30 a 60 segundos e leia o Leq com ponderação A, a mesma usada na tabela. Sem <a href="/pt/calibracao/">calibração</a>, dois celulares divergem de 5 a 10 dB no mesmo som; com o ajuste do seu aparelho, a comparação fica honesta. Abaixo de 30 dBA o microfone costuma marcar alto demais, e perto de 100 dBA o sinal pode cortar — veja <a href="/pt/precisao/">precisão e limites</a> e <a href="/pt/db-vs-dba/">dB ou dBA</a>. Há também a versão em inglês em <a href="/decibel-chart/">decibel chart</a>.</p><p><a href="/pt/#measure">Medir o som agora →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'db-vs-dba', key: 'db-vs-dba', title: 'dB ou dBA: qual é a diferença?',
    description: 'Diferença entre dB, dBA, dBC e dBZ e quando usar cada ponderação, com respostas Fast de 125 ms e Slow de 1 s na medição online.',
    intro: 'O dB expressa uma razão em escala logarítmica. As letras A, C e Z dizem como cada frequência pesa na conta do nível exibido.', label: 'dB e dBA', article: true,
    body: `<h2>dBFS não é pressão sonora</h2><p>O navegador recebe valores digitais em dBFS, onde 0 é o sinal mais alto representável — não o silêncio. Leituras normais ficam bem abaixo de zero, e um quarto quieto cai para dezenas de negativos. Para chegar perto da pressão sonora do ambiente em dB SPL, você precisa da sensibilidade do microfone e de uma <a href="/pt/calibracao/">calibração com referência</a>: o ajuste troca o deslocamento nominal de +100 dB pelo deslocamento medido no seu aparelho. Sem esse passo, trate tudo como estimativa de entrada, não como nível ambiental.</p><h2>Ponderações A, C e Z</h2><ul><li><strong>dBA:</strong> pesa as frequências de um jeito próximo à audição humana e serve à maioria das comparações cotidianas — conversa, escritório, rua.</li><li><strong>dBC:</strong> é mais plana, deixa os graves pesarem mais e combina com sons fortes, batidas e picos de música ou motores.</li><li><strong>dBZ:</strong> não aplica ponderação de frequência e funciona como leitura plana para diagnóstico e comparação técnica.</li></ul><h2>Fast e Slow</h2><p>A resposta Fast, perto de 125 ms, persegue sílabas e picos curtos; a Slow, perto de 1 s, entrega uma linha estável da mesma passagem. Nenhuma muda a estimativa de base — só a velocidade da tela. Para comparações justas, mantenha ponderação, resposta, posição, distância e perfil de calibração idênticos entre as passadas, com 30 a 60 segundos de Leq em cada uma.</p><h2>Qual escolher na prática</h2><p>Para rotina e vizinhança, fique com dBA e Slow: a leitura estabiliza e conversa com a <a href="/pt/tabela-decibeis/">tabela de decibéis</a>. Para festa, motor ou ensaio com muito grave, compare também em dBC ou dBZ para não subestimar a energia dos graves. Lembre que cápsulas de celular captam pouco grave e que perto de 95 a 100 dBA o sinal pode cortar — detalhes em <a href="/pt/precisao/">precisão e limites</a>.</p><p><a href="/pt/#measure">Abrir o medidor →</a> · <a href="/pt/metodologia/">Como a medição funciona →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'microfone-nao-funciona', key: 'microphone-not-working', title: 'Microfone não funciona? Como resolver no navegador',
    description: 'Medidor sem sinal? Verifique permissão do microfone, dispositivo de entrada, HTTPS, outros aplicativos e o navegador — passo a passo em português.',
    intro: 'Siga os passos na ordem, do mais comum ao mais raro. Enquanto não houver sinal de áudio real, a tela mantém os travessões “--”.', label: 'Microfone', article: true,
    body: `<h2>1. Confira a permissão</h2><p>Abra as permissões do site pelo ícone de cadeado ou de ajustes na barra de endereço. Defina o microfone como permitido, recarregue a página e toque em Iniciar outra vez. A permissão é pedida uma vez por origem: se você negou antes, o navegador continua bloqueando até você reverter. Também dá para revogar o acesso quando quiser pelo mesmo caminho — veja <a href="/pt/privacidade/">privacidade do microfone</a>.</p><h2>2. Escolha a entrada certa</h2><p>Abra as configurações de som do sistema e confirme qual microfone está selecionado como entrada. Depois de conectar microfone USB ou fone com microfone, atualize a lista de dispositivos ou recarregue a página para o navegador enxergar a novidade. Fones Bluetooth costumam trocar de perfil no meio da chamada e derrubar a captura — prefira conexão com fio para sessões de 30 a 60 segundos.</p><h2>3. Feche outros programas</h2><p>Aplicativos de chamada, reunião e gravação podem prender o microfone com exclusividade, e aí o navegador abre silêncio. Encerre esses programas, feche abas de gravação e tente de novo. Em notebook, confira se alguma tecla física ou atalho desativou o microfone.</p><h2>4. Conexão segura e navegador atual</h2><p>O acesso ao microfone exige HTTPS em contexto seguro; HTTP simples e arquivos locais tendem a bloquear. Use versão atual de Chrome, Edge, Firefox ou Safari, e desconfie de janela privativa ou aparelho gerenciado pela empresa ou escola, que podem vetar o microfone por política. Se a leitura seguir zerada, releia <a href="/pt/como-usar/">como usar o medidor</a> e <a href="/pt/precisao/">precisão e limites</a> antes de concluir qualquer coisa.</p><p><a href="/pt/#measure">Tentar medir de novo →</a> · <a href="/pt/calibracao/">Calibração →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'privacidade', key: 'privacy', title: 'Privacidade do microfone e cookies',
    description: 'Áudio do microfone processado no aparelho e nunca enviado. Como funcionam permissão, armazenamento local, Google Analytics e cookies de anúncios.',
    intro: 'Este medidor nasce local: o áudio do microfone é processado no seu navegador e este site nunca o transmite, grava ou compartilha.', label: 'Privacidade', article: true,
    body: `<h2>Permissão do microfone</h2><p>A medição só começa quando você toca em Iniciar e autoriza o microfone no navegador, uma vez por origem. Negar a permissão mostra apenas os travessões “--” de ociosidade — nada é capturado. Você pode revogar o acesso quando quiser nas configurações do site, pelo ícone da barra de endereço. Ao parar, o medidor descarta as trilhas e encerra o contexto de áudio.</p><h2>Processamento do áudio</h2><p>As amostras seguem pela Web Audio API dentro do próprio navegador: o fluxo do microfone nunca é ligado aos alto-falantes, nunca vira arquivo de gravação no servidor e nunca é enviado. O pipeline, as estatísticas da sessão e o histórico vivem no seu aparelho. O método completo está em <a href="/pt/metodologia/">como a medição funciona</a>.</p><h2>O que fica salvo no navegador</h2><p>Preferência de tema, perfis de calibração e até 20 resumos de sessão moram no armazenamento local do navegador, somente. Limpar os dados do site apaga tudo, e o histórico pode ser excluído pela própria tela. A exportação em CSV ou JSON é gerada no navegador e salva por você no seu aparelho — sem gravação de áudio junto.</p><h2>Estatísticas e cookies</h2><p>Para entender o uso do site, usamos o Google Analytics, que pode definir cookies de análise ou receber informações de página, navegador e dispositivo. Ele nunca recebe áudio do microfone nem amostras de medição. Se houver exibição de anúncios, o Google AdSense e seus parceiros podem usar cookies para exibir e medir anúncios, incluindo anúncios personalizados com base nas suas visitas a este e a outros sites. Você pode desativar anúncios personalizados nos <a href="https://www.google.com/settings/ads">Ajustes de anúncios do Google</a> ou recusar publicidade personalizada de terceiros em <a href="https://optout.aboutads.info/">aboutads.info</a>. Áudio do microfone e amostras de medição nunca são usados para publicidade.</p><h2>Hospedagem</h2><p>Os arquivos estáticos trafegam via HTTPS; o provedor de hospedagem pode manter registros de acesso padrão, fora do controle deste aplicativo.</p><p><a href="/pt/#measure">Abrir o medidor →</a> · <a href="/pt/metodologia/">Como a medição funciona →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
  {
    slug: 'decibelimetro-celular', key: 'decibelimetro-celular', title: 'Decibelímetro para celular: meça grátis sem instalar nada',
    description: 'Decibelímetro para celular grátis e online: meça dBA no iPhone ou Android sem aplicativo. Como usar, precisão, calibração e perguntas frequentes.',
    intro: 'Esta página já é o seu decibelímetro grátis: abra no navegador, toque em Iniciar, permita o microfone e leia a estimativa de dBA ao vivo.', label: 'Decibelímetro de celular', article: true,
    body: `<div style="border:1px solid var(--border);border-radius:12px;padding:16px;background:linear-gradient(135deg,rgba(59,130,246,.14),rgba(59,130,246,.03))"><p><strong>Teste agora — 10 segundos, grátis, sem aplicativo:</strong></p><ol><li>Abra esta página no navegador do <strong>celular ou iPhone</strong>.</li><li>Toque em <a href="/pt/#measure">Iniciar medição →</a> e permita o microfone.</li><li>Leia a <strong>estimativa de dBA ao vivo</strong> — use a média de 30 a 60 segundos.</li></ol><p>O áudio fica no seu aparelho. Sem gravação, sem envio.</p></div><h2>O que é um decibelímetro de celular?</h2><p>Decibelímetro, medidor de ruído e sonômetro de bolso são o mesmo instrumento: ele transforma o sinal do microfone em decibéis. Esta página faz isso online e grátis — estimativa em dBA, dBC ou dBZ ao vivo, com mínimo, Leq, máximo e gráfico de 240 leituras. Você não precisa instalar um <strong>aplicativo de decibelímetro</strong> para uma checagem do dia a dia: quarto, escritório, rua, festa.</p><h2>Existe decibelímetro grátis?</h2><p>Sim — este site. Sem loja, sem conta, sem download e sem custo: você mede quantas vezes quiser, exporta CSV ou JSON e consulta o histórico de até 20 sessões salvas só no navegador. Aplicativos nativos só valem a pena para registro offline contínuo ou rotinas de longa duração.</p><h2>No iPhone e no Android</h2><ul><li><strong>iPhone:</strong> abra no Safari, toque em Iniciar e permita o microfone. Calibre uma vez por aparelho contra uma referência em <a href="/pt/calibracao/">calibração</a> para aproximar o nível geral.</li><li><strong>Android:</strong> abra no Chrome. A página solicita cancelamento de eco, supressão de ruído e ganho automático desligados e mostra o estado real do processamento na tela.</li><li><strong>Dica que vale para os dois:</strong> microfone destampado, aparelho na altura dos ouvidos e 30 a 60 segundos de Leq por passada.</li></ul><h2>Como medir o som com o celular</h2><ol><li>Permita o microfone e deixe a abertura livre, sem capa abafando.</li><li>Segure ou apoie o celular na altura dos ouvidos, com o microfone virado para a fonte, e anote a distância.</li><li>Fique em silêncio, espere a leitura assentar e anote o Leq de 30 a 60 segundos.</li><li>Para comparar, mantenha ponderação (A, C ou Z), resposta Fast ou Slow, posição e perfil iguais.</li></ol><h2>Qual é a precisão no celular?</h2><p>Conte com ordem de grandeza em poucos dB: dois modelos no mesmo som divergem de 5 a 10 dB, abaixo de 30 dBA a leitura sai alta, perto de 95 a 100 dBA o sinal corta e os graves saem mais baixos do que parecem. Ignore a casa decimal e compare médias de 30 a 60 segundos. Uma <a href="/pt/calibracao/">calibração</a> no mesmo local melhora o nível geral — detalhes em <a href="/pt/precisao/">precisão e limites</a> e <a href="/pt/tabela-decibeis/">tabela de decibéis</a>. Para trabalho, saúde ou disputa formal, use aparelho calibrado de Classe 1 ou Classe 2.</p><h2>Perguntas frequentes</h2><h3>Dá para medir decibéis com o celular?</h3><p>Sim, para questões do dia a dia. Toque em <a href="/pt/#measure">Iniciar medição →</a> e leia a média de 30 a 60 segundos.</p><h3>Funciona no iPhone e no Android?</h3><p>Sim. Safari no iPhone e Chrome no Android bastam — veja o passo a passo em <a href="/pt/como-usar/">como usar</a>.</p><h3>É mesmo grátis e sem aplicativo?</h3><p>Sim: sem custo, sem conta e sem instalação. O áudio é processado no aparelho — leia <a href="/pt/privacidade/">privacidade</a>.</p><p><a href="/pt/#measure">Medir com o celular →</a> · <a href="/pt/calibracao/">Calibrar →</a> · <a href="/pt/guias/">Todos os guias →</a></p>`,
  },
];

export function getStaticPaths() {
  return ['guias', 'como-usar', 'metodologia', 'calibracao', 'precisao', 'tabela-decibeis', 'db-vs-dba', 'microfone-nao-funciona', 'privacidade', 'decibelimetro-celular']
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown Portuguese guide route: ${slug}`);
const dict = getDict('pt');
const path = `/pt/${page.slug}/`;
const url = `${SITE}${path}`;
const jsonLd = [
  ...(page.article ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'pt', dateModified: '2026-09-24' })] : []),
  breadcrumbJsonLd([{ name: 'Início', url: `${SITE}/pt/` }, { name: page.label, url }]),
];
---

<Layout locale="pt" dict={dict} title={`${page.title} | Real Decibel Meter`} description={page.description} path={path} hreflang={guideHreflang(page.key)} jsonLd={jsonLd} ogType={page.article ? 'article' : 'website'}>
  <Article title={page.title} intro={page.intro} reviewed="2026-09-24" breadcrumb={[{ name: 'Início', href: '/pt/' }, { name: page.label, href: path }]}>
