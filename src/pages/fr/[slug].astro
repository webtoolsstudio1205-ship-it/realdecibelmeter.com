---
import Layout from '../../components/Layout.astro';
import Article from '../../components/Article.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, guideHreflang, type GuideKey } from '../../lib/seo';

interface FrenchGuide {
  slug: string; key: GuideKey; title: string; description: string; intro: string; label: string; body: string; article?: boolean;
}

const pages: FrenchGuide[] = [
  {
    slug: 'guides', key: 'guides', title: 'Guides du sonomètre en ligne',
    description: 'Guides en français sur la mesure du niveau sonore en ligne : mode d’emploi, calibrage, précision, tableau des décibels, dB et dBA, microphone.',
    intro: 'Choisissez le guide adapté à votre besoin. Sans calibrage, le navigateur affiche une estimation nominale clairement signalée ; une comparaison avec une référence améliore le niveau propre à votre appareil.', label: 'Guides',
    body: `<h2>Mesurer et situer un niveau</h2><ul><li><a href="/fr/mode-emploi/">Mode d’emploi du sonomètre</a> — autoriser le microphone, placer l’appareil et lire l’affichage.</li><li><a href="/fr/calibrage/">Calibrer le sonomètre</a> — déterminer un décalage propre à votre appareil avec une référence fiable.</li><li><a href="/fr/precision/">Précision du sonomètre en ligne</a> — matériel, traitement automatique et limites à connaître.</li><li><a href="/fr/tableau-decibels/">Tableau des décibels</a> — des bruits du quotidien comme repères approximatifs.</li></ul><h2>Notions et dépannage</h2><ul><li><a href="/fr/methodologie/">Méthode de mesure du navigateur</a> — du microphone à l’affichage, étape par étape.</li><li><a href="/fr/db-vs-dba/">Différence entre dB et dBA</a> — pondérations A, C et Z expliquées simplement.</li><li><a href="/fr/microphone-ne-fonctionne-pas/">Le microphone ne fonctionne pas</a> — vérifier autorisations, appareil choisi et navigateur.</li></ul><h2>Vie privée et téléphone</h2><ul><li><a href="/fr/confidentialite/">Confidentialité du microphone</a> — traitement local, stockage et cookies.</li><li><a href="/fr/sonometre-telephone/">Sonomètre sur téléphone</a> — mesurer les décibels gratuitement, sans application.</li></ul><p><a href="/fr/#measure">Mesurer le volume en ligne →</a></p>`,
  },
  {
    slug: 'mode-emploi', key: 'how-to-use', title: 'Mode d’emploi du sonomètre en ligne',
    description: 'Utilisez le sonomètre en ligne : autorisation du microphone, placement de l’appareil, lecture des dBA, réglages et export des sessions.',
    intro: 'Aucune installation n’est requise. Autorisez le microphone, stabilisez l’appareil, vérifiez l’affichage choisi, puis moyennez la lecture sur trente à soixante secondes.', label: 'Mode d’emploi', article: true,
    body: `<h2>1. Autoriser le microphone</h2><p>Ouvrez le <a href="/fr/#measure">panneau de mesure</a> et appuyez sur Démarrer, puis acceptez l’accès au microphone dans le navigateur. L’autorisation se donne une fois par origine et la page exige une connexion sécurisée HTTPS. L’entrée utilisée est mono : le navigateur capte un seul canal, ce qui suffit pour comparer des niveaux.</p><h2>2. Stabiliser la mesure</h2><p>Dégagez les orifices du microphone et éloignez l’appareil du vent, des poignées de main et des bouches d’aération. Tenez le téléphone à hauteur d’oreille, microphone tourné vers la source, et notez la distance : à niveau égal, chaque mètre change le résultat. Restez silencieux quelques secondes, puis lisez une moyenne sur trente à soixante secondes plutôt qu’un pic isolé. Tant qu’aucun signal réel n’arrive, l’affichage reste sur « -- ».</p><h2>3. Lire l’affichage</h2><p>Sans calibrage, l’écran montre une estimation obtenue à partir des échantillons numériques, avec un décalage nominal de +100 dB clairement indiqué comme estimation. Vous voyez le niveau instantané, le minimum, le Leq énergétique, le maximum et la durée, ainsi qu’un graphique de 240 points qui retrace l’historique récent. Le détail du calcul figure dans la <a href="/fr/methodologie/">méthode de mesure</a>.</p><h2>4. Régler et conserver</h2><p>Pour comparer des bruits de la vie courante, choisissez la pondération A ; pour les basses et les fortes crêtes, préférez la pondération C ; la pondération Z affiche le signal sans correction. L’export CSV ou JSON devient possible une fois l’appareil calibré, et jusqu’à 20 sessions restent conservées dans votre navigateur, sans aucun envoi. Le sens des lettres A, C et Z est expliqué dans <a href="/fr/db-vs-dba/">dB et dBA</a>.</p><p><a href="/fr/microphone-ne-fonctionne-pas/">Le microphone ne répond pas →</a> · <a href="/fr/calibrage/">Calibrer l’appareil →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
  {
    slug: 'methodologie', key: 'methodology', title: 'Méthode de mesure du son dans le navigateur',
    description: 'Comment le navigateur calcule un niveau sonore : microphone, Web Audio API, RMS, dBFS, pondérations A, C, Z, Leq et calibrage.',
    intro: 'Cette page décrit le trajet d’un son, depuis la capsule du microphone jusqu’au chiffre affiché, afin que vous sachiez ce que la valeur représente vraiment.', label: 'Méthodologie', article: true,
    body: `<h2>Entrée microphone</h2><p>Après votre autorisation, la page récupère les échantillons du microphone grâce à getUserMedia et à la Web Audio API. Elle demande la désactivation de l’annulation d’écho, de la réduction de bruit et du gain automatique, en mono. Cette demande reste toutefois une requête : selon l’appareil et le navigateur, le système peut garder un traitement actif, ce qui modifie le niveau affiché.</p><h2>RMS et dBFS</h2><p>Chaque court bloc audio donne une valeur efficace (RMS), convertie sur une échelle logarithmique dont le maximum numérique vaut 0 dBFS. Sans calibrage, la page ajoute un décalage nominal de +100 dB et présente le résultat comme une estimation pondérée, jamais comme un niveau d’ambiance vérifié.</p><h2>Pondération et réponse temporelle</h2><p>L’analyse fréquentielle applique la pondération dominante choisie : A pour une écoute proche de la perception humaine, C pour inclure davantage de basses, Z sans correction. L’affichage se lisse ensuite en mode Rapide (125 ms), qui suit les variations brèves, ou Lent (1 s), qui stabilise la lecture. La moyenne cumulée n’est pas une moyenne arithmétique simple mais un Leq énergétique.</p><h2>Après calibrage</h2><p>La comparaison avec une référence, au même emplacement, définit un décalage fixe propre à l’appareil, qui s’ajoute aux estimations dBA, dBC et dBZ. Ce décalage ne corrige ni la réponse en fréquence du microphone ni un traitement automatique variable, et il ne transforme pas le navigateur en instrument de mesure dédié. Les décisions formelles exigent un appareil de classe 1 ou 2 entretenu et vérifié.</p><p><a href="/fr/calibrage/">Méthode de calibrage →</a> · <a href="/fr/precision/">Précision et limites →</a> · <a href="/fr/confidentialite/">Confidentialité du microphone →</a></p>`,
  },
  {
    slug: 'calibrage', key: 'calibration', title: 'Calibrer le sonomètre en ligne',
    description: 'Calibrez le sonomètre en ligne avec un appareil de référence : décalage propre à l’appareil, pondérations assorties et vérification.',
    intro: 'Calibrer signifie ici comparer le navigateur et une référence au même endroit, puis mémoriser l’écart comme un décalage fixe. Le niveau global s’en trouve rapproché, sans faire du navigateur un instrument de mesure dédié.', label: 'Calibrage', article: true,
    body: `<h2>Ce qu’il vous faut</h2><ul><li>Un appareil de référence fiable ou un calibreur acoustique de niveau connu, stable pendant la comparaison.</li><li>Le même microphone, le même navigateur et le même emplacement que pour vos mesures futures.</li><li>La même pondération A, C ou Z et la même réponse Rapide ou Lente des deux côtés.</li></ul><h2>Calibrage en quatre étapes</h2><ol><li>Placez l’appareil de référence et votre téléphone côte à côte, orifices de microphone dégagés.</li><li>Diffusez un son de référence aussi stable que possible et attendez que les deux affichages se calment.</li><li>Dans le dialogue de mesure, relevez la moyenne numérique du navigateur et saisissez le niveau connu de la référence.</li><li>Enregistrez le profil, puis contrôlez de nouveau l’affichage face à la même référence.</li></ol><h2>Quand le profil ne vaut plus</h2><p>Si vous changez de microphone, de casque, de traitement du navigateur, de pondération ou de position, vérifiez de nouveau le calibrage. Un décalage mesuré sur un autre téléphone n’est pas transférable. Pour situer vos chiffres, lisez aussi <a href="/fr/precision/">précision et limites</a> ainsi que <a href="/fr/db-vs-dba/">dB et dBA</a>. Les constats restent indicatifs : toute décision formelle demande un appareil de classe 1 ou 2 entretenu et vérifié.</p><p><a href="/fr/#measure">Ouvrir le sonomètre →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
  {
    slug: 'precision', key: 'accuracy', title: 'Précision du sonomètre en ligne : repères honnêtes',
    description: 'Précision des sonomètres dans le navigateur : microphones, gain automatique, réponse en fréquence, calibrage et limites d’usage expliqués.',
    intro: 'Les microphones de téléphones et d’ordinateurs servent d’abord à la voix, pas à la métrologie acoustique. Leurs chiffres aident à comparer des situations, mais ne valent pas un relevé vérifié sans référence fiable.', label: 'Précision', article: true,
    body: `<h2>Pourquoi les appareils affichent des valeurs différentes</h2><ul><li><strong>Matériel :</strong> la capsule, le préamplificateur, le boîtier et l’emplacement de l’orifice varient selon les modèles.</li><li><strong>Traitement automatique :</strong> le système ou le navigateur peut ajuster le gain, atténuer le bruit ou annuler l’écho.</li><li><strong>Réponse en fréquence :</strong> un décalage unique ne corrige pas des écarts qui changent selon les fréquences ; les basses ressortent souvent affaiblies.</li><li><strong>Position :</strong> la distance, les réflexions, le vent et les bruits de manipulation déplacent le résultat.</li></ul><h2>Ordres de grandeur à garder en tête</h2><p>Pour un même son, des modèles courants s’écartent souvent de 5 à 10 dB. Sous 30 dBA environ, l’affichage tend vers le haut à cause du bruit propre du microphone ; vers 95 à 100 dBA, le signal sature et la lecture plafonne. Lisez donc les chiffres au décibel près, jamais à la décimale, et moyennez sur trente à soixante secondes.</p><h2>Ce que le calibrage améliore</h2><p>La comparaison avec une référence fiable, décrite dans le <a href="/fr/calibrage/">guide de calibrage</a>, rapproche le niveau global de la réalité. Elle n’efface ni la saturation, ni les basses affaiblies, ni un gain automatique qui varie avec le niveau. À titre indicatif, une exposition de 85 dBA pendant huit heures marque un seuil courant, et chaque hausse de 3 dB divise environ par deux la durée tolérable.</p><h2>Quand un appareil dédié s’impose</h2><p>Pour la santé auditive, un litige, une décision de protection ou la preuve d’une norme, utilisez un appareil de classe 1 ou 2 entretenu et vérifié, avec la procédure adaptée. Ce sonomètre en ligne ne rend aucun avis médical ni juridique : il sert au dépistage et aux comparaisons relatives.</p><p><a href="/fr/#measure">Lancer une mesure →</a> · <a href="/fr/tableau-decibels/">Tableau des décibels →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
  {
    slug: 'tableau-decibels', key: 'decibel-chart', title: 'Tableau des décibels : les bruits du quotidien',
    description: 'Tableau des décibels avec des niveaux dBA approximatifs : chambre, bibliothèque, conversation, circulation, tondeuse et concert.',
    intro: 'Ces exemples donnent des ordres de grandeur pour situer vos mesures. La distance, la pièce, la durée et la pondération choisie modifient fortement le niveau réel.', label: 'Tableau des décibels', article: true,
    body: `<table><caption class="sr-only">Niveaux approximatifs de bruits courants, en dBA</caption><thead><tr><th>Niveau (env.)</th><th>Exemple</th></tr></thead><tbody><tr><td>30 dBA</td><td>Chambre calme, la nuit</td></tr><tr><td>40 dBA</td><td>Bibliothèque silencieuse</td></tr><tr><td>50 dBA</td><td>Bureau paisible, pluie modérée</td></tr><tr><td>60 dBA</td><td>Conversation normale</td></tr><tr><td>70 dBA</td><td>Circulation dense à courte distance</td></tr><tr><td>80 dBA</td><td>Restaurant animé</td></tr><tr><td>90 dBA</td><td>Tondeuse à gazon ou moto</td></tr><tr><td>100 dBA</td><td>Devant de scène d’un concert</td></tr><tr><td>110 dBA</td><td>Outils électriques bruyants</td></tr><tr><td>120 dBA</td><td>Sirène à courte distance</td></tr></tbody></table><h2>Bien lire ces valeurs</h2><p>L’échelle des décibels est logarithmique : 10 dB de plus représentent environ dix fois plus d’énergie sonore, et un écart de 3 dB correspond déjà à un doublement de cette énergie. Ne comparez vos chiffres au tableau qu’après <a href="/fr/calibrage/">calibrage</a>, avec la pondération A. Pour mémoire, 85 dBA pendant huit heures sert souvent de repère, chaque palier de 3 dB divisant environ par deux la durée admissible.</p><h2>Un repère, pas une preuve</h2><p>Ce tableau aide à situer une mesure, jamais à trancher une question de santé, de voisinage ou de norme. Tenez compte des <a href="/fr/precision/">limites de mesure</a> et vérifiez le sens des pondérations dans <a href="/fr/db-vs-dba/">dB et dBA</a>.</p><p><a href="/fr/#measure">Mesurer le volume en ligne →</a> · <a href="/fr/db-vs-dba/">Comprendre dB et dBA →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
  {
    slug: 'db-vs-dba', key: 'db-vs-dba', title: 'dB et dBA : quelle différence ?',
    description: 'Différence entre dB, dBA, dBC et dBZ, et rôle des réponses Rapide et Lente dans vos mesures en ligne.',
    intro: 'Le décibel exprime un rapport logarithmique. Les lettres A, C et Z précisent comment les fréquences comptent dans le niveau affiché.', label: 'dB et dBA', article: true,
    body: `<h2>Le dBFS n’est pas le dB SPL</h2><p>Le navigateur reçoit des valeurs numériques en dBFS, où 0 dBFS désigne le maximum représentable, pas le silence ; les valeurs courantes sont donc négatives. Pour approcher un niveau de pression acoustique ambiante en dB SPL, il faut connaître la sensibilité du microphone, d’où l’utilité d’un <a href="/fr/calibrage/">calibrage face à une référence</a>.</p><h2>Pondérations A, C et Z</h2><ul><li><strong>dBA :</strong> accentue les fréquences comme la perception humaine et convient aux bruits de la vie courante.</li><li><strong>dBC :</strong> reste plus plat et laisse passer davantage de basses, utile pour les sons forts et les crêtes.</li><li><strong>dBZ :</strong> n’applique aucune pondération fréquentielle et montre le signal tel quel.</li></ul><h2>Réponses Rapide et Lente</h2><p>Le mode Rapide suit les brèves variations sur 125 millisecondes ; le mode Lent lisse l’affichage sur une seconde et facilite la lecture d’une ambiance stable. Pour des comparaisons loyales, gardez la même pondération, la même constante de temps, la même position et le même profil de calibrage.</p><p><a href="/fr/#measure">Ouvrir l’appareil de mesure →</a> · <a href="/fr/tableau-decibels/">Tableau des décibels →</a> · <a href="/fr/precision/">Précision →</a></p>`,
  },
  {
    slug: 'microphone-ne-fonctionne-pas', key: 'microphone-not-working', title: 'Le microphone ne fonctionne pas : aide pour le navigateur',
    description: 'Le sonomètre en ligne ne détecte aucun microphone ? Vérifiez l’autorisation, l’appareil d’entrée, HTTPS, les autres applications et le navigateur.',
    intro: 'Commencez par l’autorisation du navigateur, puis suivez les étapes dans l’ordre. Tant qu’aucun signal audio réel n’arrive, la valeur affichée reste « -- ».', label: 'Aide microphone', article: true,
    body: `<h2>1. Vérifier l’autorisation</h2><p>Cliquez sur le cadenas ou l’icône de réglage dans la barre d’adresse pour ouvrir les autorisations du site. Réglez le microphone sur « Autoriser », rechargez la page et relancez la mesure. L’autorisation se donne une fois par origine et peut se retirer à tout moment dans les réglages du navigateur.</p><h2>2. Choisir le bon appareil d’entrée</h2><p>Contrôlez les réglages audio du système : le microphone souhaité doit être sélectionné comme entrée, en mono pour la mesure. Après avoir branché un micro USB ou un casque, actualisez la liste des appareils ou rechargez la page avant de recommencer.</p><h2>3. Fermer les autres applications</h2><p>Les logiciels d’appel, de visioconférence ou d’enregistrement monopolisent parfois le microphone. Quittez-les, puis tentez une nouvelle mesure : un seul programme à la fois peut exploiter l’entrée sur beaucoup d’appareils.</p><h2>4. Contrôler le navigateur et la connexion sécurisée</h2><p>L’accès au microphone exige une page HTTPS. Utilisez une version récente de Chrome, Edge, Firefox ou Safari, car les fenêtres privées, les appareils gérés ou les navigateurs anciens bloquent souvent l’entrée. Si le problème persiste, consultez les <a href="/fr/precision/">limites de mesure</a> et le <a href="/fr/calibrage/">calibrage</a>.</p><p><a href="/fr/#measure">Mesurer de nouveau →</a> · <a href="/fr/precision/">Précision de mesure →</a> · <a href="/fr/calibrage/">Calibrage →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
  {
    slug: 'confidentialite', key: 'privacy', title: 'Confidentialité du microphone et des cookies',
    description: 'Comment le sonomètre traite le son du microphone localement, ce que le navigateur conserve, et comment gérer Analytics et les cookies publicitaires.',
    intro: 'Cette page explique l’autorisation nécessaire à la mesure, le sort des données audio et des sessions, ainsi que les cookies de mesure d’audience et de publicité.', label: 'Confidentialité', article: true,
    body: `<h2>Autorisation du microphone</h2><p>La mesure démarre seulement quand vous appuyez sur Démarrer et acceptez explicitement l’accès dans le navigateur. Vous pouvez retirer cette autorisation à tout moment dans les réglages du site, ce qui coupe aussitôt toute nouvelle capture.</p><h2>Traitement du son</h2><p>Les échantillons du microphone sont analysés dans votre navigateur grâce à la Web Audio API : le site ne crée aucun fichier d’enregistrement et rien n’est envoyé vers un serveur. L’affichage reste sur « -- » au repos, et aucune donnée audio ne quitte votre appareil.</p><h2>Données conservées dans le navigateur</h2><p>Les profils de calibrage, le thème et les sessions que vous choisissez de garder restent dans le stockage local de votre navigateur, jusqu’à 20 sessions. Vous pouvez les effacer depuis l’écran, et la suppression des données du navigateur les retire aussi.</p><h2>Mesure d’audience</h2><p>Pour comprendre l’usage du site, nous utilisons Google Analytics, qui peut déposer des cookies d’analyse ou recevoir des informations de page, de navigateur et d’appareil. Cet outil ne reçoit jamais le son du microphone ni les échantillons de mesure.</p><h2>Publicité et cookies</h2><p>Quand des annonces s’affichent, Google AdSense et ses partenaires peuvent utiliser des cookies pour diffuser et mesurer les publicités, y compris des annonces personnalisées selon vos visites sur ce site et d’autres sites. Vous pouvez désactiver les annonces personnalisées dans les <a href="https://www.google.com/settings/ads">paramètres Google Ads</a> ou refuser la publicité personnalisée de tiers sur <a href="https://optout.aboutads.info/">aboutads.info</a>. Le son du microphone et les échantillons de mesure ne servent jamais à la publicité.</p><h2>Export</h2><p>Les fichiers CSV et JSON se créent dans votre navigateur et s’enregistrent sur votre appareil, une fois celui-ci calibré. Ils ne contiennent aucun enregistrement audio.</p><p><a href="/fr/methodologie/">Le traitement local en détail →</a> · <a href="/fr/#measure">Ouvrir l’appareil →</a></p>`,
  },
  {
    slug: 'sonometre-telephone', key: 'sonometre-telephone', title: 'Sonomètre sur téléphone : mesurer les décibels sans application',
    description: 'Sonomètre gratuit sur téléphone : mesurez les décibels en ligne sur iPhone et Android, sans application. Essai immédiat, méthode, fiabilité et questions fréquentes.',
    intro: 'Cette page est déjà un sonomètre gratuit : ouvrez-la dans le navigateur du téléphone, lancez la mesure, autorisez le microphone, et lisez une estimation en dBA en direct.', label: 'Sonomètre téléphone', article: true,
    body: `<div style="border:1px solid var(--border);border-radius:12px;padding:16px;background:linear-gradient(135deg,rgba(59,130,246,.14),rgba(59,130,246,.03))"><p><strong>Essayez maintenant — 10 secondes, gratuit, sans application :</strong></p><ol><li>Ouvrez cette page dans le navigateur de votre <strong>téléphone ou iPhone</strong>.</li><li><a href="/fr/#measure">Lancer la mesure →</a> et autorisez le microphone.</li><li>Lisez une <strong>estimation en dBA</strong> en direct — moyennez sur 30 à 60 secondes.</li></ol><p>Le son reste traité sur votre appareil. Ni enregistrement, ni envoi.</p></div><h2>Qu’est-ce qu’un sonomètre sur téléphone ?</h2><p>Un <strong>sonomètre</strong>, aussi appelé décibelmètre, exprime la force d’un son en décibels. Cet outil en ligne remplit ce rôle sans rien installer : estimations dBA, dBC et dBZ en direct, minimum, moyenne, maximum, Leq énergétique, graphique de 240 points et export CSV ou JSON une fois l’appareil calibré.</p><h2>Un sonomètre gratuit, vraiment ?</h2><p>Oui, l’usage dans le navigateur est gratuit et illimité, sans compte ni boutique d’applications. Si vous cherchez une application de sonomètre gratuite, commencez ici : la page reste toujours à jour et suffit pour les comparaisons du quotidien. Les applications natives ne se justifient que pour un usage hors ligne ou un enregistrement prolongé.</p><h2>iPhone et Android : comment faire</h2><ul><li><strong>Mesurer les décibels sur iPhone :</strong> ouvrez la page dans Safari, lancez la mesure et autorisez le microphone. Calibrez chaque iPhone une fois face à une <a href="/fr/calibrage/">référence fiable</a>.</li><li><strong>Mesurer les décibels sur Android :</strong> ouvrez la page dans Chrome. L’outil demande la coupure du gain automatique et des traitements vocaux, puis affiche leur état.</li><li><strong>Conseil commun :</strong> orifices dégagés, téléphone à hauteur d’oreille, microphone vers la source, distance notée.</li></ul><h2>Mesurer les décibels avec un téléphone : la méthode</h2><ol><li>Autorisez le microphone sur une page HTTPS et laissez l’orifice dégagé.</li><li>Placez le téléphone à hauteur d’oreille, face à la source, à distance notée.</li><li>Restez silencieux, laissez l’affichage se stabiliser, puis lisez la moyenne ou le Leq sur 30 à 60 secondes.</li><li>Gardez la même pondération, la même constante de temps et la même position pour comparer deux lieux.</li></ol><h2>Quelle fiabilité attendre ?</h2><p>Comptez sur un ordre de grandeur de quelques décibels : les modèles courants s’écartent souvent de 5 à 10 dB pour un même son, les niveaux sous 30 dBA ressortent trop haut, le signal sature vers 95 à 100 dBA et les basses restent affaiblies. Moyennez sur 30 à 60 secondes et ignorez les décimales. Le détail figure dans la page <a href="/fr/precision/">précision</a>, et les repères courants dans le <a href="/fr/tableau-decibels/">tableau des décibels</a>. Pour toute décision formelle, prévoyez un appareil de classe 1 ou 2 entretenu et vérifié.</p><h2>Questions fréquentes</h2><h3>Peut-on mesurer les décibels gratuitement avec un téléphone ?</h3><p>Oui. Ouvrez le <a href="/fr/#measure">panneau de mesure →</a> : aucune application, aucun compte, aucune limite d’essais.</p><h3>Faut-il une application sur iPhone ou Android ?</h3><p>Non pour un usage courant. Safari sur iPhone et Chrome sur Android suffisent, avec un <a href="/fr/calibrage/">calibrage</a> par appareil pour resserrer les chiffres.</p><h3>Le son de mon téléphone est-il envoyé quelque part ?</h3><p>Non. L’analyse se fait localement via la Web Audio API, comme expliqué dans la <a href="/fr/confidentialite/">page de confidentialité</a>.</p><p><a href="/fr/#measure">Ouvrir l’appareil →</a> · <a href="/fr/mode-emploi/">Mode d’emploi →</a> · <a href="/fr/guides/">Tous les guides →</a></p>`,
  },
];

export function getStaticPaths() {
  return ['guides', 'mode-emploi', 'methodologie', 'calibrage', 'precision', 'tableau-decibels', 'db-vs-dba', 'microphone-ne-fonctionne-pas', 'confidentialite', 'sonometre-telephone']
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown French guide route: ${slug}`);
const dict = getDict('fr');
const path = `/fr/${page.slug}/`;
const url = `${SITE}${path}`;
const jsonLd = [
  ...(page.article ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'fr', dateModified: '2026-09-24' })] : []),
  breadcrumbJsonLd([{ name: 'Accueil', url: `${SITE}/fr/` }, { name: page.label, url }]),
];
---

<Layout locale="fr" dict={dict} title={`${page.title} | Real Decibel Meter`} description={page.description} path={path} hreflang={guideHreflang(page.key)} jsonLd={jsonLd} ogType={page.article ? 'article' : 'website'}>
  <Article title={page.title} intro={page.intro} reviewed="2026-09-24" breadcrumb={[{ name: 'Accueil', href: '/fr/' }, { name: page.label, href: path }]}>
    <div class="article-rich" set:html={page.body} />
  </Article>
</Layout>
