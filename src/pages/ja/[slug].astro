    'privacy',
    'noise-meter-app',
    'onryo-sokutei',
    'db-sokutei',
    'souon-sokutei',
  ].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown Japanese guide route: ${slug}`);
const dict = getDict('ja');
const url = `${SITE}/ja/${page.slug}/`;
const breadcrumbs = [
  { name: 'トップ', url: `${SITE}/ja/` },
  { name: page.label, url },
];
const jsonLd = [
  ...(page.article
    ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'ja', dateModified: page.dateModified ?? '2026-09-18' })]
    : []),
  breadcrumbJsonLd(breadcrumbs),
];
---

<Layout
  locale="ja"
  dict={dict}
  title={`${page.title} | Real Decibel Meter`}
  description={page.description}
  path={`/ja/${page.slug}/`}
  hreflang={guideHreflang(keyForSlug(page.slug))}
  jsonLd={jsonLd}
  ogType={page.article ? 'article' : 'website'}
>
  <Article
    title={page.title}
    intro={page.intro}
    reviewed={page.dateModified ?? '2026-09-18'}
    breadcrumb={[
      { name: 'トップ', href: '/ja/' },
      { name: page.label, href: `/ja/${page.slug}/` },
    ]}
  >
    <div class="article-rich" set:html={page.body} />
  </Article>
</Layout>
