export function getStaticPaths() {
  return [
    'guides',
    'how-to-use',
    'methodology',
    'calibration',
    'accuracy',
    'decibel-chart',
    'db-vs-dba',
    'microphone-not-working',
    'privacy',
    'noise-meter-app',
  ].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages.find((candidate) => candidate.slug === slug);
if (!page) throw new Error(`Unknown Japanese guide route: ${slug}`);
const dict = getDict('ja');
const url = `${SITE}/ja/${page.slug}/`;
const breadcrumbs = [
  { name: 'トップ', url: `${SITE}/ja/` },
  { name: page.label, url },
];
const jsonLd = [
  ...(page.article
    ? [articleJsonLd({ headline: page.title, description: page.description, url, inLanguage: 'ja', dateModified: '2026-09-18' })]
    : []),
  breadcrumbJsonLd(breadcrumbs),
];
