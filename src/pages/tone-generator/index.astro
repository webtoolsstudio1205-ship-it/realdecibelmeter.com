---
import Layout from '../../components/Layout.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import { getDict } from '../../i18n/dictionaries';
import { SITE, articleJsonLd, breadcrumbJsonLd, faqJsonLd, webAppJsonLd, howToJsonLd } from '../../lib/seo';

const dict = getDict('en');
const title = 'Online Tone Generator – Free Sine Wave Generator';
const description =
  'Free online tone generator: play sine, triangle, square and sawtooth tones from 20 Hz to 20 kHz. Online frequency generator with safe volume cap, no install.';
const url = `${SITE}/tone-generator/`;
const faq = [
  {
    q: 'What is an online tone generator?',
    a: 'An online tone generator plays a steady audio tone in your browser at a frequency you choose. This one synthesizes sine, triangle, square and sawtooth waves from 20 Hz to 20 kHz with the Web Audio API, so nothing is downloaded and no microphone is needed.',
  },
  {
    q: 'What does a sine wave generator do?',
    a: 'A sine wave generator plays the purest single pitch with no added harmonics. Use sine to check whether a speaker still reproduces 90 Hz or 3 kHz at all, then switch to triangle, square or sawtooth when you want to hear harmonic edge or buzz.',
  },
  {
    q: 'What frequency range does this frequency generator online support?',
    a: '20 Hz to 20,000 Hz with a live slider plus presets at 220 Hz, 440 Hz, 1 kHz, 4 kHz and 8 kHz. You can drag the slider while a tone plays to bend pitch live, which is how most people run an online frequency generator for quick sweeps.',
  },
  {
    q: 'Is this online frequency generator free?',
    a: 'Yes. It is free with no download, no account and no microphone permission. It works in current Chrome, Edge, Firefox and Safari over HTTPS, and audio is synthesized locally on your device.',
  },
  {
    q: 'Is it safe for my speakers and hearing?',
    a: 'Start at the lowest volume that works, keep high-frequency tones short, and stop if playback feels uncomfortable. Volume here is capped at 25% so a slip cannot blast full scale, but never raise volume to hunt a pitch you cannot hear, especially past 12 kHz.',
  },
  {
    q: 'Can I use it to test speakers or as a calibration reference?',
    a: 'Yes for pitch-path checks: compare left versus right with 1 kHz, isolate a rattle near 120–180 Hz, or hold a steady 1 kHz sine as a pitch reference while comparing setups. A browser tone is a pitch reference, not a decibel-level reference — use the decibel meter and the calibration guide for level work.',
  },
];
const jsonLd = [
  webAppJsonLd({ name: title, url, description, inLanguage: 'en' }),
  articleJsonLd({ headline: title, description, url, inLanguage: 'en', dateModified: '2026-10-01' }),
  faqJsonLd(faq),
  howToJsonLd({
    name: 'How to generate a tone online',
    description: 'Play a sine wave or any audio frequency in your browser with this free online tone generator.',
    url,
    inLanguage: 'en',
    steps: [
      { name: 'Pick a frequency', text: 'Drag the slider from 20 Hz to 20 kHz or tap a preset such as 440 Hz or 1 kHz.' },
      { name: 'Pick waveform and channel', text: 'Choose sine for a pure tone, or triangle, square or sawtooth for harmonic checks, then pick Both, Left or Right.' },
      { name: 'Play at low volume', text: 'Press Play tone at low volume and raise gradually. Use Auto stop after 5, 30 or 60 seconds for bounded bursts.' },
    ],
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITE}/` },
    { name: 'Guides', url: `${SITE}/guides/` },
    { name: 'Online tone generator', url },
  ]),
];
---

<Layout locale="en" dict={dict} title={`${title} — Real Decibel Meter`} description={description} path="/tone-generator/" jsonLd={jsonLd}>
  <div class="container-x py-10" style="max-width:1040px">
    <header class="mb-6">
      <p class="eyebrow">Free online frequency generator · no download</p>
      <h1 class="hero-title mt-2">Online Tone Generator – Free Sine Wave &amp; Frequency Generator</h1>
      <p class="hero-sub mt-3">
        Generate a pure sine wave tone or any audio frequency online, free in your browser. Play 20 Hz to 20 kHz with
        waveform, channel and safe-volume controls — no install, no account, no microphone needed.
      </p>
    </header>

    <div class="mt-4" style="max-width:78ch">
      <AnswerBox
        answer="This online tone generator is a free online frequency generator that plays sine wave tones plus triangle, square and sawtooth waves from 20 Hz to 20 kHz directly in your browser. Audio is synthesized locally with the Web Audio API and never uploaded. Volume is capped at 25% for safer speaker and hearing checks."
        facts={[
          'Free frequency generator online: 20–20,000 Hz slider with 220 Hz, 440 Hz, 1 kHz, 4 kHz and 8 kHz presets and live pitch bend.',
          'Sine wave generator mode for pure single pitch; triangle, square and sawtooth for harmonic checks; Both, Left or Right channel.',
          'Auto-stop after 5, 30 or 60 seconds, capped volume, works in Chrome, Edge, Firefox and Safari over HTTPS.',
        ]}
      />
    </div>

    <section class="panel p-6 mt-6" aria-labelledby="tg-heading">
      <h2 id="tg-heading" class="text-xl font-semibold tracking-tight">Online tone generator</h2>
      <p id="tg-status" class="mt-2 text-sm" style="color:var(--muted)" role="status">Stopped.</p>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
          <label for="tg-freq" class="text-sm font-medium">Frequency: <span id="tg-freq-val" class="tabular">440</span> Hz</label>
          <input id="tg-freq" type="range" min="20" max="20000" step="1" value="440" class="w-full" style="min-height:44px" />
          <div class="mt-2 flex flex-wrap gap-2">
            <button type="button" class="btn-secondary focus-ring" data-tg-preset="220">220</button>
            <button type="button" class="btn-secondary focus-ring" data-tg-preset="440">440</button>
            <button type="button" class="btn-secondary focus-ring" data-tg-preset="1000">1 kHz</button>
            <button type="button" class="btn-secondary focus-ring" data-tg-preset="4000">4 kHz</button>
            <button type="button" class="btn-secondary focus-ring" data-tg-preset="8000">8 kHz</button>
          </div>
        </div>
        <div class="grid gap-3">
          <div>
            <label for="tg-wave" class="text-sm font-medium">Waveform</label>
            <select id="tg-wave" data-fancy class="w-full panel-raised p-2 mt-1" style="border-radius:8px;min-height:44px">
              <option value="sine" data-icon="sine" data-desc="Pure single pitch">Sine (pure tone)</option>
              <option value="triangle" data-icon="triangle" data-desc="Mellow, soft edges">Triangle (soft)</option>
              <option value="square" data-icon="square" data-desc="Harsh, hollow edge">Square (harsh)</option>
              <option value="sawtooth" data-icon="sawtooth" data-desc="Buzzy, bright harmonics">Sawtooth (buzzy)</option>
            </select>
          </div>
          <div>
            <label for="tg-channel" class="text-sm font-medium">Channel</label>
            <select id="tg-channel" data-fancy class="w-full panel-raised p-2 mt-1" style="border-radius:8px;min-height:44px">
              <option value="both" data-icon="both" data-desc="Same tone each side">Both speakers</option>
              <option value="left" data-icon="left" data-desc="Isolate left speaker">Left only</option>
              <option value="right" data-icon="right" data-desc="Isolate right speaker">Right only</option>
            </select>
          </div>
          <div>
            <label for="tg-vol" class="text-sm font-medium">Volume (capped for safety): <span id="tg-vol-val" class="tabular">20</span>%</label>
            <input id="tg-vol" type="range" min="1" max="25" step="1" value="20" class="w-full" style="min-height:44px" />
          </div>
          <div>
            <label for="tg-timer" class="text-sm font-medium">Auto stop</label>
            <select id="tg-timer" data-fancy class="w-full panel-raised p-2 mt-1" style="border-radius:8px;min-height:44px">
              <option value="0" data-icon="off" data-desc="Play until you stop">Off</option>
              <option value="5" data-icon="timer" data-desc="Short burst for high pitch">After 5 s</option>
              <option value="30" data-icon="timer" data-desc="Compare two setups">After 30 s</option>
              <option value="60" data-icon="timer" data-desc="Extended listening">After 60 s</option>
            </select>
          </div>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <button id="tg-play" type="button" class="btn-primary focus-ring">Play tone</button>
        <button id="tg-stop" type="button" class="btn-secondary focus-ring" disabled>Stop</button>
      </div>
    </section>

    <div class="article-rich panel p-6 mt-6">
      <h2>What is an online tone generator?</h2>
      <p>
        An online tone generator plays a steady audio tone in your browser at the exact frequency you pick — no app, no audio file,
        no microphone. This free frequency generator online synthesizes every tone live with the Web Audio API inside your own browser,
        so it runs in current Chrome, Edge, Firefox or Safari without an account or install and nothing is uploaded. Start with 440 Hz
        sine on Both speakers near 12% volume, press Play, then raise the slider one step at a time until the pitch sits clearly above
        room noise. Dragging the frequency slider while a tone plays bends the pitch live, and Auto stop cuts playback after 5, 30 or
        60 seconds when you want a bounded burst for a high pitch.
      </p>
      <h2>Sine wave generator and other waveforms</h2>
      <p>Sine gives you the purest single pitch, which makes this sine wave generator mode the best choice when you ask whether a driver still reproduces 90 Hz or 3 kHz at all. Triangle sounds softer around the edges, while square and sawtooth add stacked harmonics that read as harsh or buzzy — keep those two near 8 to 10%. Both sends the same signal to each side, Left isolates the left speaker or earcup, Right isolates the right, and that split settles arguments fast when one earbud went quiet. Expect little phones and thin laptops to fade below roughly 150 to 200 Hz; a missing 40 Hz rumble on that hardware says more about cabinet size than about your audio file.</p>
      <h2>Online frequency generator: range, presets and live pitch</h2>
      <p>Use this online frequency generator anywhere from 20 Hz to 20 kHz. Tap 220 Hz for low-mid warmth, 440 Hz concert pitch for a neutral reference, 1 kHz for channel matching, 4 kHz for presence and sibilance checks, or 8 kHz for top-octave hiss. Everything is synthesized locally, so the frequency readout is the requested digital frequency — what you hear still depends on your speaker, Bluetooth codec and room. Open the <a href="/frequency-analyzer/">frequency spectrum</a> in a second tab, play 220 Hz here, then 4 kHz, and watch the energy hump march from left to right.</p>
      <h2>Four speaker checks that actually tell you something</h2>
      <p>You moved a bookshelf pair and the left one now sounds thin. Play 120 Hz sine on Both at modest level, switch to Left only, then Right only, and listen for equal weight — a 20-second A/B like that exposes a loose plug quicker than any playlist. Your right earbud dropped in volume last week. Run 1 kHz Left, then Right, at the same slider position; if Right needs three or four extra clicks to match, clean the mesh or check balance settings before buying a replacement. You want a steady reference while reading about <a href="/calibration/">calibration</a>. Hold 1 kHz sine for 30 seconds and compare two setups, remembering a browser tone is a pitch reference rather than a level reference. For a full sweep instead of a steady tone, run the <a href="/speaker-test/">speaker test</a> 20 Hz – 20 kHz sweep.</p>
      <h2>Safe use: volume cap, hearing and small speakers</h2>
      <p>Start at the lowest volume that works, keep tones short at high frequencies, and stop immediately if playback feels uncomfortable. Never test hearing at high volume — the <a href="/hearing-age-test/">hearing age test</a> runs at a fixed moderate level for exactly this reason. Never raise the volume to hunt a pitch you cannot hear, especially past 12 kHz, because discomfort arrives late at those frequencies and the 25% cap exists to keep a slip from blasting full scale. Phone speakers compress bass, Bluetooth codecs shave extreme treble, and room modes boost some notes near walls while swallowing others in the middle of the room, so walk two steps and re-listen before you blame a speaker.</p>
      <h2>What this frequency generator cannot tell you</h2>
      <p>A tone tells you a pitch path works, never how loud your room is in decibels and never how your hearing thresholds score — chase those questions with the <a href="/#measure">online decibel meter</a> and the screening test instead. For everyday level context, skim the <a href="/decibel-chart/">decibel comparison chart</a>, and for method questions browse the <a href="/faq/">frequently asked questions</a>.</p>
      <h2>What it is good for</h2>
      <p>Checking a speaker still plays a given pitch, comparing left and right channels with the <a href="/speaker-test/">speaker test</a>, producing a steady 1 kHz reference for <a href="/calibration/">calibration</a> comparisons, and demonstrating the <a href="/frequency-analyzer/">frequency spectrum</a> live: play a tone here and watch the meter spectrum react in another tab.</p>
      <p><a href="/hearing-age-test/">Hearing age test →</a> · <a href="/speaker-test/">Speaker test →</a> · <a href="/#measure">Open the decibel meter →</a></p>
    </div>

    <section class="panel p-6 mt-6" aria-labelledby="tg-faq">
      <h2 id="tg-faq" class="text-xl font-semibold tracking-tight">Online tone generator: common questions</h2>
      <div class="mt-3 grid gap-2">
        {faq.map((f) => (
          <details class="panel-raised px-4" style="border-radius:10px">
            <summary class="cursor-pointer focus-ring font-medium text-[15px]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4" style="color:var(--muted)">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-6 panel-raised p-6 rounded-2xl">
      <h2 class="text-lg font-semibold tracking-tight">More online audio tools</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/#measure" class="block p-3 rounded-xl border border-hairline hover:border-strong transition">
          <strong class="block text-primary">Decibel Meter</strong>
          <span class="text-xs text-muted">Measure sound level &amp; dBA in real-time</span>
        </a>
        <a href="/frequency-analyzer/" class="block p-3 rounded-xl border border-hairline hover:border-strong transition">
          <strong class="block text-primary">Frequency Analyzer</strong>
          <span class="text-xs text-muted">FFT audio spectrum &amp; pitch analysis</span>
        </a>
        <a href="/speaker-test/" class="block p-3 rounded-xl border border-hairline hover:border-strong transition">
          <strong class="block text-primary">Speaker Test</strong>
          <span class="text-xs text-muted">Left/right channels, polarity and sweep</span>
        </a>
      </div>
    </section>
  </div>

  <script>
    (function () {
      var ctx = null, osc = null, gain = null, pan = null, timer = null;
      var freqEl = document.getElementById('tg-freq');
      var freqVal = document.getElementById('tg-freq-val');
      var waveEl = document.getElementById('tg-wave');
      var chEl = document.getElementById('tg-channel');
      var volEl = document.getElementById('tg-vol');
      var volVal = document.getElementById('tg-vol-val');
      var timerEl = document.getElementById('tg-timer');
      var playBtn = document.getElementById('tg-play');
      var stopBtn = document.getElementById('tg-stop');
      var statusEl = document.getElementById('tg-status');

      function setStatus(t) { if (statusEl) statusEl.textContent = t; }

      function syncLabels() {
        if (freqVal && freqEl) freqVal.textContent = freqEl.value;
        if (volVal && volEl) volVal.textContent = volEl.value;
      }

      function panValue() {
        if (!chEl) return 0;
        if (chEl.value === 'left') return -1;
        if (chEl.value === 'right') return 1;
        return 0;
      }

      function stop(clearMsg) {
        if (timer) { clearTimeout(timer); timer = null; }
        try {
          if (osc) { try { osc.stop(); } catch (e) {} try { osc.disconnect(); } catch (e) {} }
          if (gain) { try { gain.disconnect(); } catch (e) {} }
          if (pan) { try { pan.disconnect(); } catch (e) {} }
        } catch (e) {}
        if (ctx) { try { ctx.close(); } catch (e) {} }
        ctx = osc = gain = pan = null;
        if (playBtn) playBtn.disabled = false;
        if (stopBtn) stopBtn.disabled = true;
        if (!clearMsg) setStatus('Stopped.');
      }

      function play() {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) { setStatus('Web Audio is not supported in this browser.'); return; }
        stop(true);
        try {
          ctx = new AC({ latencyHint: 'interactive' });
          osc = ctx.createOscillator();
          gain = ctx.createGain();
          var t = ctx.currentTime;
          var vol = Math.min(25, Math.max(1, Number(volEl ? volEl.value : 20))) / 100;
          // Hard cap at quarter scale so a slip cannot blast full-scale audio.
          var peak = Math.min(0.25, vol * 0.9);
          gain.gain.setValueAtTime(0.0001, t);
          gain.gain.exponentialRampToValueAtTime(Math.max(0.0002, peak), t + 0.05);
          osc.type = waveEl ? waveEl.value : 'sine';
          osc.frequency.setValueAtTime(Number(freqEl ? freqEl.value : 440), t);
          if (typeof ctx.createStereoPanner === 'function') {
            pan = ctx.createStereoPanner();
            pan.pan.setValueAtTime(panValue(), t);
            osc.connect(gain); gain.connect(pan); pan.connect(ctx.destination);
          } else {
            osc.connect(gain); gain.connect(ctx.destination);
          }
          if (ctx.state === 'suspended') { ctx.resume(); }
          osc.start();
          // Live-update while playing.
          osc.onended = function () {};
          setStatus('Playing ' + (freqEl ? freqEl.value : 440) + ' Hz (' + (waveEl ? waveEl.value : 'sine') + ').');
          if (playBtn) playBtn.disabled = true;
          if (stopBtn) stopBtn.disabled = false;
          var secs = Number(timerEl ? timerEl.value : 0);
          if (secs > 0) timer = setTimeout(function () { stop(); setStatus('Auto-stopped after ' + secs + ' s.'); }, secs * 1000);
        } catch (e) {
          setStatus('Could not start audio. Check autoplay permissions and try again.');
          stop(true);
        }
      }

      if (freqEl) freqEl.addEventListener('input', function () {
        syncLabels();
        if (osc && ctx) { try { osc.frequency.setTargetAtTime(Number(freqEl.value), ctx.currentTime, 0.02); } catch (e) {} }
      });
      if (volEl) volEl.addEventListener('input', function () {
        syncLabels();
        if (gain && ctx) {
          var vol = Math.min(25, Math.max(1, Number(volEl.value))) / 100;
          try { gain.gain.setTargetAtTime(Math.min(0.25, vol * 0.9), ctx.currentTime, 0.03); } catch (e) {}
        }
      });
      if (waveEl) waveEl.addEventListener('change', function () {
        if (osc) { try { osc.type = waveEl.value; } catch (e) {} }
      });
      if (chEl) chEl.addEventListener('change', function () {
        if (pan && ctx) { try { pan.pan.setTargetAtTime(panValue(), ctx.currentTime, 0.02); } catch (e) {} }
      });
      document.querySelectorAll('[data-tg-preset]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (freqEl) { freqEl.value = b.getAttribute('data-tg-preset'); syncLabels(); }
          if (osc && ctx) { try { osc.frequency.setTargetAtTime(Number(freqEl.value), ctx.currentTime, 0.02); } catch (e) {} }
        });
      });
      if (playBtn) playBtn.addEventListener('click', play);
      if (stopBtn) stopBtn.addEventListener('click', function () { stop(); });
      window.addEventListener('pagehide', function () { stop(true); });
      syncLabels();
    })();
  </script>
</Layout>
