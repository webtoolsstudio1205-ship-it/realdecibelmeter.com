---
import Layout from '../components/Layout.astro';
import MeterPanel from '../components/MeterPanel.astro';
import { getDict } from '../i18n/dictionaries';

const locale = 'en';
const dict = getDict(locale);

const guides = [
  { href: '/accuracy/', t: 'Accuracy', d: 'What browser estimates can and cannot claim.' },
  { href: '/calibration/', t: 'Calibration', d: 'Add an offset from a known reference.' },
  { href: '/methodology/', t: 'Methodology', d: 'How the Web Audio pipeline computes levels.' },
  { href: '/how-to-use/', t: 'How to use', d: 'Permissions, placement and best practice.' },
  { href: '/microphone-not-working/', t: 'Microphone help', d: 'Fix denied, busy or missing inputs.' },
  { href: '/decibel-chart/', t: 'Decibel chart', d: 'Typical everyday sound levels.' },
];
---

<Layout locale={locale} dict={dict} title={dict.metaTitle} description={dict.metaDescription} path="/">
  <div class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <svg class="hero-wave" viewBox="0 0 1120 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 55 C80 55 92 31 156 31 S248 74 316 56 402 36 468 53 552 78 620 48 704 25 782 55 862 72 930 45 1008 52 1086 63 1120 48 1120 48" />
    </svg>
    <div class="container-x hero-copy">
      <p class="eyebrow anim-rise" style="--d:40ms">PRIVATE • REAL-TIME • NO DOWNLOAD</p>
      <h1 class="hero-title mt-2" aria-label="Measure Sound Instantly">
        <span class="anim-rise" style="--d:90ms">Measure Sound</span>
        <span class="hero-title-second anim-rise" style="--d:140ms">Instantly</span>
      </h1>
      <p class="hero-sub anim-rise" style="--d:190ms">Check microphone input strength immediately, or calibrate your device for estimated environmental sound levels.</p>
      <div class="hero-actions anim-rise" style="--d:240ms">
        <a href="#measure" class="btn-primary focus-ring">{dict.startMeasuring}</a>
        <a href="/accuracy/" class="btn-secondary focus-ring">{dict.howAccuracy}</a>
      </div>
      <ul class="trust-row anim-rise" style="--d:290ms" aria-label="Privacy and compatibility">
        <li>Audio processed locally</li>
        <li>No account required</li>
        <li>Works in your browser</li>
      </ul>
    </div>
  </div>

  <div class="container-x pb-4" style="max-width:1120px">
    <MeterPanel dict={dict} />
  </div>

  <div class="container-x py-8 grid gap-4" style="max-width:1120px">
    <section class="panel p-6" data-reveal aria-labelledby="steps">
      <h2 id="steps" class="text-xl font-semibold tracking-tight">{dict.stepsTitle}</h2>
      <ol class="mt-4 grid gap-4 md:grid-cols-3">
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">01</p><h3 class="font-semibold mt-1">{dict.step1t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step1d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">02</p><h3 class="font-semibold mt-1">{dict.step2t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step2d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">03</p><h3 class="font-semibold mt-1">{dict.step3t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step3d}</p></li>
      </ol>
    </section>

    <section class="grid gap-4 md:grid-cols-2" aria-label="Features and privacy">
      <article class="panel p-6" data-reveal aria-labelledby="features">
        <p class="eyebrow">Features</p>
        <h2 id="features" class="text-xl font-semibold tracking-tight mt-1">One honest meter, two clear modes</h2>
        <p class="text-[15px] leading-7 mt-2" style="color:var(--muted)">Use input strength on any compatible microphone. Add a device-specific reference profile only when you need an estimated environmental sound level.</p>
      </article>
      <article class="panel p-6" data-reveal aria-labelledby="privacy-home">
        <p class="eyebrow">Privacy</p>
        <h2 id="privacy-home" class="text-xl font-semibold tracking-tight mt-1">Audio stays on your device</h2>
        <p class="text-[15px] leading-7 mt-2" style="color:var(--muted)">The browser processes microphone samples locally. The site does not upload recordings, and saved session history remains in this browser.</p>
      </article>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="acc">
      <p class="eyebrow">Estimate, not a certified meter</p>
      <h2 id="acc" class="text-xl font-semibold tracking-tight mt-1">{dict.accTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.accBody}</p>
      <p class="mt-3"><a href="/accuracy/" class="focus-ring underline underline-offset-4 text-sm">Read the full accuracy guide →</a></p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="trouble">
      <h2 id="trouble" class="text-xl font-semibold tracking-tight">{dict.troubleTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.troubleBody}</p>
      <p class="mt-3"><a href="/microphone-not-working/" class="focus-ring underline underline-offset-4 text-sm">Microphone troubleshooting →</a></p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="sess">
      <h2 id="sess" class="text-xl font-semibold tracking-tight">{dict.sessionTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.sessionBody}</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-semibold tracking-tight">{dict.faqTitle}</h2>
      <div class="mt-3 grid gap-2">
        {dict.faq.map((f) => (
          <details class="panel-raised px-4" style="border-radius:10px">
            <summary class="cursor-pointer focus-ring font-medium text-[15px]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4" style="color:var(--muted)">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section data-reveal aria-labelledby="guides">
      <h2 id="guides" class="text-xl font-semibold tracking-tight">{dict.guidesTitle}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => (
          <a href={g.href} class="panel lift p-4 focus-ring block hover:opacity-90">
            <h3 class="font-semibold text-[15px]">{g.t}</h3>
            <p class="text-sm mt-1" style="color:var(--muted)">{g.d}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
