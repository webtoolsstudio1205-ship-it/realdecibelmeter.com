---
import Layout from '../components/Layout.astro';
import MeterPanel from '../components/MeterPanel.astro';
import ChecklistPanel from '../components/ChecklistPanel.astro';
import ExposurePanel from '../components/ExposurePanel.astro';
import SpectrumPanel from '../components/SpectrumPanel.astro';
import ComparePanel from '../components/ComparePanel.astro';
import ReportPanel from '../components/ReportPanel.astro';
import SoundLevelGuide from '../components/SoundLevelGuide.astro';
import AnswerBox from '../components/AnswerBox.astro';
import { getDict } from '../i18n/dictionaries';
import { SITE, webAppJsonLd, faqJsonLd, breadcrumbJsonLd, howToJsonLd } from '../lib/seo';

const locale = 'en';
const dict = getDict(locale);

const jsonLd = [
  webAppJsonLd({
    name: 'Online Decibel Meter',
    url: `${SITE}/`,
    description: 'Free online decibel meter – measure sound level in browser, no download. Calibrate for better accuracy.',
    inLanguage: 'en',
  }),
  faqJsonLd(dict.faq),
  howToJsonLd({
    name: 'How to measure sound with the online decibel meter',
    description: 'Allow the microphone, watch the live level panel, then tune weighting and export the session.',
    url: `${SITE}/`,
    inLanguage: 'en',
    steps: [
      { name: 'Allow the microphone', text: 'Press Start and grant microphone permission when the browser asks. Audio stays on your device.' },
      { name: 'Watch the live panel', text: 'Read current, minimum, energy-average (Leq) and maximum estimated decibels with the live graph.' },
      { name: 'Tune and export', text: 'Pick A/C/Z weighting and Fast/Slow response, optionally calibrate against a reference, then export CSV or JSON.' },
    ],
  }),
  breadcrumbJsonLd([{ name: 'Home', url: `${SITE}/` }]),
];

const guides = [
  { href: '/calibration/', t: 'Calibration', d: 'Calibrate your microphone with a known reference before trusting dBA estimates.' },
  { href: '/accuracy/', t: 'Browser measurement accuracy', d: 'What browser estimates can and cannot claim — and when to use a certified meter.' },
  { href: '/methodology/', t: 'How the meter works', d: 'RMS, dBFS, weighting, Fast/Slow response and Leq, explained from the real pipeline.' },
  { href: '/decibel-chart/', t: 'Decibel comparison chart', d: 'Understand decibel levels with approximate everyday examples.' },
  { href: '/db-vs-dba/', t: 'dB vs dBA', d: 'What A, C and Z weighting mean and which one to pick.' },
  { href: '/noise-exposure/', t: 'Noise exposure', d: 'Level plus duration: screening bands and the 3 dB exchange rule.' },
  { href: '/noise-limits/', t: 'How loud is too loud?', d: 'Everyday safe levels plus OSHA, NIOSH and WHO thresholds side by side.' },
  { href: '/decibel-meter-app/', t: 'Decibel meter app', d: 'A free web app that needs no install — how it compares to store apps.' },
  { href: '/phone-decibel-meter/', t: 'Phone decibel meter', d: 'Getting useful readings from iPhone and Android browsers.' },
  { href: '/iphone-decibel-meter/', t: 'iPhone decibel meter', d: 'Free online iPhone meter in Safari — no app install, live dBA.' },
  { href: '/frequency-analyzer/', t: 'Frequency analyzer', d: 'Reading the live spectrum alongside the dB value.' },
  { href: '/sound-level-meter/', t: 'Sound level meters', d: 'Hardware classes versus browser estimates.' },
  { href: '/a-weighted-decibel-meter/', t: 'A-weighted decibel meter', d: 'How dBA filtering mirrors human hearing and how to measure A-weighted sound levels online.' },
  { href: '/blog/', t: 'Audio calibration blog', d: 'Using audio test tones and 1 kHz reference sine waves to calibrate decibel meters.' },
  { href: '/decibel-meter-for-classroom/', t: 'Decibel meter for classrooms', d: 'Screen classroom noise with typical dBA bands — placement and honest phone-mic limits.' },
  { href: '/privacy/', t: 'Microphone privacy', d: 'How local audio processing keeps recordings on your device.' },
  { href: '/faq/', t: 'FAQ', d: 'Short answers on accuracy, calibration, Leq and safe levels.' },
];
const tools = [
  { href: '/microphone-noise-floor-test/', t: 'Microphone noise floor test', d: 'Run a focused 30-second raw dBFS diagnostic.' },
  { href: '/background-noise-test/', t: 'Background noise test', d: 'A simple pause-and-resume workflow with honest calibrated and uncalibrated modes.' },
  { href: '/dbfs-vs-db-spl/', t: 'dBFS vs dB SPL', d: 'Understand why digital microphone levels cannot be converted universally to sound pressure.' },
  { href: '/validation/', t: 'Validation protocol', d: 'Reproducible repeatability checks and current verification status.' },
  { href: '/tone-generator/', t: 'Online tone generator', d: 'Free sine wave & frequency generator online — 20 Hz–20 kHz tones in your browser.' },
  { href: '/speaker-test/', t: 'Speaker test', d: 'Check channels, polarity and rattles with a sweep.' },
  { href: '/hearing-age-test/', t: 'Hearing age test', d: 'Find your highest audible pitch. Screening only.' },
  { href: '/noise-exposure-calculator/', t: 'Exposure calculator', d: 'Daily dose from any average level and duration.' },
];
---

<Layout locale={locale} dict={dict} title={dict.metaTitle} description={dict.metaDescription} path="/" jsonLd={jsonLd}>
  <div class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <svg class="hero-wave" viewBox="0 0 1120 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 55 C80 55 92 31 156 31 S248 74 316 56 402 36 468 53 552 78 620 48 704 25 782 55 862 72 930 45 1008 52 1086 63 1120 48 1120 48" />
    </svg>
    <div class="container-x hero-copy">
      <!-- Linear Release Announcement Pill -->
      <a href="#measure" class="hero-pill anim-rise" style="--d:20ms">
        <span class="w-2 h-2 rounded-full bg-[#5e6ad2] animate-pulse"></span>
        <span class="font-mono text-[11px] text-[#828fff] tracking-wider uppercase font-semibold">Linear Acoustics</span>
        <span class="text-[#8a8f98]">·</span>
        <span>Client-Side Web Audio DSP & Real-Time Spectrum Engine</span>
        <span class="text-[#828fff] ml-0.5">→</span>
      </a>

      <h1 class="hero-title mt-2 anim-rise" style="--d:80ms">
        <span>Online Decibel Meter</span><br />
        <span class="linear-gradient-text">Engineered for Accuracy.</span>
      </h1>
      <p class="hero-sub anim-rise" style="--d:170ms">
        Real-time A/C/Z decibel metering, rolling Leq graphs, and 10-band FFT frequency analysis — directly in your browser with zero latency and 100% on-device audio privacy.
      </p>
      <div class="hero-actions anim-rise" style="--d:230ms">
        <a href="#measure" class="btn-primary focus-ring grad-edge px-6 py-3.5 text-[15px] shadow-[0_0_32px_-4px_rgba(94,106,210,0.65)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>{dict.startMeasuring}</span>
        </a>
        <a href="/accuracy/" class="btn-secondary focus-ring px-5 py-3.5 text-[15px]">
          <span>{dict.howAccuracy}</span>
          <span class="font-mono text-[11px] px-1.5 py-0.5 rounded bg-[#141516] border border-[#23252a] text-[#8a8f98]">DSP</span>
        </a>
      </div>
      <ul class="trust-row anim-rise" style="--d:290ms" aria-label="Privacy and compatibility">
        <li>Audio processed locally</li>
        <li>48 kHz Web Audio API</li>
        <li>No account required</li>
        <li>OSHA & NIOSH Standards</li>
      </ul>
    </div>
  </div>

  <div class="container-x pb-4" style="max-width:1120px">
    <MeterPanel dict={dict} locale={locale} />
    <ChecklistPanel locale={locale} />
    <ExposurePanel locale={locale} />
    <SpectrumPanel locale={locale} />
    <ComparePanel locale={locale} />
    <ReportPanel locale={locale} />
    <p class="mt-3 text-sm" style="color:var(--muted);max-width:78ch">
      Uncalibrated readings are nominal dBA, dBC or dBZ estimates based on a common browser-microphone offset.
      Calibration replaces that default with a device-specific offset for better accuracy.
      This free <a class="underline underline-offset-4 focus-ring" href="/methodology/">online sound meter</a>
      works as a sound level meter and noise level meter for quick checks — not as a certified instrument.
    </p>
    <div class="mt-6">
      <AnswerBox
        answer="Real Decibel Meter is a free online decibel meter that estimates sound levels in dBA, dBC or dBZ directly in your browser. Microphone audio is processed locally and never uploaded. Uncalibrated readings are screening estimates — calibrate against a known reference for better device-specific accuracy."
        facts={[
          'Free, no download, no account — works in current Chrome, Edge, Firefox and Safari over HTTPS.',
          'Shows current, minimum, energy-average Leq and maximum plus a 240-point live graph.',
          'Calibration replaces the nominal +100 dB offset with your device-specific offset.',
        ]}
      />
    </div>
    <SoundLevelGuide locale={locale} />
  </div>

  <!-- Linear Bento Grid: Engineering Specification & Acoustic Standards -->
  <div class="container-x py-12" style="max-width:1120px">
    <div class="mb-6">
      <p class="eyebrow">ENGINEERING SPECIFICATION</p>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white mt-1">Measure sound in your browser</h2>
      <p class="text-[15px] text-[#8a8f98] mt-2 max-w-2xl leading-relaxed">This online decibel meter reads your microphone through the Web Audio API and shows a live estimated sound level immediately — engineered for precision and documented with rigor.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Bento 1 (Large 2-col): Pipeline -->
      <section class="panel p-6 lg:col-span-2 relative overflow-hidden" data-reveal aria-labelledby="how">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#5e6ad2]"></span>
          <span>Signal Pipeline</span>
        </div>
        <h3 id="how" class="text-xl font-semibold tracking-tight text-white">How the online decibel meter works</h3>
        <p class="text-[15px] leading-7 mt-2 text-[#d0d6e0]">
          Each audio block is reduced to an RMS value, converted to a level in dB, corrected for the selected
          frequency weighting, smoothed with Fast (125&nbsp;ms) or Slow (1&nbsp;s) time response, and aggregated into an
          energy-average Leq. Before calibration, a nominal +100 dB offset converts the weighted digital level into a clearly
          labelled estimate; a saved calibration offset replaces it. Read the full <a class="underline underline-offset-4 focus-ring text-white font-medium" href="/methodology/">methodology</a>.
        </p>
        <div class="mt-4 pt-4 border-t border-[#23252a] flex flex-wrap items-center gap-2 text-xs font-mono text-[#8a8f98]">
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">Mic PCM</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">48 kHz RMS</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a] text-[#828fff]">A/C/Z Filter</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a]">Ballistics (125ms)</span>
          <span>→</span>
          <span class="px-2 py-1 rounded bg-[#141516] border border-[#23252a] text-[#27a644]">Leq Averaging</span>
        </div>
      </section>

      <!-- Bento 2: Calibration -->
      <section class="panel p-6 relative overflow-hidden" data-reveal aria-labelledby="cal">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#828fff]"></span>
          <span>Calibration</span>
        </div>
        <h3 id="cal" class="text-xl font-semibold tracking-tight text-white">Calibrating for estimated environmental decibels</h3>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">
          Every microphone has different gain, so calibration is required before trusting environmental dBA numbers.
          Compare against a steady reference and save your device-specific profile. To generate pure acoustic reference tones (such as a 1 kHz sine wave) or frequency sweeps for testing, use <a class="underline underline-offset-4 focus-ring font-medium text-white" href="https://realtonegenerator.com/" target="_blank" rel="noopener">Real Tone Generator</a>. Follow the <a class="underline underline-offset-4 focus-ring text-white" href="/calibration/">calibration guide</a> or read our <a class="underline underline-offset-4 focus-ring text-white" href="/blog/">calibration blog post</a>.
        </p>
        <div class="mt-4">
          <a href="/calibration/" class="text-xs font-mono text-[#828fff] hover:underline flex items-center gap-1">Open calibration guide →</a>
        </div>
      </section>

      <!-- Bento 3: Weighting curves -->
      <section class="panel p-6 relative overflow-hidden" data-reveal aria-labelledby="weighting">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#5e6ad2]"></span>
          <span>Weighting</span>
        </div>
        <h3 id="weighting" class="text-xl font-semibold tracking-tight text-white">What A, C and Z weighting mean</h3>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">
          An <strong>A-weighted decibel meter</strong> filters frequencies through the international curve (dBA) to mirror human ear sensitivity, de-emphasizing low rumbles. C-weighting (dBC) captures bass peaks, while Z-weighting (dBZ) stays flat across the spectrum.
        </p>
        <div class="mt-4">
          <a href="/a-weighted-decibel-meter/" class="text-xs font-mono text-[#828fff] hover:underline flex items-center gap-1">A-weighted meter guide →</a>
        </div>
      </section>

      <!-- Bento 4: Understanding numbers -->
      <section class="panel p-6 relative overflow-hidden" data-reveal aria-labelledby="understand">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#828fff]"></span>
          <span>Acoustic Metrics</span>
        </div>
        <h3 id="understand" class="text-xl font-semibold tracking-tight text-white">Understanding your measurement</h3>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">
          Raw digital readings (dBFS) are negative because full scale is zero. This meter adds a nominal 100 dB offset to display an immediate estimated environmental scale: a quiet bedroom is around 30&nbsp;dBA and conversational speech near 60&nbsp;dBA.
        </p>
        <div class="mt-4">
          <a href="/decibel-chart/" class="text-xs font-mono text-[#828fff] hover:underline flex items-center gap-1">Decibel comparison chart →</a>
        </div>
      </section>

      <!-- Bento 5: Accuracy -->
      <section class="panel p-6 relative overflow-hidden" data-reveal aria-labelledby="acc">
        <div class="flex items-center gap-2 text-xs font-mono text-[#828fff] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#5e6ad2]"></span>
          <span>Precision</span>
        </div>
        <h3 id="acc" class="text-xl font-semibold tracking-tight text-white">Browser measurement accuracy</h3>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">
          Consumer phone and laptop microphones have unknown gain profiles and internal DSP compression. Calibrating with a steady tone narrows error to ±2–4 dBA for everyday guidance. For legal or OSHA compliance, always use a calibrated Type 1/2 sound level meter.
        </p>
        <div class="mt-4">
          <a href="/accuracy/" class="text-xs font-mono text-[#828fff] hover:underline flex items-center gap-1">Accuracy guide →</a>
        </div>
      </section>

      <!-- Bento 6: Privacy -->
      <section class="panel p-6 lg:col-span-3 relative overflow-hidden" data-reveal aria-labelledby="privacy-home">
        <div class="flex items-center gap-2 text-xs font-mono text-[#27a644] mb-2 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#27a644]"></span>
          <span>100% On-Device</span>
        </div>
        <h3 id="privacy-home" class="text-xl font-semibold tracking-tight text-white">Microphone privacy</h3>
        <p class="text-[14px] leading-6 mt-2 text-[#8a8f98]">
          All audio blocks are processed in your device's memory via Web Audio worklets. Zero sound recordings, audio streams, or raw voice data are ever transmitted to any external server.
        </p>
        <div class="mt-4">
          <a href="/privacy/" class="text-xs font-mono text-[#828fff] hover:underline flex items-center gap-1">Microphone privacy policy →</a>
        </div>
      </section>
    </div>

    <!-- How to use in 3 steps -->
    <section class="panel p-6 mt-4" data-reveal aria-labelledby="steps">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="eyebrow">QUICK START</p>
          <h3 id="steps" class="text-xl font-semibold tracking-tight text-white mt-1">{dict.stepsTitle}</h3>
        </div>
        <a href="/how-to-use/" class="text-xs font-mono text-[#828fff] hover:underline hidden sm:inline">FULL GUIDE →</a>
      </div>
      <ol class="grid gap-3 md:grid-cols-3">
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">01 / PERMISSION</p>
          <h4 class="font-semibold text-white mt-1.5">{dict.step1t}</h4>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step1d}</p>
        </li>
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">02 / LIVE METRICS</p>
          <h4 class="font-semibold text-white mt-1.5">{dict.step2t}</h4>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step2d}</p>
        </li>
        <li class="panel-raised p-4 border border-[#23252a] hover:border-[#34343a] transition-all">
          <p class="font-mono text-xs text-[#828fff] font-semibold">03 / CALIBRATE & EXPORT</p>
          <h4 class="font-semibold text-white mt-1.5">{dict.step3t}</h4>
          <p class="text-sm mt-1 text-[#8a8f98]">{dict.step3d}</p>
        </li>
      </ol>
    </section>

    <!-- FAQ Accordion -->
    <section class="panel p-6 mt-4" data-reveal aria-labelledby="faq">
      <div class="mb-4">
        <p class="eyebrow">QUESTIONS & ANSWERS</p>
        <h3 id="faq" class="text-xl font-semibold tracking-tight text-white mt-1">Common questions</h3>
      </div>
      <div class="grid gap-2">
        {dict.faq.map((f) => (
          <details class="panel-raised px-4 py-1 border border-[#23252a] rounded-lg hover:border-[#34343a] transition-all">
            <summary class="cursor-pointer focus-ring font-medium text-[15px] text-[#f7f8f8]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4 text-[#8a8f98] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Linear Interactive Guides Grid -->
    <section data-reveal aria-labelledby="guides" class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="eyebrow">KNOWLEDGE BASE</p>
          <h3 id="guides" class="text-2xl font-semibold tracking-tight text-white mt-1">Decibel meter guides & acoustic standards</h3>
        </div>
        <a href="/guides/" class="text-xs font-mono text-[#828fff] hover:text-white flex items-center gap-1 transition-colors">
          <span>VIEW ALL GUIDES</span>
          <span>→</span>
        </a>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g, i) => (
          <a href={g.href} class="panel lift p-5 focus-ring block group relative overflow-hidden border border-[#23252a] bg-[#0f1011] hover:border-[#5e6ad2]/50 hover:bg-[#141516] transition-all">
            <div class="flex items-center justify-between text-xs font-mono text-[#8a8f98] mb-2.5">
              <span>0{i + 1 < 10 ? `0${i+1}` : i + 1}</span>
              <span class="text-[#828fff] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">→</span>
            </div>
            <h4 class="font-semibold text-[15px] text-[#f7f8f8] group-hover:text-white transition-colors">{g.t}</h4>
            <p class="text-sm mt-1.5 text-[#8a8f98] line-clamp-2 leading-relaxed">{g.d}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Focused Tools Grid -->
    <section data-reveal aria-labelledby="tools" class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="eyebrow">ACOUSTIC SUITE</p>
          <h3 id="tools" class="text-2xl font-semibold tracking-tight text-white mt-1">Focused audio diagnostics</h3>
        </div>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool, i) => (
          <a href={tool.href} class="panel lift p-5 focus-ring block group relative overflow-hidden border border-[#23252a] bg-[#0f1011] hover:border-[#5e6ad2]/50 hover:bg-[#141516] transition-all">
            <div class="flex items-center justify-between text-xs font-mono text-[#8a8f98] mb-2.5">
              <span>TOOL 0{i + 1}</span>
              <span class="text-[#828fff] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">→</span>
            </div>
            <h4 class="font-semibold text-[15px] text-[#f7f8f8] group-hover:text-white transition-colors">{tool.t}</h4>
            <p class="text-sm mt-1.5 text-[#8a8f98] line-clamp-2 leading-relaxed">{tool.d}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
