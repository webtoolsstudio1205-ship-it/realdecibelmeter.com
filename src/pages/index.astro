---
import Layout from '../components/Layout.astro';
import MeterPanel from '../components/MeterPanel.astro';
import ChecklistPanel from '../components/ChecklistPanel.astro';
import ExposurePanel from '../components/ExposurePanel.astro';
import SpectrumPanel from '../components/SpectrumPanel.astro';
import ComparePanel from '../components/ComparePanel.astro';
import ReportPanel from '../components/ReportPanel.astro';
import SoundLevelGuide from '../components/SoundLevelGuide.astro';
import { getDict } from '../i18n/dictionaries';
import { SITE, webAppJsonLd, faqJsonLd, breadcrumbJsonLd } from '../lib/seo';

const locale = 'en';
const dict = getDict(locale);

const jsonLd = [
  webAppJsonLd({
    name: 'Online Decibel Meter',
    url: `${SITE}/`,
    description: dict.metaDescription,
    inLanguage: 'en',
  }),
  faqJsonLd(dict.faq),
  breadcrumbJsonLd([{ name: 'Home', url: `${SITE}/` }]),
];

const guides = [
  { href: '/calibration/', t: 'Calibration', d: 'Calibrate your microphone with a known reference before trusting dBA estimates.' },
  { href: '/accuracy/', t: 'Browser measurement accuracy', d: 'What browser estimates can and cannot claim — and when to use a certified meter.' },
  { href: '/methodology/', t: 'How the meter works', d: 'RMS, dBFS, weighting, Fast/Slow response and Leq, explained from the real pipeline.' },
  { href: '/decibel-chart/', t: 'Decibel comparison chart', d: 'Understand decibel levels with approximate everyday examples.' },
  { href: '/db-vs-dba/', t: 'dB vs dBA', d: 'What A, C and Z weighting mean and which one to pick.' },
  { href: '/noise-exposure/', t: 'Noise exposure', d: 'Level plus duration: screening bands and the 3 dB exchange rule.' },
  { href: '/phone-decibel-meter/', t: 'Phone decibel meter', d: 'Getting useful readings from iPhone and Android browsers.' },
  { href: '/iphone-decibel-meter/', t: 'iPhone decibel meter', d: 'Free online iPhone meter in Safari — no app install, live dBA.' },
  { href: '/frequency-analyzer/', t: 'Frequency analyzer', d: 'Reading the live spectrum alongside the dB value.' },
  { href: '/sound-level-meter/', t: 'Sound level meters', d: 'Hardware classes versus browser estimates.' },
  { href: '/privacy/', t: 'Microphone privacy', d: 'How local audio processing keeps recordings on your device.' },
  { href: '/faq/', t: 'FAQ', d: 'Short answers on accuracy, calibration, Leq and safe levels.' },
];
const tools = [
  { href: '/microphone-noise-floor-test/', t: 'Microphone noise floor test', d: 'Run a focused 30-second raw dBFS diagnostic.' },
  { href: '/background-noise-test/', t: 'Background noise test', d: 'A simple pause-and-resume workflow with honest calibrated and uncalibrated modes.' },
  { href: '/dbfs-vs-db-spl/', t: 'dBFS vs dB SPL', d: 'Understand why digital microphone levels cannot be converted universally to sound pressure.' },
  { href: '/validation/', t: 'Validation protocol', d: 'Reproducible repeatability checks and current verification status.' },
  { href: '/tone-generator/', t: 'Tone generator', d: 'Play pure test tones with capped volume, in your browser.' },
  { href: '/speaker-test/', t: 'Speaker test', d: 'Check channels, polarity and rattles with a sweep.' },
  { href: '/hearing-age-test/', t: 'Hearing age test', d: 'Find your highest audible pitch. Screening only.' },
  { href: '/noise-exposure-calculator/', t: 'Exposure calculator', d: 'Daily dose from any average level and duration.' },
];
---

<Layout locale={locale} dict={dict} title={dict.metaTitle} description={dict.metaDescription} path="/" jsonLd={jsonLd}>
  <div class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <svg class="hero-wave" viewBox="0 0 1120 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 55 C80 55 92 31 156 31 S248 74 316 56 402 36 468 53 552 78 620 48 704 25 782 55 862 72 930 45 1008 52 1086 63 1120 48 1120 48" />
    </svg>
    <div class="container-x hero-copy">
      <p class="eyebrow anim-rise" style="--d:40ms">{dict.heroEyebrow}</p>
      <h1 class="hero-title mt-2">{dict.heroH1}</h1>
      <p class="hero-sub anim-rise" style="--d:190ms">{dict.heroSub}</p>
      <div class="hero-actions anim-rise" style="--d:240ms">
        <a href="#measure" class="btn-primary focus-ring">{dict.startMeasuring}</a>
        <a href="/accuracy/" class="btn-secondary focus-ring">{dict.howAccuracy}</a>
      </div>
      <ul class="trust-row anim-rise" style="--d:290ms" aria-label="Privacy and compatibility">
        <li>Audio processed locally</li>
        <li>No account required</li>
        <li>Works in your browser</li>
      </ul>
    </div>
  </div>

  <div class="container-x pb-4" style="max-width:1120px">
    <MeterPanel dict={dict} locale={locale} />
    <ChecklistPanel locale={locale} />
    <ExposurePanel locale={locale} />
    <SpectrumPanel locale={locale} />
    <ComparePanel locale={locale} />
    <ReportPanel locale={locale} />
    <p class="mt-3 text-sm" style="color:var(--muted);max-width:78ch">
      Uncalibrated readings are nominal dBA, dBC or dBZ estimates based on a common browser-microphone offset.
      Calibration replaces that default with a device-specific offset for better accuracy.
      This free <a class="underline underline-offset-4 focus-ring" href="/methodology/">online sound meter</a>
      works as a sound level meter and noise level meter for quick checks — not as a certified instrument.
    </p>
    <SoundLevelGuide locale={locale} />
  </div>

  <div class="container-x py-8 grid gap-4" style="max-width:1120px">
    <section class="panel p-6" data-reveal aria-labelledby="measure-browser">
      <h2 id="measure-browser" class="text-xl font-semibold tracking-tight">Measure sound in your browser</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        This online decibel meter reads your microphone through the Web Audio API and shows a live estimated sound level immediately —
        no download, no account. Press <a class="underline underline-offset-4 focus-ring" href="#measure">Start Measuring</a>,
        grant permission once, and watch current, minimum, average and maximum values on the live graph.
        For better device-specific accuracy, <a class="underline underline-offset-4 focus-ring" href="/calibration/">calibrate your microphone</a> against a known reference.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="how">
      <h2 id="how" class="text-xl font-semibold tracking-tight">How the online decibel meter works</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        Each audio block is reduced to an RMS value, converted to a level in dB, corrected for the selected
        frequency weighting, smoothed with Fast (125&nbsp;ms) or Slow (1&nbsp;s) time response, and aggregated into an
        energy-average Leq. Before calibration, a nominal +100 dB offset converts the weighted digital level into a clearly
        labelled estimate; a saved calibration offset replaces it. Read the full <a class="underline underline-offset-4 focus-ring" href="/methodology/">methodology</a>.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="understand">
      <h2 id="understand" class="text-xl font-semibold tracking-tight">Understanding your measurement</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        Raw digital readings (dBFS) are negative because full scale is zero — silence sits near −100 and loud input approaches 0.
        This meter adds a nominal 100 dB offset to show an immediate estimated environmental scale: a quiet bedroom is around
        30&nbsp;dBA and normal conversation near 60&nbsp;dBA. Different devices can still disagree until calibrated.
        See <a class="underline underline-offset-4 focus-ring" href="/decibel-chart/">understand decibel levels</a> for approximate examples.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="cal">
      <h2 id="cal" class="text-xl font-semibold tracking-tight">Calibrating for estimated environmental decibels</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        Every microphone has different gain, so calibration is required before any dBA number can be trusted.
        Place the device where you will measure, play or compare a stable reference of known level, enter the difference as an
        offset, and keep the same microphone, position and settings. Profiles are device-specific and stop applying when the
        setup changes. Follow the <a class="underline underline-offset-4 focus-ring" href="/calibration/">calibration guide</a>.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="weighting">
      <h2 id="weighting" class="text-xl font-semibold tracking-tight">What A, C and Z weighting mean</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        Sound-level weighting shapes which frequencies count most. A-weighting (dBA) approximates human hearing and is the
        default for everyday checks; C-weighting (dBC) stays flatter near loud peaks; Z-weighting (dBZ) counts all frequencies
        equally. Fast response follows peaks, Slow smooths them. Compare them in
        <a class="underline underline-offset-4 focus-ring" href="/db-vs-dba/"> dB vs dBA</a>.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="acc">
      <h2 id="acc" class="text-xl font-semibold tracking-tight">Browser measurement accuracy</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">{dict.accBody}</p>
      <p class="mt-3"><a href="/accuracy/" class="focus-ring underline underline-offset-4 text-sm">Read the full browser measurement accuracy guide →</a></p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="privacy-home">
      <h2 id="privacy-home" class="text-xl font-semibold tracking-tight">Microphone privacy</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:75ch">
        The browser processes microphone samples locally and this site uploads no recordings. Google Analytics receives
        standard site-usage data, never microphone samples. Saved session history stays in this browser. Details in
        <a class="underline underline-offset-4 focus-ring" href="/privacy/">microphone privacy</a>.
      </p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="steps">
      <h2 id="steps" class="text-xl font-semibold tracking-tight">{dict.stepsTitle}</h2>
      <ol class="mt-4 grid gap-4 md:grid-cols-3">
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">01</p><h3 class="font-semibold mt-1">{dict.step1t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step1d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">02</p><h3 class="font-semibold mt-1">{dict.step2t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step2d}</p></li>
        <li class="panel-raised p-4"><p class="font-mono text-xs" style="color:var(--muted)">03</p><h3 class="font-semibold mt-1">{dict.step3t}</h3><p class="text-sm mt-1" style="color:var(--muted)">{dict.step3d}</p></li>
      </ol>
      <p class="mt-3 text-sm" style="color:var(--muted)">New here? Read <a class="underline underline-offset-4 focus-ring" href="/how-to-use/">how to use the meter</a> or fix <a class="underline underline-offset-4 focus-ring" href="/microphone-not-working/">microphone problems</a>.</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="trouble">
      <h2 id="trouble" class="text-xl font-semibold tracking-tight">{dict.troubleTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.troubleBody}</p>
      <p class="mt-3"><a href="/microphone-not-working/" class="focus-ring underline underline-offset-4 text-sm">Microphone troubleshooting →</a></p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="sess">
      <h2 id="sess" class="text-xl font-semibold tracking-tight">{dict.sessionTitle}</h2>
      <p class="text-[15px] leading-7 mt-2" style="color:var(--muted);max-width:70ch">{dict.sessionBody}</p>
    </section>

    <section class="panel p-6" data-reveal aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-semibold tracking-tight">Common questions</h2>
      <div class="mt-3 grid gap-2">
        {dict.faq.map((f) => (
          <details class="panel-raised px-4" style="border-radius:10px">
            <summary class="cursor-pointer focus-ring font-medium text-[15px]" style="min-height:44px;display:flex;align-items:center">{f.q}</summary>
            <p class="text-sm pb-4" style="color:var(--muted)">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section data-reveal aria-labelledby="guides">
      <h2 id="guides" class="text-xl font-semibold tracking-tight">Decibel meter guides</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => (
          <a href={g.href} class="panel lift p-4 focus-ring block hover:opacity-90">
            <h3 class="font-semibold text-[15px]">{g.t}</h3>
            <p class="text-sm mt-1" style="color:var(--muted)">{g.d}</p>
          </a>
        ))}
      </div>
      <p class="mt-3 text-sm" style="color:var(--muted)">Browse the full <a class="underline underline-offset-4 focus-ring" href="/guides/">sound-measurement guide hub</a>.</p>
    </section>

    <section data-reveal aria-labelledby="tools">
      <h2 id="tools" class="text-xl font-semibold tracking-tight">Focused sound tests</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <a href={tool.href} class="panel lift p-4 focus-ring block hover:opacity-90">
            <h3 class="font-semibold text-[15px]">{tool.t}</h3>
            <p class="text-sm mt-1" style="color:var(--muted)">{tool.d}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
