---
import type { Dict, Locale } from '../i18n/dictionaries';
import { LOCALES } from '../i18n/dictionaries';
import { SITE, homepageHreflang, ogLocaleFor } from '../lib/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  dict: Dict;
  title: string;
  description: string;
  path: string;
  robots?: string;
  hreflang?: { hreflang: string; href: string }[];
  jsonLd?: Record<string, unknown>[];
  ogType?: string;
}

const { locale, dict, title, description, path } = Astro.props;
const robots = Astro.props.robots ?? 'index, follow';
const ogType = Astro.props.ogType ?? 'website';
const canonical = `${SITE}${path}`;
const pagePath = path.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/';
const KNOWN = ['/', '/accuracy/', '/calibration/', '/methodology/', '/how-to-use/', '/microphone-not-working/', '/decibel-chart/', '/db-vs-dba/', '/about/', '/contact/', '/privacy/', '/terms/', '/guides/'];
const isKnown = KNOWN.indexOf(pagePath) !== -1;
const isHome = pagePath === '/';
function langHref(code: Locale, base: string): string {
  // Only homepages exist in every locale; guide pages fall back to the locale homepage
  // so the switcher never links to a non-existent equivalent path.
  if (!isKnown) return base;
  if (pagePath === '/') {
    if (code === 'en') return pagePath;
    return base;
  }
  return base;
}
// hreflang: full reciprocal cluster on homepages; self-only elsewhere (guides are en-only).
const hreflangs = Astro.props.hreflang ?? (isHome ? homepageHreflang() : [{ hreflang: locale === 'en' ? 'en' : locale, href: canonical }]);
const ogLocale = ogLocaleFor(locale as 'en' | 'de' | 'it' | 'ja' | 'es' | 'fr' | 'pt' | 'ko');
const jsonLdBlocks = Astro.props.jsonLd ?? [];
const currentNative = LOCALES.find((l) => l.code === locale)?.native ?? 'English';
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const measureHref = locale === 'en' ? '/#measure' : `/${locale}/#measure`;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.hreflang} href={h.href} />
    ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Real Decibel Meter" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://realdecibelmeter.com/og-image.svg" />
    <meta property="og:image:alt" content="Real Decibel Meter — browser sound level meter" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <script is:inline>
      try {
        var t = localStorage.getItem('rdm-theme');
        if (!t) t = 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:px-3 focus:py-2 focus:rounded-md focus-ring" style="background:var(--raised);border:1px solid var(--border)">Skip to content</a>
    <header class="site-header sticky top-0 z-40" style="height:64px;background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)">
      <div class="container-x flex items-center gap-3" style="height:64px">
        <a href={homeHref} class="brand focus-ring" aria-label="Real Decibel Meter home">
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect class="bm-b1" x="2" y="13" width="3.5" height="6" rx="1.75" fill="currentColor" opacity="0.45"/>
            <rect class="bm-b2" x="7.5" y="9" width="3.5" height="14" rx="1.75" fill="currentColor" opacity="0.65"/>
            <rect class="bm-b3" x="13" y="5" width="3.5" height="22" rx="1.75" fill="currentColor"/>
            <rect class="bm-b4" x="18.5" y="10" width="3.5" height="12" rx="1.75" fill="#3B82F6"/>
            <rect class="bm-b5" x="24" y="14" width="3.5" height="4" rx="1.75" fill="currentColor" opacity="0.5"/>
          </svg>
          <span class="brand-text font-semibold tracking-tight text-[15px]">Real Decibel Meter</span>
        </a>
        <nav class="ml-auto hidden md:flex items-center gap-1" aria-label="Primary">
          <a href={measureHref} class="nav-link px-3 py-2 rounded-full text-sm focus-ring" style="color:var(--muted)">{dict.navMeasure}</a>
          <a href={locale === 'en' ? '/guides/' : homeHref} class="nav-link px-3 py-2 rounded-full text-sm focus-ring" style="color:var(--muted)">{dict.navGuides}</a>
        </nav>
        <div class="ml-auto md:ml-0 flex items-center gap-2">
          <div class="lang" style="position:relative">
            <button id="lang-btn" type="button" class="btn-square focus-ring lang-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="lang-menu" title="Language">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>
              <span id="lang-current" class="text-sm font-medium hidden sm:inline">{currentNative}</span>
              <svg class="lang-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <ul id="lang-menu" role="menu" aria-label="Language" hidden>
              {LOCALES.map((l) => (
                <li role="none">
                  <a role="menuitemradio" aria-checked={l.code === locale ? 'true' : 'false'} class="focus-ring" href={langHref(l.code, l.path)} hreflang={l.code === 'en' ? 'en' : l.code}>
                    <span>{l.native}</span>
                    {l.code === locale && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <button id="theme-toggle" type="button" class="btn-square focus-ring theme-btn" style="min-width:44px;padding:0 10px" aria-label="Toggle theme" title="Toggle theme">
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icon-sun hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button id="menu-btn" type="button" class="btn-square focus-ring md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" style="min-width:44px;padding:0 10px">
            <svg class="burger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="bl1" d="M3 6h18"/><path class="bl2" d="M3 12h18"/><path class="bl3" d="M3 18h18"/></svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden md:hidden overflow-y-auto" style="background:var(--surface);border-bottom:1px solid var(--border);max-height:calc(100vh - 64px)">
        <nav class="container-x py-3 flex flex-col gap-1" aria-label="Mobile">
          <a href={measureHref} class="px-3 py-3 rounded-lg text-[15px] focus-ring" style="border:1px solid transparent">{dict.navMeasure}</a>
          <a href={locale === 'en' ? '/guides/' : homeHref} class="px-3 py-3 rounded-lg text-[15px] focus-ring">{dict.navGuides}</a>
          <a href="/accuracy/" class="px-3 py-3 rounded-lg text-[15px] focus-ring" style="color:var(--muted)">Accuracy</a>
          <a href="/calibration/" class="px-3 py-3 rounded-lg text-[15px] focus-ring" style="color:var(--muted)">Calibration</a>
          <a href="/decibel-chart/" class="px-3 py-3 rounded-lg text-[15px] focus-ring" style="color:var(--muted)">Decibel chart</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer style="border-top:1px solid var(--border);background:var(--surface)">
      <div class="container-x py-12 grid gap-8 md:grid-cols-4">
        <div>
          <p class="font-semibold text-[15px]">Real Decibel Meter</p>
          <p class="text-sm mt-2" style="color:var(--muted)">{dict.footerNote}</p>
        </div>
        <nav aria-label="Measure">
          <p class="eyebrow mb-3">Measure</p>
          <ul class="space-y-2 text-sm">
            <li><a class="focus-ring underline-offset-4 hover:underline" href={measureHref}>{dict.navMeasure}</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/accuracy/">Accuracy</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/calibration/">Calibration</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/methodology/">Methodology</a></li>
          </ul>
        </nav>
        <nav aria-label="Guides">
          <p class="eyebrow mb-3">{dict.navGuides}</p>
          <ul class="space-y-2 text-sm">
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/how-to-use/">How to use</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/decibel-chart/">Decibel chart</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/db-vs-dba/">dB vs dBA</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/microphone-not-working/">Microphone help</a></li>
          </ul>
        </nav>
        <nav aria-label="Site">
          <p class="eyebrow mb-3">Site</p>
          <ul class="space-y-2 text-sm">
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/about/">About</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/contact/">Contact</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/privacy/">Privacy</a></li>
            <li><a class="focus-ring underline-offset-4 hover:underline" href="/terms/">Terms</a></li>
          </ul>
        </nav>
      </div>
      <div style="border-top:1px solid var(--border)">
        <div class="container-x py-4 flex flex-wrap gap-2 items-center text-xs" style="color:var(--muted)">
          <span>© {new Date().getFullYear()} Real Decibel Meter. {dict.footerRights}</span>
          <span class="ml-auto flex flex-wrap gap-2" aria-label="Languages">
            {LOCALES.map((l) => (
              <a class="focus-ring underline-offset-4 hover:underline" href={l.path} hreflang={l.code}>{l.native}</a>
            ))}
          </span>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        /* Theme */
        var themeBtn = document.getElementById('theme-toggle');
        function paint() {
          var light = root.getAttribute('data-theme') === 'light';
          var themeMeta = document.getElementById('theme-color');
          if (themeMeta) themeMeta.setAttribute('content', light ? '#ffffff' : '#08090b');
          var moons = document.querySelectorAll('.icon-moon');
          var suns = document.querySelectorAll('.icon-sun');
          for (var i = 0; i < moons.length; i++) moons[i].classList.toggle('hidden', light);
          for (var j = 0; j < suns.length; j++) suns[j].classList.toggle('hidden', !light);
        }
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('rdm-theme', next); } catch (e) {}
            paint();
          });
        }
        paint();

        /* Language menu */
        var langBtn = document.getElementById('lang-btn');
        var langMenu = document.getElementById('lang-menu');
        function langOpen() { return !!langMenu && !langMenu.hasAttribute('hidden'); }
        function setLang(open, focusFirst) {
          if (!langMenu || !langBtn) return;
          if (open) {
            langMenu.removeAttribute('hidden');
            langBtn.setAttribute('aria-expanded', 'true');
            if (focusFirst) {
              var first = langMenu.querySelector('a');
              if (first) first.focus();
            }
          } else {
            langMenu.setAttribute('hidden', '');
            langBtn.setAttribute('aria-expanded', 'false');
          }
        }
        if (langBtn && langMenu) {
          langBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            setLang(!langOpen(), false);
          });
          langBtn.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
              if (!langOpen()) { e.preventDefault(); setLang(true, true); }
            }
          });
          langMenu.addEventListener('keydown', function (e) {
            var items = Array.prototype.slice.call(langMenu.querySelectorAll('a'));
            var idx = items.indexOf(document.activeElement);
            if (e.key === 'ArrowDown') { e.preventDefault(); (items[idx + 1] || items[0]).focus(); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); (items[idx - 1] || items[items.length - 1]).focus(); }
            else if (e.key === 'Escape') { setLang(false, false); langBtn.focus(); }
            else if (e.key === 'Tab') { setLang(false, false); }
          });
          document.addEventListener('click', function (e) {
            if (langOpen() && !e.target.closest('.lang')) setLang(false, false);
          });
        }

        /* Mobile menu */
        var menuBtn = document.getElementById('menu-btn');
        var menu = document.getElementById('mobile-menu');
        var lastFocus = null;
        function closeMenu(returnFocus) {
          if (!menu || menu.classList.contains('hidden')) return;
          menu.classList.add('hidden');
          menu.classList.remove('open');
          if (menuBtn) { menuBtn.setAttribute('aria-expanded', 'false'); menuBtn.classList.remove('active'); }
          document.body.style.overflow = '';
          if (returnFocus && lastFocus) lastFocus.focus();
        }
        if (menuBtn && menu) {
          menuBtn.addEventListener('click', function () {
            var open = menu.classList.contains('hidden');
            if (open) {
              lastFocus = document.activeElement;
              menu.classList.remove('hidden');
              requestAnimationFrame(function () { menu.classList.add('open'); });
              menuBtn.setAttribute('aria-expanded', 'true');
              menuBtn.classList.add('active');
              var first = menu.querySelector('a');
              if (first) first.focus();
            } else {
              closeMenu(true);
            }
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeMenu(true);
              if (langOpen()) { setLang(false, false); if (langBtn) langBtn.focus(); }
            }
          });
          menu.addEventListener('click', function (e) {
            if (e.target && e.target.closest('a')) closeMenu(false);
          });
        }

        /* Scroll reveal */
        var revealEls = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window && revealEls.length) {
          var io = new IntersectionObserver(function (entries) {
            for (var k = 0; k < entries.length; k++) {
              var en = entries[k];
              if (en.isIntersecting) {
                en.target.classList.add('in');
                io.unobserve(en.target);
              }
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -8px 0px' });
          for (var m = 0; m < revealEls.length; m++) io.observe(revealEls[m]);
          window.addEventListener('pagehide', function () { io.disconnect(); }, { once: true });
        } else {
          for (var n = 0; n < revealEls.length; n++) revealEls[n].classList.add('in');
        }
      })();
    </script>
  </body>
</html>
