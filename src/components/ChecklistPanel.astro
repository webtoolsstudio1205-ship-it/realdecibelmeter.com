---
import type { Locale } from '../i18n/dictionaries';
import { getFeatures } from '../i18n/features';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const f = getFeatures(locale);
---
<!-- Dismissible pre-measurement checklist. Remembered locally; reopenable. -->
<section id="rdm-checklist" class="panel mt-4 p-5 sm:p-6" aria-labelledby="rdm-checklist-title" hidden>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="eyebrow">{f.checklistTitle}</p>
      <h2 id="rdm-checklist-title" class="mt-1 text-lg font-semibold tracking-tight">{f.checklistTitle}</h2>
      <p class="mt-1 text-sm" style="color:var(--muted)">{f.checklistIntro}</p>
    </div>
    <button id="rdm-checklist-dismiss" type="button" class="btn-square focus-ring" style="min-height:44px">{f.checklistDismiss}</button>
  </div>
  <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
    {f.checklistItems.map((item) => (
      <li class="panel-raised p-3 leading-6">{item}</li>
    ))}
  </ul>
</section>
<div id="rdm-checklist-reopen-wrap" class="mt-4" hidden>
  <button id="rdm-checklist-reopen" type="button" class="btn-secondary focus-ring">{f.checklistReopen}</button>
</div>

<script>
  const KEY = 'rdm.checklist-dismissed.v1';
  const panel = document.getElementById('rdm-checklist');
  const reopenWrap = document.getElementById('rdm-checklist-reopen-wrap');
  const dismissBtn = document.getElementById('rdm-checklist-dismiss');
  const reopenBtn = document.getElementById('rdm-checklist-reopen');

  function readDismissed() {
    try {
      return window.localStorage.getItem(KEY) === '1';
    } catch {
      // Blocked/full storage must never crash the meter.
      return true;
    }
  }

  function writeDismissed() {
    try {
      window.localStorage.setItem(KEY, '1');
    } catch { /* best effort */ }
  }

  function clearDismissed() {
    try {
      window.localStorage.removeItem(KEY);
    } catch { /* best effort */ }
  }

  function paint() {
    const dismissed = readDismissed();
    if (panel) panel.hidden = dismissed;
    if (reopenWrap) reopenWrap.hidden = !dismissed;
  }

  dismissBtn?.addEventListener('click', () => { writeDismissed(); paint(); reopenBtn?.focus(); });
  reopenBtn?.addEventListener('click', () => { clearDismissed(); paint(); panel?.querySelector('button, summary, [href]')?.focus?.(); });
  paint();
</script>
