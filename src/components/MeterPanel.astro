              <div><dt style="color:var(--muted)">{dict.ui.minimum}</dt><dd id="rdm-d-min" class="tabular">--</dd></div>
              <div><dt style="color:var(--muted)">{dict.ui.digitalAverage}</dt><dd id="rdm-d-avg" class="tabular">--</dd></div>
              <div><dt style="color:var(--muted)">{dict.ui.maximum}</dt><dd id="rdm-d-max" class="tabular">--</dd></div>
              <div><dt style="color:var(--muted)">{dict.ui.digitalPeak}</dt><dd id="rdm-d-peak" class="tabular">--</dd></div>
            </dl>
            <svg id="rdm-diagnostic-graph" viewBox="0 0 600 120" class="w-full mt-3" style="height:120px;display:block" role="img" aria-label={dict.ui.diagnosticsGraph} preserveAspectRatio="none">
              <path id="rdm-diagnostic-path" d="" fill="none" stroke="url(#rdm-edge)" stroke-width="2" />
