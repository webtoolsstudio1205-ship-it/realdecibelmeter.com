---
import type { Dict, Locale } from '../i18n/dictionaries';
import { getFeatures } from '../i18n/features';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;

const CAL_COPY: Record<Locale, {
  intro: string;
  captureTitle: string;
  captureBody: string;
  referenceTitle: string;
  referenceBody: string;
  reviewTitle: string;
  reviewBody: string;
  recommended: string;
  previewTitle: string;
  previewWaiting: string;
  previewTemplate: string;
}> = {
  en: { intro: 'Use a trusted sound-level reference. The browser measures the same steady sound, then calculates the device-specific correction.', captureTitle: 'Capture', captureBody: 'Run the meter and capture a steady reference sound.', referenceTitle: 'Enter reference', referenceBody: 'Type the dBA shown by the trusted meter at the same position.', reviewTitle: 'Review and save', reviewBody: 'Check the calculated correction, method and profile name.', recommended: 'recommended', previewTitle: 'Calculated correction', previewWaiting: 'Complete a reference capture and enter the trusted meter reading to preview the correction.', previewTemplate: '{reference} dBA reference − {measured} dBFS captured = {offset} dB correction' },
  de: { intro: 'Verwenden Sie eine verlässliche Schallpegel-Referenz. Der Browser erfasst denselben konstanten Schall und berechnet daraus die gerätespezifische Korrektur.', captureTitle: 'Erfassen', captureBody: 'Messung starten und einen konstanten Referenzschall erfassen.', referenceTitle: 'Referenz eingeben', referenceBody: 'Den dBA-Wert des Referenzgeräts an derselben Position eingeben.', reviewTitle: 'Prüfen und speichern', reviewBody: 'Berechnete Korrektur, Methode und Profilnamen kontrollieren.', recommended: 'empfohlen', previewTitle: 'Berechnete Korrektur', previewWaiting: 'Referenz erfassen und den Wert des Messgeräts eingeben, um die Korrektur zu prüfen.', previewTemplate: '{reference} dBA Referenz − {measured} dBFS erfasst = {offset} dB Korrektur' },
  it: { intro: 'Usa un riferimento affidabile. Il browser acquisisce lo stesso suono stabile e calcola la correzione specifica del dispositivo.', captureTitle: 'Acquisisci', captureBody: 'Avvia il misuratore e acquisisci un suono di riferimento stabile.', referenceTitle: 'Inserisci il riferimento', referenceBody: 'Digita il valore dBA del fonometro affidabile nella stessa posizione.', reviewTitle: 'Controlla e salva', reviewBody: 'Verifica correzione, metodo e nome del profilo.', recommended: 'consigliato', previewTitle: 'Correzione calcolata', previewWaiting: 'Acquisisci il riferimento e inserisci la lettura affidabile per vedere la correzione.', previewTemplate: '{reference} dBA di riferimento − {measured} dBFS acquisiti = correzione di {offset} dB' },
  ja: { intro: '信頼できる騒音計を基準にします。同じ安定した音をブラウザで取得し、端末固有の補正値を計算します。', captureTitle: '取得', captureBody: '測定を開始し、安定した基準音を取得します。', referenceTitle: '基準値を入力', referenceBody: '同じ位置に置いた基準騒音計のdBA値を入力します。', reviewTitle: '確認して保存', reviewBody: '補正値、方法、プロファイル名を確認します。', recommended: '推奨', previewTitle: '計算された補正値', previewWaiting: '基準音を取得し、騒音計の値を入力すると補正値を確認できます。', previewTemplate: '基準 {reference} dBA − 取得値 {measured} dBFS = 補正 {offset} dB' },
  es: { intro: 'Usa un sonómetro de referencia fiable. El navegador captura el mismo sonido estable y calcula la corrección específica del dispositivo.', captureTitle: 'Captura', captureBody: 'Inicia el medidor y captura un sonido de referencia estable.', referenceTitle: 'Introduce la referencia', referenceBody: 'Escribe el valor dBA del sonómetro fiable en la misma posición.', reviewTitle: 'Revisa y guarda', reviewBody: 'Comprueba la corrección, el método y el nombre del perfil.', recommended: 'recomendado', previewTitle: 'Corrección calculada', previewWaiting: 'Captura la referencia e introduce la lectura fiable para ver la corrección.', previewTemplate: '{reference} dBA de referencia − {measured} dBFS capturados = corrección de {offset} dB' },
  fr: { intro: 'Utilisez un sonomètre de référence fiable. Le navigateur mesure le même son stable puis calcule la correction propre à l’appareil.', captureTitle: 'Capturer', captureBody: 'Lancez le sonomètre et capturez un son de référence stable.', referenceTitle: 'Saisir la référence', referenceBody: 'Saisissez la valeur dBA du sonomètre fiable placé au même endroit.', reviewTitle: 'Vérifier et enregistrer', reviewBody: 'Contrôlez la correction, la méthode et le nom du profil.', recommended: 'recommandé', previewTitle: 'Correction calculée', previewWaiting: 'Capturez la référence et saisissez la valeur fiable pour prévisualiser la correction.', previewTemplate: '{reference} dBA de référence − {measured} dBFS capturés = correction de {offset} dB' },
  pt: { intro: 'Use um medidor de referência fiável. O navegador capta o mesmo som estável e calcula a correção específica do dispositivo.', captureTitle: 'Capturar', captureBody: 'Inicie o medidor e capture um som de referência estável.', referenceTitle: 'Introduzir referência', referenceBody: 'Digite o valor dBA do medidor fiável na mesma posição.', reviewTitle: 'Rever e guardar', reviewBody: 'Confirme a correção, o método e o nome do perfil.', recommended: 'recomendado', previewTitle: 'Correção calculada', previewWaiting: 'Capture a referência e introduza a leitura fiável para ver a correção.', previewTemplate: '{reference} dBA de referência − {measured} dBFS captados = correção de {offset} dB' },
  ko: { intro: '신뢰할 수 있는 소음계를 기준으로 사용하세요. 브라우저가 같은 안정된 소리를 측정한 뒤 기기별 보정값을 계산합니다.', captureTitle: '캡처', captureBody: '측정을 시작하고 안정된 기준음을 캡처합니다.', referenceTitle: '기준값 입력', referenceBody: '같은 위치에 둔 기준 소음계의 dBA 값을 입력합니다.', reviewTitle: '검토 후 저장', reviewBody: '계산된 보정값, 방법, 프로파일 이름을 확인합니다.', recommended: '권장', previewTitle: '계산된 보정값', previewWaiting: '기준음을 캡처하고 소음계 측정값을 입력하면 보정값을 미리 볼 수 있습니다.', previewTemplate: '기준 {reference} dBA − 캡처 {measured} dBFS = 보정 {offset} dB' },
};

const calCopy = CAL_COPY[locale] ?? CAL_COPY.en;
const featureCopy = getFeatures(locale);
---

<section id="measure" aria-label={dict.liveRegion} class="scroll-mt-20" data-st-idle={dict.statusIdle} data-st-req={dict.statusRequesting} data-st-run={dict.statusRunning} data-st-pause={dict.statusPaused} data-st-stop={dict.statusStopped} data-st-err={dict.statusError} data-p-unknown={dict.permUnknown} data-p-granted={dict.permGranted} data-p-denied={dict.permDenied} data-p-prompt={dict.permPrompt} data-cal-u={dict.calibrationUncal} data-cal-c={dict.calibrationCal} data-cal-required={dict.statusCalRequired} data-input-strength={dict.inputStrength} data-duration={dict.statDuration} data-resp-fast={dict.respFast} data-resp-slow={dict.respSlow} data-mic-default={dict.micDefault}>
  <script id="rdm-ui-strings" type="application/json" set:html={JSON.stringify(dict.ui)} />
  <script id="rdm-cal-strings" type="application/json" set:html={JSON.stringify(calCopy)} />
  <script id="rdm-feature-strings" type="application/json" set:html={JSON.stringify(featureCopy)} />
  <h2 class="sr-only">{dict.navMeasure}</h2>
  <div id="rdm-panel" class="panel meter-card p-4 sm:p-6 md:p-8" data-live="false" data-state="idle">
    <div id="rdm-announcer" class="sr-only" role="status" aria-live="polite"></div>

    <div class="flex flex-wrap items-center gap-2" aria-label={dict.ui.status}>
      <span class="chip chip-1 inline-flex items-center gap-2 text-[13px] font-medium rounded-full px-3 py-1.5" style="border:1px solid var(--border);background:var(--raised)">
        <span id="rdm-state-dot" class="inline-block rounded-full" style="width:8px;height:8px;background:var(--muted)" aria-hidden="true"></span>
        <span id="rdm-state-text">{dict.statusIdle}</span>
      </span>
      <span id="rdm-cal-badge" class="chip chip-2 inline-flex items-center gap-2 text-[13px] rounded-full px-3 py-1.5" style="border:1px solid var(--border);color:var(--muted)">
        {dict.calibrationUncal}
      </span>
      <span class="chip chip-3 inline-flex items-center gap-2 text-[13px] rounded-full px-3 py-1.5" style="border:1px solid var(--border);color:var(--muted)">
        <span>{dict.micPermission}: </span><strong id="rdm-perm-text" class="font-semibold">{dict.permUnknown}</strong>
      </span>
    </div>

    <div class="meter-shell">
      <div class="meter-wrap">
      <div class="rdm-grid-bg" aria-hidden="true"></div>
      <p id="rdm-view-label" class="eyebrow meter-eyebrow">{dict.ui.estimatedSound}</p>

      <svg id="rdm-gauge" viewBox="0 0 320 196" role="img" aria-label={dict.ui.gauge}>
        <defs>
          <linearGradient id="rdm-arc-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#22D3EE" />
            <stop offset="0.5" stop-color="#3B82F6" />
            <stop offset="1" stop-color="#8B5CF6" />
          </linearGradient>
        </defs>
        <path d="M 24 172 A 136 136 0 0 1 296 172" fill="none" stroke="currentColor" opacity="0.14" stroke-width="14" stroke-linecap="round" />
        <path id="rdm-arc" d="M 24 172 A 136 136 0 0 1 296 172" fill="none" stroke="url(#rdm-arc-grad)" stroke-width="14" stroke-linecap="round" stroke-dasharray="428" stroke-dashoffset="428" />
        <g id="rdm-ticks" class="tabular" style="font-size:11px;fill:var(--muted)">
          <text id="rdm-tick-lo" x="24" y="192" text-anchor="start">20</text>
          <text id="rdm-tick-mid" x="160" y="192" text-anchor="middle">70</text>
          <text id="rdm-tick-hi" x="296" y="192" text-anchor="end">120</text>
        </g>
      </svg>
      <div id="rdm-gauge-glow" aria-hidden="true"></div>

      <div id="rdm-halo" class="big-halo flex items-baseline justify-center gap-3 mt-1" data-live="false" style="isolation:isolate">
        <span id="rdm-big" class="tabular font-semibold tracking-tight" style="font-size:clamp(56px,12vw,92px);line-height:1" aria-live="off">--</span>
        <span id="rdm-unit" class="text-sm font-medium" style="color:var(--muted)">dBA</span>
      </div>
      <p id="rdm-mode-status" class="meter-status">{dict.statusCalRequired}</p>
      <button id="rdm-cta-cal" type="button" class="btn-secondary focus-ring mt-4">{dict.calibrateCta}</button>
      </div>

      <div class="meter-controls flex flex-wrap justify-center gap-2" role="group" aria-label={dict.ui.transport}>
        <button id="rdm-start" type="button" class="btn-primary focus-ring grad-edge">{dict.btnStartMeasuring}</button>
        <button id="rdm-req" type="button" class="btn-primary focus-ring" disabled hidden>
          <svg class="mic-pulse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3"/></svg>
          <span id="rdm-req-text">{dict.statusRequesting}</span>
        </button>
        <button id="rdm-stab" type="button" class="btn-primary focus-ring" disabled hidden>
          <svg class="mic-pulse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3"/></svg>
          <span>{dict.ui.stabilizing}</span>
        </button>
        <button id="rdm-cancel" type="button" class="btn-secondary focus-ring" hidden>{dict.btnCancel}</button>
        <button id="rdm-pause" type="button" class="btn-square focus-ring" hidden>{dict.btnPause}</button>
        <button id="rdm-resume" type="button" class="btn-square focus-ring" hidden>{dict.btnResume}</button>
        <button id="rdm-stop" type="button" class="btn-square focus-ring" hidden>{dict.btnStop}</button>
        <button id="rdm-start-new" type="button" class="btn-primary focus-ring grad-edge" hidden>{dict.btnStartNew}</button>
        <button id="rdm-save" type="button" class="btn-secondary focus-ring" hidden>{dict.btnSave}</button>
        <button id="rdm-reset" type="button" class="btn-square focus-ring" hidden>{dict.btnReset}</button>
        <button id="rdm-retry" type="button" class="btn-square focus-ring" hidden>{dict.btnRetry}</button>
        <button id="rdm-dismiss" type="button" class="btn-square focus-ring" hidden>{dict.btnDismiss}</button>
        <button id="rdm-customize" type="button" class="btn-secondary focus-ring">{dict.btnCustomize}</button>
      </div>

      <dl id="rdm-stats" class="stats-grid meter-stats">
        <div class="panel-raised p-3"><dt id="rdm-l1" class="eyebrow">{dict.ui.currentStrength}</dt><dd id="rdm-s1" class="tabular text-2xl font-semibold mt-1">--</dd></div>
        <div class="panel-raised p-3"><dt id="rdm-l2" class="eyebrow">{dict.ui.averageStrength}</dt><dd id="rdm-s2" class="tabular text-2xl font-semibold mt-1">--</dd></div>
        <div class="panel-raised p-3"><dt id="rdm-l3" class="eyebrow">{dict.ui.peakStrength}</dt><dd id="rdm-s3" class="tabular text-2xl font-semibold mt-1">--</dd></div>
        <div class="panel-raised p-3"><dt id="rdm-l4" class="eyebrow">{dict.statDuration}</dt><dd id="rdm-s4" class="tabular text-2xl font-semibold mt-1">00:00</dd></div>
        <div id="rdm-stat-5" class="panel-raised p-3" hidden><dt id="rdm-l5" class="eyebrow">{dict.statDuration}</dt><dd id="rdm-s5" class="tabular text-2xl font-semibold mt-1">00:00</dd></div>
      </dl>
    </div>
    <p id="rdm-save-msg" class="text-xs text-center mt-2" style="color:var(--muted)" role="status"></p>

    <section id="rdm-quality" class="mt-6 panel-raised p-4" aria-labelledby="rdm-quality-title">
      <h3 id="rdm-quality-title" class="eyebrow mb-2">{dict.ui.quality}</h3>
      <dl class="text-sm grid gap-x-4 gap-y-1 sm:grid-cols-2">
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.overall}</dt><dd id="rdm-q-overall" class="tabular text-right font-medium">{dict.ui.ready}</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.calibration}</dt><dd id="rdm-q-cal" class="tabular text-right">{dict.ui.notCalibrated}</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.signal}</dt><dd id="rdm-q-signal" class="tabular text-right">—</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.browserProcessing}</dt><dd id="rdm-q-proc" class="tabular text-right">—</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.sampleRate}</dt><dd id="rdm-q-rate" class="tabular text-right">—</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.channels}</dt><dd id="rdm-q-chan" class="tabular text-right">—</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.activeDuration}</dt><dd id="rdm-q-dur" class="tabular text-right">00:00</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.processingGaps}</dt><dd id="rdm-q-gaps" class="tabular text-right">0</dd></div>
        <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.lastCalibration}</dt><dd id="rdm-q-caldate" class="tabular text-right">—</dd></div>
      </dl>
    </section>

    <div id="rdm-error" class="hidden mt-4 rounded-xl p-4" role="alert" style="border:1px solid var(--border);background:var(--raised)">
      <p id="rdm-error-title" class="font-semibold text-[15px]"></p>
      <p id="rdm-error-msg" class="text-sm mt-1" style="color:var(--muted)"></p>
      <p class="text-sm mt-2"><strong>{dict.ui.recovery}: </strong><span id="rdm-error-fix"></span></p>
    </div>

    <div class="mt-5" aria-hidden="true">
      <div id="rdm-spec" class="spec" role="img" aria-label="Frequency spectrum estimate, 60 Hz to 12 kHz">
        {Array.from({ length: 10 }).map(() => (<span class="spec-bar"><span class="spec-fill"></span></span>))}
      </div>
      <div class="mt-1 flex justify-between text-[10px] tabular" style="color:var(--muted)">
        <span>60 Hz</span><span>1 kHz</span><span>12 kHz</span>
      </div>
    </div>

    <div class="mt-6">
      <div class="flex items-baseline justify-between gap-2">
        <h3 class="text-sm font-semibold">{dict.graphLabel}</h3>
        <span id="rdm-graph-meta" class="tabular text-xs" style="color:var(--muted)"></span>
      </div>
      <div id="rdm-graph-wrap" class="panel-raised graph-wrap mt-2 p-2">
        <svg id="rdm-graph" viewBox="0 0 600 160" class="w-full" style="height:160px;display:block" role="img" aria-label={dict.graphLabel} preserveAspectRatio="none">
          <defs>
            <linearGradient id="rdm-edge" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#22D3EE" />
              <stop offset="0.5" stop-color="#3B82F6" />
              <stop offset="1" stop-color="#8B5CF6" />
            </linearGradient>
            <linearGradient id="rdm-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3B82F6" stop-opacity="0.24" />
              <stop offset="1" stop-color="#8B5CF6" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g id="rdm-grid" stroke="currentColor" opacity="0.12">
            <line x1="0" y1="40" x2="600" y2="40" /><line x1="0" y1="80" x2="600" y2="80" /><line x1="0" y1="120" x2="600" y2="120" />
          </g>
          <path id="rdm-area-path" d="" fill="url(#rdm-area)" />
          <g id="rdm-gap-markers"></g>
          <path id="rdm-path" d="" fill="none" stroke="url(#rdm-edge)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          <line id="rdm-crosshair" x1="0" x2="0" y1="0" y2="160" stroke="currentColor" opacity="0" stroke-dasharray="3 3" />
          <circle id="rdm-endpoint" cx="0" cy="0" r="4" fill="#3B82F6" stroke="var(--surface)" stroke-width="2" opacity="0" />
        </svg>
        <div id="rdm-tooltip" class="graph-tooltip" role="status" hidden></div>
        <p id="rdm-graph-empty" class="text-xs px-2 py-1" style="color:var(--muted)">{dict.graphEmpty}</p>
      </div>
    </div>

    <div class="mt-6 panel-raised p-4">
      <h3 class="eyebrow mb-2">{dict.exportTitle}</h3>
      <div class="flex flex-wrap gap-2">
        <button id="rdm-exp-csv" type="button" class="btn-square focus-ring" disabled aria-describedby="rdm-exp-hint">{dict.exportCsv}</button>
        <button id="rdm-exp-json" type="button" class="btn-square focus-ring" disabled aria-describedby="rdm-exp-hint">{dict.exportJson}</button>
        <button id="rdm-exp-pdf" type="button" class="btn-square focus-ring" disabled aria-describedby="rdm-exp-hint">{dict.ui.exportPdf}</button>
      </div>
      <p id="rdm-exp-hint" class="mt-2 text-xs" style="color:var(--muted)">{dict.ui.exportHint}</p>
      <h3 class="eyebrow mt-4 mb-2">{dict.historyTitle}</h3>
      <p id="rdm-storage-warn" class="hidden text-xs mb-2" style="color:var(--muted)">{dict.ui.storageBlocked}</p>
      <ul id="rdm-history" class="text-sm space-y-1"></ul>
      <p id="rdm-history-empty" class="text-xs" style="color:var(--muted)">{dict.historyEmpty}</p>
      <button id="rdm-history-clear" type="button" class="btn-square focus-ring mt-2">{dict.historyClear}</button>
    </div>
  </div>

  <div id="rdm-modal-wrap" hidden>
    <button id="rdm-modal-veil" type="button" aria-label={dict.ui.closeOptions}></button>
    <div id="rdm-modal" role="dialog" aria-modal="true" aria-labelledby="rdm-modal-title">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 id="rdm-modal-title" class="text-base font-semibold">{dict.customizeTitle}</h3>
        <button id="rdm-modal-close" type="button" class="btn-square focus-ring">{dict.customizeClose}</button>
      </div>

      <section class="modal-sec" aria-labelledby="rdm-m-cal">
        <h4 id="rdm-m-cal" class="eyebrow mb-2">{dict.calTitle}</h4>
        <p class="text-sm leading-6" style="color:var(--muted)">{calCopy.intro}</p>
        <ol class="mt-3 grid gap-2 sm:grid-cols-3" aria-label={dict.calTitle}>
          <li class="panel-raised p-3"><span class="cal-step" aria-hidden="true">1</span><strong class="block mt-2 text-sm">{calCopy.captureTitle}</strong><span class="block mt-1 text-xs leading-5" style="color:var(--muted)">{calCopy.captureBody}</span></li>
          <li class="panel-raised p-3"><span class="cal-step" aria-hidden="true">2</span><strong class="block mt-2 text-sm">{calCopy.referenceTitle}</strong><span class="block mt-1 text-xs leading-5" style="color:var(--muted)">{calCopy.referenceBody}</span></li>
          <li class="panel-raised p-3"><span class="cal-step" aria-hidden="true">3</span><strong class="block mt-2 text-sm">{calCopy.reviewTitle}</strong><span class="block mt-1 text-xs leading-5" style="color:var(--muted)">{calCopy.reviewBody}</span></li>
        </ol>
        <p id="rdm-cal-state" class="text-sm" style="color:var(--muted)"></p>
        <p id="rdm-cal-stale" class="hidden text-xs mt-1" style="color:#fbbf24"></p>
        <div class="flex flex-wrap items-center gap-2 mt-2 text-sm">
          <span>{dict.ui.referenceCapture}:</span>
          <label class="inline-flex items-center gap-1"><input type="radio" name="rdm-refdur" value="30" /> 30 s</label>
          <label class="inline-flex items-center gap-1"><input type="radio" name="rdm-refdur" value="60" checked /> 60 s <span class="text-xs" style="color:var(--muted)">({calCopy.recommended})</span></label>
          <button id="rdm-ref-start" type="button" class="btn-square focus-ring">{dict.ui.capture}</button>
          <button id="rdm-ref-cancel" type="button" class="btn-square focus-ring">{dict.btnCancel}</button>
        </div>
        <p id="rdm-ref-progress" class="text-xs mt-1" style="color:var(--muted)"></p>
        <div class="grid gap-2 sm:grid-cols-2 mt-2">
          <label class="block text-sm">{dict.calOffset}<input id="rdm-ref-reading" name="reference-reading" autocomplete="off" inputmode="decimal" class="focus-ring mt-1 w-full rounded-lg text-sm" style="min-height:44px;background:var(--surface);border:1px solid var(--border);padding:0 12px" type="number" step="0.1" min="-20" max="160" placeholder="94.0" /></label>
          <label class="block text-sm">{dict.ui.method}<select id="rdm-ref-method" name="reference-method" autocomplete="off" class="focus-ring mt-1 w-full rounded-lg text-sm" style="min-height:44px;background:var(--surface);border:1px solid var(--border);padding:0 12px"><option value="">—</option><option value="reference-meter">{dict.ui.referenceMeter}</option><option value="acoustic-calibrator">{dict.ui.acousticCalibrator}</option><option value="other-documented">{dict.ui.otherDocumented}</option></select></label>
        </div>
        <label class="block text-sm mt-2" for="rdm-ref-note">{dict.ui.note}<input id="rdm-ref-note" name="reference-note" autocomplete="off" class="focus-ring mt-1 w-full rounded-lg text-sm" style="min-height:44px;background:var(--surface);border:1px solid var(--border);padding:0 12px" type="text" maxlength="200" /></label>
        <label class="block text-sm mt-2" for="rdm-cal-label">{dict.calLabel}<input id="rdm-cal-label" name="calibration-label" autocomplete="off" class="focus-ring mt-1 w-full rounded-lg text-sm" style="min-height:44px;background:var(--surface);border:1px solid var(--border);padding:0 12px" type="text" maxlength="80" /></label>
