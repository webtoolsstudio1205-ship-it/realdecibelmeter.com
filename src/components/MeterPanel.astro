          </div>
          <p id="rdm-ver-progress" class="text-xs mt-1" style="color:var(--muted)"></p>
          <label class="block text-sm mt-2">{featureCopy.verifyReference}<input id="rdm-ver-reading" autocomplete="off" inputmode="decimal" class="focus-ring mt-1 w-full rounded-lg text-sm" style="min-height:44px;background:var(--surface);border:1px solid var(--border);padding:0 12px" type="number" step="0.1" min="-20" max="160" placeholder="80.0" /></label>
          <div class="mt-2"><button id="rdm-ver-apply" type="button" class="btn-square focus-ring btn-mini">{featureCopy.verifyApply}</button></div>
          <p id="rdm-ver-msg" class="text-xs mt-2" style="color:var(--muted)" role="status"></p>
        </div>
      </section>

      <details class="modal-sec advanced-details">
        <summary class="focus-ring font-semibold">{dict.ui.advanced}</summary>
        <details class="diagnostics" id="rdm-diagnostics">
          <summary class="focus-ring font-semibold">{dict.ui.diagnostics}</summary>
          <section aria-labelledby="rdm-m-dig">
