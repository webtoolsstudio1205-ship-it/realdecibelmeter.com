      <section class="modal-sec" aria-labelledby="rdm-m-mic">
        <h4 id="rdm-m-mic" class="eyebrow mb-2">{dict.micSelect}</h4>
        <div class="flex gap-2">
          <div class="select-wrap flex-1">
            <select id="rdm-mic" name="microphone" aria-label={dict.micSelect} autocomplete="off" class="select focus-ring text-sm rounded-lg w-full" style="min-height:44px;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0 36px 0 12px">
              <option value="">{dict.micDefault}</option>
            </select>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </div>
          <button id="rdm-refresh-mics" type="button" class="btn-square focus-ring refresh-btn" title={dict.ui.refreshMics} aria-label={dict.ui.refreshMics}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6"/></svg>
          </button>
        </div>
        <dl class="text-sm space-y-1 mt-3">
          <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.device}</dt><dd id="rdm-dev" class="tabular text-right">—</dd></div>
          <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.sampleRate}</dt><dd id="rdm-rate" class="tabular text-right">—</dd></div>
          <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.channels}</dt><dd id="rdm-chan" class="tabular text-right">—</dd></div>
          <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.processing}</dt><dd id="rdm-proc" class="tabular text-right">—</dd></div>
          <div class="flex justify-between gap-2"><dt style="color:var(--muted)">{dict.ui.samples}</dt><dd id="rdm-meta-n" class="tabular text-right">0</dd></div>
        </dl>
        <p id="rdm-relaxed" class="text-xs mt-2" style="color:var(--muted)"></p>
      </section>

      <section class="modal-sec" aria-labelledby="rdm-m-w">
        <h4 id="rdm-m-w" class="eyebrow mb-2">{dict.weighting}</h4>
        <div class="flex flex-col gap-2 text-sm">
          <label class="inline-flex items-center gap-2"><input type="radio" name="rdm-w" value="A" checked /> {dict.weightA}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="rdm-w" value="C" /> {dict.weightC}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="rdm-w" value="Z" /> {dict.weightZ}</label>
        </div>
      </section>

      <section class="modal-sec" aria-labelledby="rdm-m-r">
        <h4 id="rdm-m-r" class="eyebrow mb-2">{dict.response}</h4>
        <div class="flex flex-col gap-2 text-sm">
          <label class="inline-flex items-center gap-2"><input type="radio" name="rdm-r" value="fast" checked /> {dict.respFast}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="rdm-r" value="slow" /> {dict.respSlow}</label>
        </div>
        <p class="text-xs mt-2" style="color:var(--muted)">{dict.ui.weighting}: <span id="rdm-meta-w">A</span> · {dict.ui.response}: <span id="rdm-meta-r">fast</span></p>
      </section>
    </div>
  </div>
</section>

<script>
  import { DecibelEngine } from '../lib/engine.js';
  import { formatDb, formatDuration } from '../lib/dsp.js';
  import { dbToY, seriesToAreaPath, seriesToPath } from '../lib/graph.js';
  import { digitalDiagnostics, publicGauge, publicGraph, publicMeasurementMode, publicStats, transportControls } from '../lib/presentation.js';
  import { buildExportSession, sessionToCsv, sessionToJson, downloadText, downloadBlob, sessionToPdfBlob } from '../lib/export-format.js';
  // NOTE: report.ts (field sanitizing/formatting) is intentionally NOT
  // statically imported: it is only needed for the optional PDF export and
  // is loaded lazily inside readReportFields() so it never joins the initial
  // bundle (see the INEFFECTIVE_DYNAMIC_IMPORT warning this avoids).
  import { loadHistory, saveSession, clearHistory } from '../lib/history.js';
  import { MicCapture } from '../lib/microphone.js';

  const $ = (id) => document.getElementById(id);
  const engine = new DecibelEngine();
  const section = document.getElementById('measure');
  const uiNode = document.getElementById('rdm-ui-strings');
  const calNode = document.getElementById('rdm-cal-strings');
  const featureNode = document.getElementById('rdm-feature-strings');
  const UI = JSON.parse(uiNode?.textContent || '{}');
  const CAL = JSON.parse(calNode?.textContent || '{}');
  const FEATURE = JSON.parse(featureNode?.textContent || '{}');
  const fill = (value, vars = {}) => Object.entries(vars).reduce((text, [key, replacement]) => text.replaceAll(`{${key}}`, String(replacement)), value || '');
  const T = (k, fb) => section?.getAttribute(k) ?? fb;
  const PRESENTATION = {
    current: UI.current, minimum: UI.minimum, digitalAverage: UI.digitalAverage, maximum: UI.maximum, digitalPeak: UI.digitalPeak,
    currentEstimated: UI.estimatedSound, inputStrength: T('data-input-strength', UI.inputStrengthGraph),
    calibrationRequired: T('data-cal-required', 'Calibration required for environmental dB'), calibratedEstimate: UI.calibratedEstimate,
    currentSound: UI.currentSound, energyAverage: UI.energyAverage, duration: T('data-duration', 'Duration'),
    currentStrength: UI.currentStrength, averageStrength: UI.averageStrength, peakStrength: UI.peakStrength,
    estimatedSound: UI.estimatedSound, inputStrengthGraph: UI.inputStrengthGraph,
  };
  const STATUS = () => ({
    idle: T('data-st-idle', 'Idle'),
    'requesting-permission': T('data-st-req', 'Requesting permission…'),
    stabilizing: UI.stabilizing,
    running: T('data-st-run', 'Measuring'),
    paused: T('data-st-pause', 'Paused'),
    stopped: T('data-st-stop', 'Stopped'),
    error: T('data-st-err', 'Attention needed'),
  });
  const PERM = () => ({
    unknown: T('data-p-unknown', 'Not requested'),
    granted: T('data-p-granted', 'Granted'),
    denied: T('data-p-denied', 'Denied'),
    prompt: T('data-p-prompt', 'Prompt'),
  });
  const methodName = (method) => method === 'reference-meter' ? UI.referenceMeter : method === 'acoustic-calibrator' ? UI.acousticCalibrator : method === 'other-documented' ? UI.otherDocumented : method;
  const els = {
    announcer: $('rdm-announcer'), panel: $('rdm-panel'),
    stateText: $('rdm-state-text'), stateDot: $('rdm-state-dot'),
    calBadge: $('rdm-cal-badge'), permText: $('rdm-perm-text'),
    viewLabel: $('rdm-view-label'), arc: $('rdm-arc'), gaugeGlow: $('rdm-gauge-glow'),
    tickLo: $('rdm-tick-lo'), tickMid: $('rdm-tick-mid'), tickHi: $('rdm-tick-hi'),
    big: $('rdm-big'), unit: $('rdm-unit'), modeStatus: $('rdm-mode-status'),
    ctaCal: $('rdm-cta-cal'),
    start: $('rdm-start'), req: $('rdm-req'), stab: $('rdm-stab'), cancel: $('rdm-cancel'), pause: $('rdm-pause'), resume: $('rdm-resume'),
    stop: $('rdm-stop'), startNew: $('rdm-start-new'), save: $('rdm-save'), reset: $('rdm-reset'),
    retry: $('rdm-retry'), dismiss: $('rdm-dismiss'), customize: $('rdm-customize'), saveMsg: $('rdm-save-msg'),
    err: $('rdm-error'), errTitle: $('rdm-error-title'), errMsg: $('rdm-error-msg'), errFix: $('rdm-error-fix'),
    graph: $('rdm-graph'), graphWrap: $('rdm-graph-wrap'), path: $('rdm-path'), areaPath: $('rdm-area-path'),
    endpoint: $('rdm-endpoint'), crosshair: $('rdm-crosshair'), tooltip: $('rdm-tooltip'),
    gapMarkers: $('rdm-gap-markers'), graphEmpty: $('rdm-graph-empty'), graphMeta: $('rdm-graph-meta'),
    l1: $('rdm-l1'), l2: $('rdm-l2'), l3: $('rdm-l3'), l4: $('rdm-l4'), l5: $('rdm-l5'),
    s1: $('rdm-s1'), s2: $('rdm-s2'), s3: $('rdm-s3'), s4: $('rdm-s4'), s5: $('rdm-s5'), stat5: $('rdm-stat-5'),
    stats: $('rdm-stats'),
    expCsv: $('rdm-exp-csv'), expJson: $('rdm-exp-json'), expPdf: $('rdm-exp-pdf'),
    verStart: $('rdm-ver-start'), verCancel: $('rdm-ver-cancel'), verReading: $('rdm-ver-reading'),
    verApply: $('rdm-ver-apply'), verMsg: $('rdm-ver-msg'), verProgress: $('rdm-ver-progress'),
    history: $('rdm-history'), historyEmpty: $('rdm-history-empty'), historyClear: $('rdm-history-clear'),
    storageWarn: $('rdm-storage-warn'),
    modalWrap: $('rdm-modal-wrap'), modal: $('rdm-modal'), modalClose: $('rdm-modal-close'),
    mic: $('rdm-mic'), refresh: $('rdm-refresh-mics'),
    dev: $('rdm-dev'), rate: $('rdm-rate'), chan: $('rdm-chan'), proc: $('rdm-proc'),
    metaN: $('rdm-meta-n'), relaxed: $('rdm-relaxed'), metaW: $('rdm-meta-w'), metaR: $('rdm-meta-r'),
    calState: $('rdm-cal-state'), calStale: $('rdm-cal-stale'), calMsg: $('rdm-cal-msg'), calPreview: $('rdm-cal-preview'),
    refReading: $('rdm-ref-reading'), refMethod: $('rdm-ref-method'), refNote: $('rdm-ref-note'),
    calLabel: $('rdm-cal-label'), calApply: $('rdm-cal-apply'), calReset: $('rdm-cal-reset'),
    refStart: $('rdm-ref-start'), refCancel: $('rdm-ref-cancel'), refProgress: $('rdm-ref-progress'),
    profiles: $('rdm-profiles'),
    dCur: $('rdm-d-cur'), dMin: $('rdm-d-min'), dAvg: $('rdm-d-avg'), dMax: $('rdm-d-max'), dPeak: $('rdm-d-peak'),
    diagnosticPath: $('rdm-diagnostic-path'), diagnostics: $('rdm-diagnostics'),
    relState: $('rdm-rel-state'), relCap: $('rdm-rel-cap'), relClear: $('rdm-rel-clear'), relMsg: $('rdm-rel-msg'),
    qOverall: $('rdm-q-overall'), qCal: $('rdm-q-cal'), qSignal: $('rdm-q-signal'), qProc: $('rdm-q-proc'),
    qRate: $('rdm-q-rate'), qChan: $('rdm-q-chan'), qDur: $('rdm-q-dur'), qGaps: $('rdm-q-gaps'), qCalDate: $('rdm-q-caldate'),
  };

  const specFills = Array.from(document.querySelectorAll('#rdm-spec .spec-fill'));
  const ARC_LEN = 428;
  const REDUCED = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let latest = null;
  let prevState = 'idle';
  let prevCalibrated = false;
  let historyEntries = [];
  let lastAnnounced = '';
  let graphView = { series: [], lo: 20, hi: 120, label: `${UI.estimatedSound} (dBA)`, unit: 'dBA' };
  let pauseMarkers = [];
  const DATE_TIME = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
  const DATE_ONLY = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });

  // Single rAF loop (~30 FPS) for number/arc/strength interpolation.
  // DSP quanta arrive via engine subscription independently of this rate.
  // Stored/exported measurements are NEVER smoothed — only these display vars.
  let rafId = 0;
  let lastFrame = 0;
  let shownMain = null;
  let shownFrac = 0;

  function mainTarget(s) {
    return publicGauge(s, PRESENTATION);
  }

  function fracFor(value, lo, hi) {
    if (value == null || !Number.isFinite(value)) return 0;
    const t = (value - lo) / (hi - lo);
    return Math.min(1, Math.max(0, t));
  }

  function paintMain(target, immediate) {
    const txt = target.value == null || !Number.isFinite(target.value) ? '--' : formatDb(target.value);
    if (els.big.textContent !== txt) els.big.textContent = txt;
    if (els.unit.textContent !== target.unit) els.unit.textContent = target.unit;
    const frac = fracFor(target.value, target.lo, target.hi);
    if (immediate || REDUCED) {
      shownMain = target.value;
      shownFrac = frac;
      els.arc.style.strokeDashoffset = String(ARC_LEN * (1 - frac));
    }
  }

  function tickLabels() {
    if (!latest) return;
    const gauge = publicGauge(latest, PRESENTATION);
    els.tickLo.textContent = String(gauge.lo);
    els.tickMid.textContent = String((gauge.lo + gauge.hi) / 2);
    els.tickHi.textContent = String(gauge.hi);
    els.viewLabel.textContent = gauge.label;
  }

  function rafTick(now) {
    rafId = 0;
    if (!latest) return;
    if (now - lastFrame < 33 && !REDUCED) {
      rafId = requestAnimationFrame(rafTick);
      return;
    }
    lastFrame = now;
    const t = mainTarget(latest);
    const frac = fracFor(t.value, t.lo, t.hi);
    if (REDUCED || t.value == null) {
      paintMain(t, true);
    } else {
      const cur = shownMain == null || !Number.isFinite(shownMain) ? t.value : shownMain;
      const next = cur + (t.value - cur) * 0.35;
      // Snap when close (sign-preserving comparison — never alters the value's sign).
      const gap = next > t.value ? next - t.value : t.value - next;
      shownMain = gap < 0.02 ? t.value : next;
      shownFrac = shownFrac + (frac - shownFrac) * 0.35;
      const txt = formatDb(shownMain);
      if (els.big.textContent !== txt) els.big.textContent = txt;
      if (els.unit.textContent !== t.unit) els.unit.textContent = t.unit;
      els.arc.style.strokeDashoffset = String(ARC_LEN * (1 - shownFrac));
    }
    els.gaugeGlow.style.opacity = (0.15 + shownFrac * 0.55).toFixed(2);
    const st = latest.state;
    if (st === 'running' || st === 'paused' || st === 'stabilizing' || st === 'requesting-permission') {
      rafId = requestAnimationFrame(rafTick);
    }
  }

  function ensureRaf() {
    if (rafId || REDUCED || !latest) return;
    const st = latest.state;
    if (st === 'running' || st === 'paused' || st === 'stabilizing' || st === 'requesting-permission') {
      lastFrame = 0;
      rafId = requestAnimationFrame(rafTick);
    }
  }

  function cancelRaf() {
    if (rafId) cancelAnimationFrame(rafId);
    rafId = 0;
  }

  function buildExport(s) {
    return buildExportSession({
      stats: {
        current: s.display.current, min: s.display.min, leq: s.display.leq, max: s.display.max,
        peakDb: s.display.peakDb, gapMs: s.gapMs, recordedSec: s.stats.recordedSec, durationSec: s.stats.durationSec,
      },
      gaps: s.gaps,
      segments: s.segments,
      unit: s.unit,
      mode: s.mode,
      weighting: s.weighting,
      response: s.response,
      deviceLabel: s.deviceLabel,
      deviceId: s.deviceId,
      sampleRate: s.sampleRate,
      channelCount: s.channelCount,
      processing: { ...s.processing },
      relaxedConstraints: s.relaxedConstraints,
      calibration: s.calibration,
      calibrationMethod: s.activeProfile ? s.activeProfile.referenceMethod : 'none',
      calibrationDateIso: s.activeProfile ? s.activeProfile.calibrationDateIso : null,
      startedAtIso: engine.getStartedAtIso() || new Date().toISOString(),
      invalidSamples: engine.getInvalidSampleCount(),
    });
  }

  function renderHistory() {
    els.history.replaceChildren();
    els.historyEmpty.style.display = historyEntries.length ? 'none' : '';
    historyEntries.slice(0, 5).forEach((e) => {
      const li = document.createElement('li');
      li.className = 'tabular';
      const sess = e.session || {};
      // Never label raw dBFS averages as `Leq`.
      const saved = new Date(String(e.savedAtIso || ''));
      const when = Number.isNaN(saved.getTime()) ? UI.unknownDate : DATE_TIME.format(saved);
      li.textContent = sess.mode === 'calibrated' && /^dB[ACZ]$/.test(sess.unit || '')
        ? `${when} · ${sess.unit} ${UI.savedEnergyAverage} ${formatDb(sess.leqDb)} · ${formatDuration(sess.activeSec || 0)}`
        : `${when} · ${UI.uncalibratedSession} · ${formatDuration(sess.activeSec || 0)}`;
      els.history.appendChild(li);
    });
  }

  async function refreshMics() {
    const devices = await MicCapture.listDevices();
    const sel = els.mic;
    const prev = sel.value;
    sel.replaceChildren();
    const def = document.createElement('option');
    def.value = '';
    def.textContent = T('data-mic-default', 'Default microphone');
    sel.appendChild(def);
    devices.forEach((d, i) => {
      const o = document.createElement('option');
      o.value = d.deviceId;
      o.textContent = d.label || `${UI.microphone} ${i + 1}`;
      sel.appendChild(o);
    });
    if ([...sel.options].some((o) => o.value === prev)) sel.value = prev;
  }

  function renderProfiles(s) {
    els.profiles.replaceChildren();
    const list = engine.listProfiles();
    if (!list.length) {
      const li = document.createElement('li');
      li.style.color = 'var(--muted)';
      li.textContent = UI.noProfiles;
      els.profiles.appendChild(li);
      return;
    }
    list.forEach((p) => {
      const li = document.createElement('li');
      li.className = 'profile-row';
      const active = s.activeProfile && s.activeProfile.id === p.id;
      li.textContent = `${p.label} (${p.offsetDb >= 0 ? '+' : ''}${p.offsetDb.toFixed(1)} dB)${active ? ` · ${UI.active}` : ''} `;
      const apply = document.createElement('button');
      apply.type = 'button';
      apply.className = 'btn-square focus-ring btn-mini';
      apply.textContent = UI.apply;
      apply.addEventListener('click', () => {
        const r = engine.applyProfile(p.id);
        els.calMsg.textContent = r.ok ? fill(UI.appliedProfile, { name: p.label, unit: publicGauge(engine.snapshot(), PRESENTATION).unit }) : UI.operationFailed;
      });
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn-square focus-ring btn-mini';
      del.textContent = UI.delete;
      del.addEventListener('click', () => {
        if (window.confirm(fill(UI.deleteProfile, { name: p.label }))) engine.deleteProfile(p.id);
      });
      li.appendChild(apply);
      li.appendChild(del);
      els.profiles.appendChild(li);
    });
  }

  function updateTransport(st) {
    const active = new Set(transportControls(st));
    const show = (el, on) => { el.hidden = !on; };
    show(els.start, active.has('start'));
    show(els.req, active.has('requesting'));
    show(els.stab, active.has('stabilizing'));
    show(els.cancel, active.has('cancel'));
    show(els.pause, active.has('pause'));
    show(els.resume, active.has('resume'));
    show(els.stop, active.has('stop'));
    show(els.startNew, active.has('start-new'));
    show(els.save, active.has('save'));
    show(els.reset, active.has('reset'));
    show(els.retry, active.has('retry'));
    show(els.dismiss, active.has('dismiss'));
    show(els.customize, active.has('customize'));
  }

  function updateStats(s) {
    const hasData = s.stats.current != null;
    els.stats.classList.toggle('has-data', hasData);
    const stats = publicStats(s, PRESENTATION);
    const labels = [els.l1, els.l2, els.l3, els.l4, els.l5];
    const values = [els.s1, els.s2, els.s3, els.s4, els.s5];
    for (let i = 0; i < stats.length; i++) {
      labels[i].textContent = stats[i].label;
      values[i].textContent = stats[i].value;
    }
    els.stat5.hidden = stats.length < 5;
  }

  function updateMainMeta(s) {
    const gauge = publicGauge(s, PRESENTATION);
    els.modeStatus.textContent = gauge.calibrated && s.result.kind === 'calibrated'
      ? `${gauge.status} · ${s.calibration.label} · ${s.weighting}`
      : gauge.status;
    els.ctaCal.hidden = gauge.calibrated;
  }

  function updateCalibrationPreview() {
    const measured = engine.getReferenceMeasuredLeq();
    const reference = Number.parseFloat(els.refReading.value);
    if (measured == null || !Number.isFinite(measured) || !Number.isFinite(reference)) {
      els.calPreview.textContent = CAL.previewWaiting || '';
      return;
    }
    const offset = reference - measured;
    els.calPreview.textContent = fill(CAL.previewTemplate, {
      reference: reference.toFixed(1),
      measured: measured.toFixed(1),
      offset: `${offset >= 0 ? '+' : ''}${offset.toFixed(1)}`,
    });
  }

  function updateModal(s) {
    // Calibration section
    els.calState.textContent = s.activeProfile
      ? `${fill(UI.activeProfile, { name: s.activeProfile.label })} (${s.activeProfile.offsetDb >= 0 ? '+' : ''}${s.activeProfile.offsetDb.toFixed(1)} dB, ${methodName(s.activeProfile.referenceMethod)}, ${DATE_ONLY.format(new Date(s.activeProfile.calibrationDateIso))})`
      : UI.noActiveProfile;
    if (s.calibrationStale && s.calibrationStaleReasons.length) {
      els.calStale.classList.remove('hidden');
      els.calStale.textContent = UI.staleProfile;
    } else {
      els.calStale.classList.add('hidden');
    }
    if (s.referenceCapture) {
      els.refProgress.textContent = `${fill(UI.capturingReference, { elapsed: s.referenceCapture.elapsedSec.toFixed(0), duration: s.referenceCapture.durationSec })} (${UI.keepSteady})`;
    } else {
      const m = engine.getReferenceMeasuredLeq();
      els.refProgress.textContent = m != null && Number.isFinite(m)
        ? fill(UI.measuredDigital, { value: formatDb(m) })
        : '';
    }
    updateCalibrationPreview();
    renderProfiles(s);
    // Verification progress + last result (second-point consistency check).
    if (s.verificationCapture) {
      if (els.verProgress) els.verProgress.textContent = `${FEATURE.verifyStart}… ${s.verificationCapture.elapsedSec.toFixed(0)} / ${s.verificationCapture.durationSec} s · ${UI.keepSteady}`;
    } else {
      const vm = engine.getVerificationMeasuredLeq();
      if (els.verProgress) {
        els.verProgress.textContent = vm != null && Number.isFinite(vm)
          ? `${FEATURE.verifyCaptured}: ${formatDb(vm)} dBFS`
          : (s.activeProfile?.verification
              ? `${FEATURE.verifyLast}: ${new Date(s.activeProfile.verification.verificationDateIso).toLocaleString()} · ${FEATURE.verifyResidual}: ${s.activeProfile.verification.residualDb >= 0 ? '+' : ''}${s.activeProfile.verification.residualDb.toFixed(1)} dB`
              : '');
      }
    }
    // Digital Diagnostics — the ONLY place raw negative dBFS is shown.
    const diagnostic = digitalDiagnostics(s, PRESENTATION);
    [els.dCur, els.dMin, els.dAvg, els.dMax, els.dPeak].forEach((el, i) => {
      el.textContent = diagnostic[i].value;
    });
    // Relative card
    els.relState.textContent = s.baseline
      ? `${UI.baseline}: ${formatDb(s.baseline.energyDb)} dBFS (${s.baseline.weighting}, ${DATE_TIME.format(new Date(s.baseline.capturedAtIso))})`
      : UI.noBaseline;
    // Mic card
    els.dev.textContent = s.deviceLabel || '—';
    els.rate.textContent = s.sampleRate ? `${s.sampleRate} Hz` : '—';
    els.chan.textContent = s.sampleRate ? String(s.channelCount) : '—';
    els.proc.textContent = s.sampleRate
      ? `EC ${s.processing.echoCancellation} / NS ${s.processing.noiseSuppression} / AGC ${s.processing.autoGainControl}`
      : '—';
    els.metaN.textContent = String(s.stats.samples);
    els.relaxed.textContent = s.relaxedConstraints.length ? s.relaxedConstraints.join(' ') : '';
    els.metaW.textContent = s.weighting;
    els.metaR.textContent = s.response === 'fast' ? T('data-resp-fast', 'Fast') : T('data-resp-slow', 'Slow');
  }

  function updateQuality(s) {
    const mode = publicMeasurementMode(s);
    // Overall: Ready / Check setup / Not calibrated / Invalid reading (never a fake accuracy %).
    let overall = UI.ready;
    if (s.state === 'error') overall = UI.checkSetup;
    else if (mode === 'estimated-spl' && (s.state === 'running' || s.state === 'stabilizing' || s.state === 'paused')) overall = UI.notCalibrated;
    else if ((s.state === 'running' || s.state === 'stabilizing') && s.stats.current == null) overall = UI.invalidReading;
    els.qOverall.textContent = overall;
    els.qCal.textContent = s.calibrationValid && s.activeProfile
      ? `Calibrated (${s.activeProfile.offsetDb >= 0 ? '+' : ''}${s.activeProfile.offsetDb.toFixed(1)} dB)`
      : UI.notCalibrated;
    // Signal: Stable / Variable / Below measurement floor / Clipping / Disconnected.
    let signal = '—';
    if (s.state === 'error' && s.error === 'device-disconnected') signal = UI.disconnected;
    else if (s.state === 'running' || s.state === 'paused' || s.state === 'stabilizing') {
      const peak = s.stats.peakDb;
      if (s.stats.current == null || !Number.isFinite(s.stats.current)) signal = UI.belowFloor;
      else if (Number.isFinite(peak) && peak >= -0.5) signal = UI.clipping;
      else if (s.stats.current <= -90) signal = UI.belowFloor;
      else if (s.gapMs > 2000 || s.stats.gapCount > 2) signal = UI.variable;
      else signal = UI.stable;
    }
    els.qSignal.textContent = signal;
    els.qProc.textContent = s.sampleRate
      ? `EC ${s.processing.echoCancellation} / NS ${s.processing.noiseSuppression} / AGC ${s.processing.autoGainControl}`
      : '—';
    els.qRate.textContent = s.sampleRate ? `${s.sampleRate} Hz` : '—';
    els.qChan.textContent = s.sampleRate ? String(s.channelCount) : '—';
    els.qDur.textContent = formatDuration(s.stats.durationSec);
    els.qGaps.textContent = s.stats.gapCount > 0 ? `${s.stats.gapCount} (${(s.gapMs / 1000).toFixed(1)} s)` : '0';
    els.qCalDate.textContent = s.activeProfile?.calibrationDateIso
      ? DATE_ONLY.format(new Date(s.activeProfile.calibrationDateIso))
      : '—';
  }

  const unsubscribe = engine.subscribe((s) => {
    latest = s;
    const guideReading = publicGauge(s, PRESENTATION);
    const readingDetail = { value: guideReading.value, unit: guideReading.unit, calibrated: guideReading.calibrated };
    window.__rdmReading = readingDetail;
    document.dispatchEvent(new CustomEvent('rdm:reading', { detail: readingDetail }));
    // Full typed snapshot for the screening panels (exposure, spectrum,
    // report). No audio data is broadcast — only numeric summaries.
    window.__rdmSnapshot = s;
    document.dispatchEvent(new CustomEvent('rdm:snapshot', { detail: s }));
    const st = s.state;
    const calibratedNow = s.calibrationValid && s.result.kind === 'calibrated';
    els.panel.dataset.state = st;
    els.panel.setAttribute('data-live', st === 'running' && s.stats.current != null ? 'true' : 'false');
    els.stateText.textContent = STATUS()[st] ?? st;
    els.stateDot.style.background = st === 'running' ? '#22D3EE' : st === 'error' ? '#f87171' : st === 'paused' ? '#fbbf24' : 'var(--muted)';
    const permMap = PERM();
    els.permText.textContent = permMap[s.permission] ?? s.permission;
    els.calBadge.textContent = s.calibrationValid && s.activeProfile
      ? `${T('data-cal-c', 'Calibrated')} (${s.activeProfile.offsetDb >= 0 ? '+' : ''}${s.activeProfile.offsetDb.toFixed(1)} dB)`
      : T('data-cal-u', 'Uncalibrated — showing microphone input strength, not environmental dB');

    // Stop completion animation + pause dimming are CSS-driven via data-state/classes.
    if (prevState !== 'stopped' && st === 'stopped') {
      els.panel.classList.remove('just-stopped');
      requestAnimationFrame(() => els.panel.classList.add('just-stopped'));
      setTimeout(() => els.panel.classList.remove('just-stopped'), 600);
      cancelRaf();
      paintMain(mainTarget(s), true);
    }
    if (prevState === 'running' && st === 'paused') {
      pauseMarkers.push(Math.max(0, engine.graph.size - 1));
    }
    if ((prevState === 'idle' || prevState === 'stopped') && st === 'requesting-permission') {
      pauseMarkers = [];
    }
    if (prevState === 'requesting-permission' && (st === 'stabilizing' || st === 'running') && !REDUCED) {
      els.panel.classList.add('permission-granted');
      setTimeout(() => els.panel.classList.remove('permission-granted'), 620);
    }
    if (prevState === 'stabilizing' && st === 'running' && !REDUCED) {
      els.panel.classList.add('permission-granted');
      setTimeout(() => els.panel.classList.remove('permission-granted'), 620);
    }
    if (prevCalibrated !== calibratedNow && !REDUCED) {
      els.panel.classList.remove('mode-switch');
      requestAnimationFrame(() => els.panel.classList.add('mode-switch'));
      setTimeout(() => els.panel.classList.remove('mode-switch'), 260);
    }
    prevCalibrated = calibratedNow;
    if ((st === 'idle' || st === 'error') && prevState !== st) {
      cancelRaf();
      paintMain(mainTarget(s), true);
    }
    prevState = st;

    tickLabels();
    updateTransport(st);
    updateMainMeta(s);
    updateStats(s);
    updateModal(s);
    updateQuality(s);

    // Spectrum bars rise from ACTUAL microphone FFT data only.
    const live = st === 'running' && s.spectrumDb.length;
    for (let i = 0; i < specFills.length; i++) {
      const v = live ? s.spectrumDb[i] : null;
      const h = v == null || !Number.isFinite(v) ? 0 : Math.min(1, Math.max(0, (v + 90) / 60));
      specFills[i].style.height = `${Math.round(h * 100)}%`;
    }

    // The engine retains raw digital history; this public layer selects one
    // honest scale and unit for the active calibration state.
    const rawSeries = engine.graph.series().slice(-180);
    graphView = publicGraph(rawSeries, s, PRESENTATION);
    const line = seriesToPath(graphView.series, 600, 160, graphView.lo, graphView.hi);
    els.path.setAttribute('d', line);
    els.areaPath.setAttribute('d', seriesToAreaPath(graphView.series, 600, 160, graphView.lo, graphView.hi));
    els.graph.setAttribute('aria-label', fill(UI.graphRange, { label: graphView.label, lo: graphView.lo, hi: graphView.hi }));
    els.graphEmpty.style.display = graphView.series.length ? 'none' : '';
    els.graphMeta.textContent = graphView.series.length ? `${graphView.label} · ${graphView.lo}–${graphView.hi}${graphView.unit}` : graphView.label;
    const lastIndex = graphView.series.length - 1;
    const lastValue = lastIndex >= 0 ? graphView.series[lastIndex] : null;
    if (lastValue == null) {
      els.endpoint.setAttribute('opacity', '0');
    } else {
      const x = graphView.series.length > 1 ? 600 : 0;
      els.endpoint.setAttribute('cx', String(x));
      els.endpoint.setAttribute('cy', String(dbToY(lastValue, 160, graphView.lo, graphView.hi)));
      els.endpoint.setAttribute('opacity', '1');
    }
    els.gapMarkers.replaceChildren(...pauseMarkers.filter((i) => i < graphView.series.length).map((i) => {
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      const x = graphView.series.length > 1 ? (i / (graphView.series.length - 1)) * 600 : 0;
      line.setAttribute('x1', String(x)); line.setAttribute('x2', String(x));
      line.setAttribute('y1', '0'); line.setAttribute('y2', '160');
      line.setAttribute('stroke', 'currentColor'); line.setAttribute('opacity', '0.22');
      line.setAttribute('stroke-dasharray', '4 5');
      return line;
    }));
    els.diagnosticPath.setAttribute('d', seriesToPath(rawSeries, 600, 120, -100, 0));

    const hasData = s.display.current != null || s.stats.current != null;
    els.expCsv.disabled = !hasData;
    els.expJson.disabled = !hasData;
    if (els.expPdf) els.expPdf.disabled = !hasData;
    const panelPdf = document.getElementById('rdm-pdf-generate');
    if (panelPdf) panelPdf.disabled = !hasData;
    document.getElementById('rdm-pdf-hint')?.toggleAttribute('hidden', hasData);
    // Visible explanation for the disabled state (not color/icon alone).
    document.getElementById('rdm-exp-hint')?.toggleAttribute('hidden', hasData);

    if (st === 'error') {
      const info = s.error === 'unsupported-browser'
        ? { title: UI.errorUnsupportedTitle, message: UI.errorUnsupportedMessage, recovery: UI.errorUnsupportedRecovery }
        : s.error === 'permission-denied'
          ? { title: UI.errorPermissionTitle, message: UI.errorPermissionMessage, recovery: UI.errorPermissionRecovery }
          : ['no-device', 'device-busy', 'device-disconnected', 'overconstrained'].includes(s.error)
            ? { title: UI.errorDeviceTitle, message: UI.errorDeviceMessage, recovery: UI.errorDeviceRecovery }
            : { title: UI.errorGenericTitle, message: UI.errorGenericMessage, recovery: UI.errorGenericRecovery };
      els.err.classList.remove('hidden');
      els.errTitle.textContent = info.title;
      els.errMsg.textContent = info.message;
      els.errFix.textContent = info.recovery;
    } else {
      els.err.classList.add('hidden');
    }

    const announce = `${STATUS()[st] ?? st}${st === 'error' ? ': ' + UI.errorGenericTitle : ''}`;
    if (announce !== lastAnnounced) {
      lastAnnounced = announce;
      els.announcer.textContent = announce;
    }

    ensureRaf();
  });

  // Transport: Start requests permission and measures immediately — no popup.
  els.start?.addEventListener('click', () => { els.start.blur(); els.saveMsg.textContent = ''; engine.start(); });
  els.cancel?.addEventListener('click', () => engine.cancelStart());
  els.startNew?.addEventListener('click', () => { els.saveMsg.textContent = ''; engine.reset(); engine.start(); });
  els.pause?.addEventListener('click', () => engine.pause());
  els.resume?.addEventListener('click', () => engine.resume());
  els.stop?.addEventListener('click', () => engine.stop());
  els.reset?.addEventListener('click', () => { els.saveMsg.textContent = ''; engine.reset(); });
  els.retry?.addEventListener('click', () => engine.start());
  els.dismiss?.addEventListener('click', () => engine.dismissError());
  els.save?.addEventListener('click', () => {
    const s = engine.snapshot();
    const exported = buildExport(s);
    const res = saveSession(exported, `${s.weighting}/${s.response} ${s.unit}`);
    historyEntries = res.entries;
    if (!res.ok) els.storageWarn.classList.remove('hidden');
    els.saveMsg.textContent = res.ok ? UI.savedHistory : UI.operationFailed;
    renderHistory();
    document.dispatchEvent(new CustomEvent('rdm:history-changed'));
  });
  els.ctaCal?.addEventListener('click', () => openModal());

  // Customize modal — the ONLY opener of measurement options.
  let lastFocus = null;
  function openModal() {
    lastFocus = document.activeElement;
    els.modalWrap.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => els.modalWrap.classList.add('open'));
    els.modalClose.focus();
  }
  function closeModal() {
    els.modalWrap.classList.remove('open');
    setTimeout(() => { els.modalWrap.hidden = true; }, REDUCED ? 0 : 180);
    document.body.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  els.customize?.addEventListener('click', openModal);
  els.modalClose?.addEventListener('click', closeModal);
  $('rdm-modal-veil')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !els.modalWrap.hidden) closeModal();
    if (e.key === 'Tab' && !els.modalWrap.hidden) {
      const focusable = Array.from(els.modal.querySelectorAll('button, input, select, summary, [href]')).filter((el) => !el.disabled);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  els.mic?.addEventListener('change', (e) => {
    const sel = e.target;
    engine.setDevice(sel.value, sel.options[sel.selectedIndex]?.textContent ?? '');
  });
  els.refresh?.addEventListener('click', () => refreshMics());

  document.querySelectorAll('input[name="rdm-w"]').forEach((r) => {
    r.addEventListener('change', (e) => engine.setWeighting(e.target.value));
  });
  document.querySelectorAll('input[name="rdm-r"]').forEach((r) => {
    r.addEventListener('change', (e) => engine.setResponse(e.target.value));
  });

  els.refStart?.addEventListener('click', () => {
    const dur = document.querySelector('input[name="rdm-refdur"]:checked')?.value === '60' ? 60 : 30;
    const r = engine.startReferenceCapture(dur);
    els.calMsg.textContent = r.ok ? fill(UI.capturingReference, { elapsed: 0, duration: dur }) : r.reason;
  });
  els.refCancel?.addEventListener('click', () => { engine.cancelReferenceCapture(); els.calMsg.textContent = UI.captureCancelled; });
  els.refReading?.addEventListener('input', updateCalibrationPreview);
  els.calApply?.addEventListener('click', () => {
    const reading = parseFloat(els.refReading.value);
    const duration = document.querySelector('input[name="rdm-refdur"]:checked')?.value === '60' ? 60 : 30;
    const res = engine.applyReferenceCalibration(
      {
        referenceReadingDb: Number.isFinite(reading) ? reading : Number.NaN,
        measuredDigitalLeqDb: Number.NaN,
        method: els.refMethod.value,
        durationSec: duration,
        note: els.refNote.value ?? '',
      },
      els.calLabel.value ?? '',
    );
    els.calMsg.textContent = res.ok
      ? fill(UI.calibratedDone, { unit: publicGauge(engine.snapshot(), PRESENTATION).unit })
      : res.reasons.join(' ');
    if (res.ok) {
      tickLabels();
    }
  });
  els.calReset?.addEventListener('click', () => {
    engine.resetCalibration();
    els.refReading.value = '';
    els.calLabel.value = '';
    updateCalibrationPreview();
    els.calMsg.textContent = publicGauge(engine.snapshot(), PRESENTATION).status;
  });
  els.relCap?.addEventListener('click', () => {
    const r = engine.setBaseline();
    els.relMsg.textContent = r.ok ? UI.baselineCaptured : UI.operationFailed;
  });
  els.relClear?.addEventListener('click', () => { engine.clearBaseline(); els.relMsg.textContent = UI.baselineCleared; });

  els.expCsv?.addEventListener('click', () => {
    const s = engine.snapshot();
    downloadText(`decibel-session-${Date.now()}.csv`, sessionToCsv(buildExport(s)), 'text/csv');
  });
  els.expJson?.addEventListener('click', () => {
    const s = engine.snapshot();
    downloadText(`decibel-session-${Date.now()}.json`, sessionToJson(buildExport(s)), 'application/json');
  });

  async function readReportFields() {
    // Lazy: report formatting is only needed when the user exports a PDF.
    const { sanitizeReportFields } = await import('../lib/report.js');
    const val = (id) => document.getElementById(id)?.value ?? '';
    return sanitizeReportFields({
      title: val('rdm-pdf-title'),
      location: val('rdm-pdf-location'),
      distance: val('rdm-pdf-distance'),
      source: val('rdm-pdf-source'),
      position: val('rdm-pdf-position'),
      notes: val('rdm-pdf-notes'),
      includeComparison: document.getElementById('rdm-cmp-pdf')?.checked === true,
    });
  }

  async function generatePdf() {
    const msg = document.getElementById('rdm-pdf-msg');
    try {
      const s = engine.snapshot();
      if (s.display.current == null && s.stats.current == null) {
        if (msg) msg.textContent = UI.exportHint;
        return;
      }
      const session = buildExport(s);
      const fields = await readReportFields();
      const exposure = window.__rdmExposure ?? null;
      const comparison = window.__rdmComparison?.includeInPdf ? window.__rdmComparison : null;
      const series = engine.graph.series().slice(-180);
      const blob = await sessionToPdfBlob(session, { userFields: fields, exposure, comparison, graphSeries: series });
      downloadBlob(`decibel-report-${Date.now()}.pdf`, blob);
      if (msg) msg.textContent = FEATURE.pdfDone;
    } catch (err) {
      if (msg) msg.textContent = UI.operationFailed;
    }
  }
  els.expPdf?.addEventListener('click', generatePdf);
  document.getElementById('rdm-pdf-generate')?.addEventListener('click', generatePdf);

  // Verification workflow: separate run at a different level/distance.
  els.verStart?.addEventListener('click', () => {
    const dur = document.querySelector('input[name="rdm-verdur"]:checked')?.value === '60' ? 60 : 30;
    const r = engine.startVerificationCapture(dur);
    if (els.verMsg) els.verMsg.textContent = r.ok ? `${FEATURE.verifyStart}: ${dur} s · ${UI.keepSteady}` : UI.operationFailed;
  });
  els.verCancel?.addEventListener('click', () => { engine.cancelVerificationCapture(); if (els.verMsg) els.verMsg.textContent = UI.captureCancelled; });
  els.verApply?.addEventListener('click', () => {
    const reading = parseFloat(els.verReading?.value ?? '');
    const duration = document.querySelector('input[name="rdm-verdur"]:checked')?.value === '60' ? 60 : 30;
    const res = engine.applyVerification(Number.isFinite(reading) ? reading : Number.NaN, duration);
    if (!els.verMsg) return;
    if (!res.ok) { els.verMsg.textContent = UI.invalidReading; return; }
    const rec = res.record;
    const outcome = rec.outcome === 'consistent'
      ? FEATURE.verifyOutcomeConsistent
      : rec.outcome === 'caution'
        ? FEATURE.verifyOutcomeCaution
        : `${FEATURE.verifyOutcomeFail} ${FEATURE.verifyAgcNote}`;
    els.verMsg.textContent = `${FEATURE.verifyReference}: ${rec.verificationReferenceDb.toFixed(1)} dBA · ${FEATURE.verifyResidual}: ${rec.residualDb >= 0 ? '+' : ''}${rec.residualDb.toFixed(1)} dB · ${outcome}`;
  });
  els.historyClear?.addEventListener('click', () => {
    if (!window.confirm(UI.clearHistoryConfirm)) return;
    if (clearHistory()) { historyEntries = []; renderHistory(); document.dispatchEvent(new CustomEvent('rdm:history-changed')); }
    else els.storageWarn.classList.remove('hidden');
  });

  // Init: device list + local history; labels appear after permission.
  refreshMics();
  navigator.mediaDevices?.addEventListener?.('devicechange', refreshMics);
  try {
    const h = loadHistory();
    historyEntries = h.entries;
    if (!h.storageOk) els.storageWarn.classList.remove('hidden');
  } catch { els.storageWarn.classList.remove('hidden'); }
  renderHistory();
  tickLabels();
  paintMain({ value: null, lo: 20, hi: 120, unit: 'dBA' }, true);

  function graphPointerMove(e) {
    if (!graphView.series.length || REDUCED) return;
    const rect = els.graph.getBoundingClientRect();
    const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
    const index = Math.round(ratio * (graphView.series.length - 1));
    const value = graphView.series[index];
    if (value == null) return;
    const x = ratio * 600;
    els.crosshair.setAttribute('x1', String(x));
    els.crosshair.setAttribute('x2', String(x));
    els.crosshair.setAttribute('opacity', '0.35');
    els.tooltip.hidden = false;
    els.tooltip.textContent = `${formatDb(value)}${graphView.unit}`;
    els.tooltip.style.left = `${Math.min(rect.width - 64, Math.max(8, ratio * rect.width))}px`;
  }
  function graphPointerLeave() {
    els.crosshair.setAttribute('opacity', '0');
    els.tooltip.hidden = true;
  }
  els.graph.addEventListener('pointermove', graphPointerMove);
  els.graph.addEventListener('pointerleave', graphPointerLeave);

  function cleanup() {
    cancelRaf();
    unsubscribe();
    navigator.mediaDevices?.removeEventListener?.('devicechange', refreshMics);
    els.graph.removeEventListener('pointermove', graphPointerMove);
    els.graph.removeEventListener('pointerleave', graphPointerLeave);
  }
  window.addEventListener('pagehide', cleanup, { once: true });
</script>
