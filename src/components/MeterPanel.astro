          <div class="mt-2 flex flex-wrap gap-2">
            <button id="rdm-rel-cap" type="button" class="btn-square focus-ring">{dict.ui.captureBaseline}</button>
            <button id="rdm-rel-clear" type="button" class="btn-square focus-ring">{dict.ui.clear}</button>
