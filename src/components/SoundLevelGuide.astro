---

<section id="sound-level-guide" class="panel cv-defer mt-4 p-5 sm:p-6" aria-labelledby="sound-level-guide-title" data-waiting={copy.waiting} data-estimated={copy.estimated} data-calibrated={copy.calibrated} data-weighting={copy.weighting}>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="sound-level-guide-title" class="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">{copy.title}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6" style="color:var(--muted)">{copy.intro}</p>
    </div>
    <div class="sound-current panel-raised p-4" aria-live="polite">
      <p class="eyebrow">{copy.current}</p>
      <p id="sound-guide-current" class="mt-1 text-sm font-medium">{copy.waiting}</p>
    </div>
  </div>

  <div class="sound-table mt-5" role="table" aria-label={copy.title}>
    <div class="sound-head hidden md:grid" role="row">
      <span role="columnheader">{copy.level}</span>
      <span role="columnheader">{copy.time}</span>
      <span role="columnheader">{copy.meaning}</span>
    </div>
    <div role="rowgroup">
      {copy.bands.map((band, index) => (
        <article class="sound-row" role="row" data-sound-band data-min={ranges[index].min} data-max={ranges[index].max} style={`--band:${ranges[index].color}`}>
          <div class="sound-level" role="cell">
            <span class="sound-dot" aria-hidden="true"></span>
            <h3>{band.level}</h3>
          </div>
          <p role="cell"><span class="md:hidden eyebrow">{copy.time}</span>{band.time}</p>
          <p role="cell" style="color:var(--muted)"><span class="md:hidden eyebrow">{copy.meaning}</span>{band.meaning}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-5 rounded-xl p-4 text-sm leading-6" style="border:1px solid color-mix(in srgb,#f59e0b 40%,var(--border));background:color-mix(in srgb,#f59e0b 8%,var(--raised))">
    <strong>{copy.note}</strong>
  </div>
  <p class="mt-4 text-xs leading-5" style="color:var(--muted)">
    {copy.sources}: <a class="focus-ring underline underline-offset-4" href="https://www.cdc.gov/niosh/noise/prevent/understand.html">CDC/NIOSH exposure guidance</a>
    · <a class="focus-ring underline underline-offset-4" href="https://www.nidcd.nih.gov/health/noise-induced-hearing-loss">NIDCD noise-induced hearing loss</a>
  </p>
</section>

<script>
  const guide = document.getElementById('sound-level-guide');
  const current = document.getElementById('sound-guide-current');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-sound-band]'));

  function renderSoundGuide(detail?: SoundGuideReading) {
    if (!guide || !current) return;
    rows.forEach((row) => row.removeAttribute('data-active'));
    if (detail?.value == null) {
      current.textContent = guide.dataset.waiting || '';
      return;
    }
    const value = Number(detail?.value);
    if (!Number.isFinite(value)) {
      current.textContent = guide.dataset.waiting || '';
      return;
    }
    if (detail?.unit !== 'dBA') {
      current.textContent = guide.dataset.weighting || '';
      return;
    }
    const matching = rows.find((row) => {
      const min = Number(row.dataset.min);
      const max = Number(row.dataset.max);
      return value > min && value <= max;
    });
    matching?.setAttribute('data-active', 'true');
    const kind = detail.calibrated ? guide.dataset.calibrated : guide.dataset.estimated;
    current.textContent = `${kind}: ${value.toFixed(1)} dBA${matching ? ` · ${matching.querySelector('h3')?.textContent ?? ''}` : ''}`;
  }

  document.addEventListener('rdm:reading', (event) => renderSoundGuide(event.detail));
  renderSoundGuide(window.__rdmReading);
</script>

<style>
  .sound-current { min-width: min(100%, 270px); }
  .sound-head,
  .sound-row { grid-template-columns: minmax(150px, .75fr) minmax(190px, 1fr) minmax(240px, 1.5fr); }
  .sound-head { gap: 16px; padding: 0 14px 9px; color: var(--muted); font: 600 11px/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .sound-row { display: grid; gap: 8px 16px; align-items: center; margin-top: 7px; padding: 13px 14px; border: 1px solid var(--border); border-radius: 11px; background: var(--raised); transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
  .sound-row[data-active='true'] { border-color: var(--band); box-shadow: 0 0 0 2px color-mix(in srgb, var(--band) 22%, transparent), inset 4px 0 0 var(--band); transform: translateX(2px); }
  .sound-level { display: flex; align-items: center; gap: 10px; }
  .sound-level h3 { font-size: 15px; font-weight: 700; }
  .sound-dot { width: 12px; height: 12px; flex: 0 0 auto; border-radius: 999px; background: var(--band); box-shadow: 0 0 16px color-mix(in srgb, var(--band) 55%, transparent); }
  .sound-row p { font-size: 13px; line-height: 1.5; }
  @media (max-width: 767px) {
    .sound-row { grid-template-columns: 1fr; padding: 14px; }
    .sound-row p .eyebrow { display: block; margin-bottom: 3px; }
    .sound-row[data-active='true'] { transform: none; }
  }
