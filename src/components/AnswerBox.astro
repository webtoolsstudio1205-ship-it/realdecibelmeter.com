---
// AEO/GEO answer-first block.
// Renders a quotable 40–60 word "Short answer" plus optional key facts.
// - The answer paragraph carries id="short-answer" and the list
//   id="key-facts" so SpeakableSpecification in articleJsonLd can point
//   voice assistants and LLMs at exactly this node.
// - Keep `answer` to 2–3 sentences, self-contained (no "as mentioned above").
// - Keep `facts` to 3–5 verifiable bullets with numbers where possible.
interface Props {
  answer: string;
  facts?: string[];
  answerId?: string;
  factsId?: string;
}
const { answer, facts = [], answerId = 'short-answer', factsId = 'key-facts' } = Astro.props;
---

<section class="panel p-5" data-aeo="short-answer" aria-label="Short answer" style="border-left:3px solid #3B82F6">
  <p id={answerId} class="text-[15px] leading-7" style="max-width:75ch">
    <strong>Short answer: </strong>{answer}
  </p>
  {facts.length > 0 && (
    <ul id={factsId} class="mt-3 grid gap-1.5 text-sm" style="color:var(--muted);max-width:75ch">
      {facts.map((f) => (
        <li class="flex gap-2"><span aria-hidden="true">•</span><span>{f}</span></li>
      ))}
    </ul>
  )}
</section>
