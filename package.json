    "jspdf": "^4.2.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vitest": "^3.2.7",
    "wrangler": "^4.134.0"
  }
}
