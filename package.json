{
  "name": "realdecibelmeter.com",
  "type": "module",
  "version": "0.0.1",
  "appVersion": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
